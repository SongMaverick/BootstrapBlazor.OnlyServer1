<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${aspnet-appbasepath}\logs\nlog-internal-${shortdate}.log">

  <!--
    NLog 5.x configuration
    Ref: https://github.com/NLog/NLog/wiki/Database-target

    Targets
      dbTarget        — SqlServer (主)  : 业务日志走 DB,可查可分析
      fallbackFile    — 本地文件 (兜底) : DB 失败时业务日志落盘
      internalLogFile — NLog 自身诊断    : 写在上方 internalLogFile,DB target 配置错会写这里

    IIS 部署关键:
      1. 所有 fileName 用 ${aspnet-appbasepath},自动跟随部署目录(不用硬编码)
      2. 应用根目录下 logs/ 给 IIS_IUSRS 写权限
      3. SqlServer 给应用池身份 db_writer 角色
  -->

  <extensions>
    <!-- NLog 5.x 必须显式加载 Database target -->
    <add assembly="NLog.Database"/>
  </extensions>

  <targets>

    <!-- ============ 1. SqlServer (主) ============ -->
    <target xsi:type="Database"
            name="dbTarget"
            dbProvider="sqlserver"
            connectionString="${configsetting:ConnectionStrings.sqlServerConnectionStringOffice}"
            keepConnection="true"
            commandType="Text"
            commandText="INSERT INTO dbo.Logs (MachineName, Logged, Level, Message, Logger, Properties, Exception) VALUES (@MachineName, @Logged, @Level, @Message, @Logger, @Properties, @Exception);">

      <parameter name="@MachineName" layout="${machinename}" />
      <parameter name="@Logged"      layout="${date}"         dbType="DbType.DateTime" />
      <parameter name="@Level"       layout="${level}"        />
      <parameter name="@Message"     layout="${message}"      />
      <parameter name="@Logger"      layout="${logger}"       />
      <parameter name="@Properties"  layout="${all-event-properties:separator=|}"     allowDbNull="true" />
      <parameter name="@Exception"   layout="${exception:tostring}"                   allowDbNull="true" />
    </target>

    <!-- ============ 2. 本地文件兜底 ============ -->
    <target xsi:type="AsyncWrapper"
            name="asyncFallback"
            queueLimit="10000"
            overflowAction="Discard"
            timeToSleepBetweenBatches="50">

      <target xsi:type="File"
              name="fallbackFile"
              fileName="${aspnet-appbasepath}\logs\fallback-${shortdate}.log"
              archiveFileName="${aspnet-appbasepath}\logs\fallback-{#}.log"
              archiveEvery="Day"
              archiveNumbering="Rolling"
              maxArchiveFiles="30"
              concurrentWrites="false"
              keepFileOpen="true"
              layout="${longdate}|${level:uppercase=true}|${logger}|${message}|${exception:format=tostring}" />
    </target>

  </targets>

  <rules>

    <!-- 业务日志:Info 及以上,异步写 DB;DB 失败 → 自动落 fallback 文件 -->
    <logger name="*" minlevel="Info" writeTo="dbTarget,asyncFallback" />

  </rules>

</nlog>