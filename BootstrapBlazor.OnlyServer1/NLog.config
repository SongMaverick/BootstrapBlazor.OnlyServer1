<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <!--
    NLog 6.x configuration — 纯文件版
    Ref: https://github.com/NLog/NLog/wiki/File-target

    一次日志 = 一行写入本地文件,异步不阻塞主线程,一天一个文件。

    为什么要 AsyncWrapper:
      - 文件 I/O 本身很快(本地盘 ~μs/条),但偶尔会被杀软扫描、
        文件锁、磁盘满之类的瞬时问题拖慢到几十 ms
      - AsyncWrapper 把写文件的活扔后台,主线程永远不卡

    一天一文件 + 不自动删:
      - fileName 用 ${shortdate},今天写 logs/app-2026-08-06.log
      - 每天 0 点 archive,归档到 logs/app-{原日期}.log(archiveNumbering="Date")
      - maxArchiveFiles 不写 = 不限,运维自己手动清理

    部署:
      - IIS / ANCM in-process:${basedir} = 站点物理路径,即 logs/ 在站点下
      - dev / Kestrel       :${basedir} = 项目 ContentRootPath,本地 logs/ 下
      - 两个环境用同一份 NLog.config,${basedir} 自动指向正确路径

    (2026-08-06)废弃数据库 target 原因:
      - 生产服务器连不上开发机本地 SQL,LogInformation 触发连接超时 15s,
        把 SignalR 主线程整个锁死,表现为"点完保存要等几秒才转圈"
      - 文件通道零网络依赖,本地盘永远比 SQL Server 跨网段稳
  -->

  <targets>

    <!-- ============ 唯一目标:本地文件 (异步) ============ -->
    <target xsi:type="AsyncWrapper"
            name="asyncFile"
            queueLimit="10000"
            overflowAction="Discard"
            timeToSleepBetweenBatches="50">

      <target xsi:type="File"
              name="file"
              fileName="${basedir}/logs/app-${shortdate}.log"
              archiveFileName="${basedir}/logs/app-${date:format=yyyy-MM-dd}.log"
              archiveEvery="Day"
              archiveNumbering="Date"
              keepFileOpen="true"
              layout="${longdate}|${level:uppercase=true}|${logger}|${message}|${exception:format=tostring}" />
    </target>

  </targets>

  <rules>
    <!-- 一条日志只进一个队列,后台 flush 写入文件 -->
    <logger name="*" minlevel="Info" writeTo="asyncFile" />
  </rules>

</nlog>
