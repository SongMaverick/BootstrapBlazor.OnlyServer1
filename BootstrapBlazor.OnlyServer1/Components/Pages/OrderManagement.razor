@page "/order-management"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Viewer)]
@using BootstrapBlazor.OnlyServer1.Models.Identity
@using BootstrapBlazor.OnlyServer1.Models.ViewModels
@using PermissionCodes = BootstrapBlazor.OnlyServer1.Models.Identity.PermissionCodes
@inject BootstrapBlazor.OnlyServer1.Services.OrderInfoService OrderInfoService
@inject BootstrapBlazor.OnlyServer1.Services.OrderDesignPhasesService OrderDesignPhasesService
@inject BootstrapBlazor.OnlyServer1.Services.OrderImportantComponentsService OrderImportantComponentsService
@inject BootstrapBlazor.OnlyServer1.Services.UsersService UsersService
@inject BootstrapBlazor.OnlyServer1.Services.Identity.CurrentUserAccessor CurrentUser
@inject Microsoft.Extensions.Logging.ILogger<OrderManagement> Logger
@inject ToastService ToastService

<PageTitle>订单管理</PageTitle>

<div class="page-order-management">
    <h1>订单管理</h1>
    <p class="text-secondary">
        按业务域拆 3 张表:项目信息 / 一次二次人员时间 / 重要组件。订单号 / 容量 / 额定电压 来自订单列表,本页只读;
        新增或删除订单请前往「订单列表」。
    </p>

    <Tab IsCard="true">
        @* ===== Tab 1: 订单项目信息 ===== *@
        <TabItem Text="项目信息">
            <Table TItem="OrderInfoRow"
                   IsPagination="true"
                   PageItemsSource="@PageItemsSource"
                   RenderMode="TableRenderMode.Table"
                   IsFixedHeader="true"
                   IsStriped="true"
                   IsBordered="true"
                   OnQueryAsync="OnInfoQueryAsync"
                   ShowSearch="true"
                   ShowToolbar="true"
                   ShowExtendButtons="true"
                   ShowAddButton="false"
                   ShowEditButton="false"
                   OnSaveAsync="OnInfoSaveAsync"
                   EditMode="EditMode.Popup"
                   EditDialogSize="Size.Large"
                   ShowSkeleton="true"
                   IsMultipleSelect="false"
                   Height="600"
                   ShowExtendEditButtonCallback="@(item => CurrentUser.HasPermission(PermissionCodes.OrderInfoEdit))">
                <TableColumns>
                    <TableColumn @bind-Field="@context.OrderNumber" Text="订单号" Width="110" Align="Alignment.Center" Sortable="true" Readonly="true" />
                    <TableColumn @bind-Field="@context.Power" Text="容量 MVA" Width="100" Align="Alignment.Center" Sortable="true" Readonly="true" />
                    <TableColumn @bind-Field="@context.RatedVoltage" Text="电压 kV" Width="100" Align="Alignment.Center" Sortable="true" Readonly="true" />
                    <TableColumn @bind-Field="@context.ProjectName" Text="项目名称" Width="220" Sortable="true">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-8">
                                <BootstrapInput TValue="string" @bind-Value="row.ProjectName" ShowLabel="true" DisplayText="项目名称" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.MarketType" Text="国内/出口" Width="110" Align="Alignment.Center" Sortable="true">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <Select Items="_marketTypeItems"
                                        TValue="string"
                                        @bind-Value="row.MarketType"
                                        ShowLabel="true"
                                        DisplayText="国内/出口"
                                        PlaceHolder="请选择" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.UnitCount" Text="台数" Width="80" Align="Alignment.Center" Sortable="true">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <BootstrapInputNumber TValue="int" @bind-Value="row.UnitCount" ShowLabel="true" DisplayText="台数" Min="1" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                </TableColumns>
            </Table>
        </TabItem>

        @* ===== Tab 2: 一次二次人员时间 ===== *@
        <TabItem Text="一次二次人员时间">
            <Table TItem="OrderDesignPhasesRow"
                   IsPagination="true"
                   PageItemsSource="@PageItemsSource"
                   RenderMode="TableRenderMode.Table"
                   IsFixedHeader="true"
                   IsStriped="true"
                   IsBordered="true"
                   OnQueryAsync="OnPhasesQueryAsync"
                   ShowSearch="true"
                   ShowToolbar="true"
                   ShowExtendButtons="true"
                   ShowAddButton="false"
                   ShowEditButton="false"
                   OnSaveAsync="OnPhasesSaveAsync"
                   EditMode="EditMode.Popup"
                   EditDialogSize="Size.ExtraLarge"
                   ShowSkeleton="true"
                   IsMultipleSelect="false"
                   Height="600"
                   ShowExtendEditButtonCallback="@(item => CurrentUser.HasPermission(PermissionCodes.OrderDesignPhasesEdit))">
                <TableColumns>
                    <TableColumn @bind-Field="@context.OrderNumber" Text="订单号" Width="110" Align="Alignment.Center" Sortable="true" Readonly="true" />
                    <TableColumn @bind-Field="@context.Phase1EngineerName" Text="负责人(一次)" Width="130" Align="Alignment.Center" Readonly="true" IsVisibleWhenEdit="false" />
                    <TableColumn @bind-Field="@context.Phase1EngineerId" Text="负责人(一次)" Width="130" Visible="false" IsVisibleWhenEdit="true">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <Select Items="_userItems"
                                        TValue="int?"
                                        @bind-Value="row.Phase1EngineerId"
                                        ShowLabel="true"
                                        DisplayText="一次负责人"
                                        ShowSearch="true"
                                        PlaceHolder="请选择" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.Phase1SubmitDate" Text="一次提交" Width="130" Align="Alignment.Center" Sortable="true">
                        <Template Context="value">@FormatDate(value.Value)</Template>
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <DateTimePicker TValue="DateTime?"
                                                @bind-Value="row.Phase1SubmitDate"
                                                ViewMode="DatePickerViewMode.Date"
                                                ShowLabel="true"
                                                DisplayText="一次提交日期" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.Phase1ConfirmDate" Text="一次确认" Width="130" Align="Alignment.Center" Sortable="true">
                        <Template Context="value">@FormatDate(value.Value)</Template>
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <DateTimePicker TValue="DateTime?"
                                                @bind-Value="row.Phase1ConfirmDate"
                                                ViewMode="DatePickerViewMode.Date"
                                                ShowLabel="true"
                                                DisplayText="一次确认日期" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.Phase2EngineerName" Text="负责人(二次)" Width="130" Align="Alignment.Center" Readonly="true" IsVisibleWhenEdit="false" />
                    <TableColumn @bind-Field="@context.Phase2EngineerId" Text="负责人(二次)" Width="130" Visible="false" IsVisibleWhenEdit="true">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <Select Items="_userItems"
                                        TValue="int?"
                                        @bind-Value="row.Phase2EngineerId"
                                        ShowLabel="true"
                                        DisplayText="二次负责人"
                                        ShowSearch="true"
                                        PlaceHolder="请选择" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.Phase2SubmitDate" Text="二次提交" Width="130" Align="Alignment.Center" Sortable="true">
                        <Template Context="value">@FormatDate(value.Value)</Template>
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <DateTimePicker TValue="DateTime?"
                                                @bind-Value="row.Phase2SubmitDate"
                                                ViewMode="DatePickerViewMode.Date"
                                                ShowLabel="true"
                                                DisplayText="二次提交日期" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.Phase2ConfirmDate" Text="二次确认" Width="130" Align="Alignment.Center" Sortable="true">
                        <Template Context="value">@FormatDate(value.Value)</Template>
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <DateTimePicker TValue="DateTime?"
                                                @bind-Value="row.Phase2ConfirmDate"
                                                ViewMode="DatePickerViewMode.Date"
                                                ShowLabel="true"
                                                DisplayText="二次确认日期" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                </TableColumns>
            </Table>
        </TabItem>

        @* ===== Tab 3: 重要组件 ===== *@
        <TabItem Text="重要组件">
            <Table TItem="OrderImportantComponentsRow"
                   IsPagination="true"
                   PageItemsSource="@PageItemsSource"
                   RenderMode="TableRenderMode.Table"
                   IsFixedHeader="true"
                   IsStriped="true"
                   IsBordered="true"
                   OnQueryAsync="OnComponentsQueryAsync"
                   ShowSearch="true"
                   ShowToolbar="true"
                   ShowExtendButtons="true"
                   ShowAddButton="false"
                   ShowEditButton="false"
                   OnSaveAsync="OnComponentsSaveAsync"
                   EditMode="EditMode.Popup"
                   EditDialogSize="Size.Large"
                   ShowSkeleton="true"
                   IsMultipleSelect="false"
                   Height="600"
                   ShowExtendEditButtonCallback="@(item => CurrentUser.HasPermission(PermissionCodes.OrderImportantComponentsEdit))">
                <TableColumns>
                    <TableColumn @bind-Field="@context.OrderNumber" Text="订单号" Width="110" Align="Alignment.Center" Sortable="true" Readonly="true" />
                    <TableColumn @bind-Field="@context.IsSplitFrame" Text="分体/大架子" Width="110" Align="Alignment.Center" ComponentType="typeof(Switch)">
                        <Template Context="value">@RenderYesNo(value.Value)</Template>
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <Switch @bind-Value="row.IsSplitFrame" ShowLabel="true" DisplayText="分体/大架子" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.IsWeldedTankRim" Text="焊接箱沿" Width="100" Align="Alignment.Center" ComponentType="typeof(Switch)">
                        <Template Context="value">@RenderYesNo(value.Value)</Template>
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <Switch @bind-Value="row.IsWeldedTankRim" ShowLabel="true" DisplayText="焊接箱沿" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.SwitchCount" Text="开关数量" Width="100" Align="Alignment.Center" Sortable="true">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <BootstrapInputNumber TValue="int?" @bind-Value="row.SwitchCount" ShowLabel="true" DisplayText="开关数量" Min="0" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.TestBushingModel" Text="试验套管型号" Width="200">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-8">
                                <BootstrapInput TValue="string" @bind-Value="row.TestBushingModel" ShowLabel="true" DisplayText="试验套管型号" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.TestBushingQuantity" Text="试验套管数量" Width="120" Align="Alignment.Center">
                        <EditTemplate Context="row">
                            <div class="col-12 col-md-6">
                                <BootstrapInputNumber TValue="int?" @bind-Value="row.TestBushingQuantity" ShowLabel="true" DisplayText="试验套管数量" Min="0" />
                            </div>
                        </EditTemplate>
                    </TableColumn>
                </TableColumns>
            </Table>
        </TabItem>
    </Tab>
</div>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private List<SelectedItem> _userItems = new();

    private static readonly List<SelectedItem> _marketTypeItems = new()
    {
        new SelectedItem("", "未指定"),
        new SelectedItem("国内", "国内"),
        new SelectedItem("出口", "出口"),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var users = await UsersService.GetSelectItemsAsync();
            _userItems = users.ToSelectedItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OrderManagement.OnInitializedAsync: 加载负责人下拉失败");
            _userItems = new();
        }
    }

    // ===== 项目信息 =====

    private async Task<QueryData<OrderInfoRow>> OnInfoQueryAsync(QueryPageOptions options)
    {
        var result = await OrderInfoService.QueryAsync(options.ToPagedQuery());
        return result.ToQueryData();
    }

    private async Task<bool> OnInfoSaveAsync(OrderInfoRow row, ItemChangedType changedType)
    {
        var (ok, error) = await OrderInfoService.SaveAsync(row);
        if (!ok)
        {
            await ShowToast(error ?? "保存失败", ToastCategory.Error);
            return false;
        }
        await ShowToast("项目信息保存成功", ToastCategory.Success);
        return true;
    }

    // ===== 一次二次人员时间 =====

    private async Task<QueryData<OrderDesignPhasesRow>> OnPhasesQueryAsync(QueryPageOptions options)
    {
        var result = await OrderDesignPhasesService.QueryAsync(options.ToPagedQuery());
        return result.ToQueryData();
    }

    private async Task<bool> OnPhasesSaveAsync(OrderDesignPhasesRow row, ItemChangedType changedType)
    {
        var (ok, error) = await OrderDesignPhasesService.SaveAsync(row);
        if (!ok)
        {
            await ShowToast(error ?? "保存失败", ToastCategory.Error);
            return false;
        }
        await ShowToast("阶段信息保存成功", ToastCategory.Success);
        return true;
    }

    // ===== 重要组件 =====

    private async Task<QueryData<OrderImportantComponentsRow>> OnComponentsQueryAsync(QueryPageOptions options)
    {
        var result = await OrderImportantComponentsService.QueryAsync(options.ToPagedQuery());
        return result.ToQueryData();
    }

    private async Task<bool> OnComponentsSaveAsync(OrderImportantComponentsRow row, ItemChangedType changedType)
    {
        var (ok, error) = await OrderImportantComponentsService.SaveAsync(row);
        if (!ok)
        {
            await ShowToast(error ?? "保存失败", ToastCategory.Error);
            return false;
        }
        await ShowToast("组件信息保存成功", ToastCategory.Success);
        return true;
    }

    // ===== 渲染辅助 =====

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static RenderFragment RenderYesNo(bool value) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", value ? "text-success fw-bold" : "text-secondary");
        builder.AddContent(2, value ? "是" : "否");
        builder.CloseElement();
    };

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2000
        });
    }
}