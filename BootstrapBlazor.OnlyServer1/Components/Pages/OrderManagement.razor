@page "/order-management"
@attribute [TabItemOption(Text = "订单管理")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Viewer)]
@inject BootstrapBlazor.OnlyServer1.Services.OrderMDDetailService OrderMDDetailService
@inject BootstrapBlazor.OnlyServer1.Services.UsersService UsersService
@inject BootstrapBlazor.OnlyServer1.Services.Identity.CurrentUserAccessor CurrentUser
@inject Microsoft.Extensions.Logging.ILogger<OrderManagement> Logger
@inject ToastService ToastService

<PageTitle>订单管理</PageTitle>

<div class="page-order-management">
    <h1>订单管理</h1>
    <p class="text-secondary">
        结构设计订单排产明细。订单号 / 容量 / 额定电压 来自订单列表,本页只读;
        新增或删除订单请前往「订单列表」。
    </p>

    @* (2026-08-13) 日期范围筛选:一次/二次图纸提交,各 2 个 DateTimePicker *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-2">
                    <DateTimePicker TValue="DateTime?" @bind-Value="_primarySubmitStart"
                                    ViewMode="DatePickerViewMode.Date"
                                    ShowLabel="true"
                                    DisplayText="一次提交-起始" />
                </div>
                <div class="col-12 col-md-auto text-center text-muted pb-2">~</div>
                <div class="col-12 col-md-2">
                    <DateTimePicker TValue="DateTime?" @bind-Value="_primarySubmitEnd"
                                    ViewMode="DatePickerViewMode.Date"
                                    ShowLabel="true"
                                    DisplayText="一次提交-结束" />
                </div>
                <div class="col-12 col-md-2">
                    <DateTimePicker TValue="DateTime?" @bind-Value="_secondarySubmitStart"
                                    ViewMode="DatePickerViewMode.Date"
                                    ShowLabel="true"
                                    DisplayText="二次提交-起始" />
                </div>
                <div class="col-12 col-md-auto text-center text-muted pb-2">~</div>
                <div class="col-12 col-md-2">
                    <DateTimePicker TValue="DateTime?" @bind-Value="_secondarySubmitEnd"
                                    ViewMode="DatePickerViewMode.Date"
                                    ShowLabel="true"
                                    DisplayText="二次提交-结束" />
                </div>
                <div class="col-12 col-md-auto">
                    <Button Color="Color.Primary" Icon="fa-solid fa-filter" OnClick="ApplyFilters">筛选</Button>
                </div>
                <div class="col-12 col-md-auto">
                    <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="ResetFilters">重置</Button>
                </div>
            </div>
        </div>
    </div>

    <Table TItem="OrderMDDetailRow"
           @ref="_table"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           RenderMode="TableRenderMode.Table"
           IsFixedHeader="true"
           IsStriped="true"
           IsBordered="true"
           OnQueryAsync="OnQueryAsync"
           ShowSearch="true"
           ShowToolbar="true"
           ShowExtendButtons="true"
           ShowAddButton="false"
           ShowEditButton="false"
           ShowDeleteButton="false"
           OnSaveAsync="OnSaveAsync"
           OnDeleteAsync="OnDeleteAsync"
           DeleteButtonText="清空内容"
           ConfirmDeleteContentText="确认清空所选订单的明细内容吗?订单本身不会被删除。"
           EditMode="EditMode.Popup"
           EditDialogSize="Size.ExtraLarge"
           ShowSkeleton="true"
           IsMultipleSelect="true"
           Height="700"
           ShowExtendEditButtonCallback="@(item => CurrentUser.HasPermission(PermissionCodes.OrderMDDetailEdit))"
           ShowExtendDeleteButtonCallback="@(item => CurrentUser.HasPermission(PermissionCodes.OrderMDDetailDelete))"
           DisableExtendDeleteButtonCallback="@(item => item.DetailId == 0)">
        <TableColumns>
            @* ===== 来自 Orders,只读 ===== *@
            <TableColumn @bind-Field="@context.OrderNumber" Text="订单号" Width="110" Align="Alignment.Center" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.Power" Text="容量 MVA" Width="100" Align="Alignment.Center" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.RatedVoltage" Text="电压 kV" Width="100" Align="Alignment.Center" Sortable="true" Readonly="true" />

            @* ===== 明细字段(每个 EditTemplate 强制 col-12 col-md-6,2 个一行) ===== *@
            <TableColumn @bind-Field="@context.ProjectName" Text="项目名称" Width="220" Sortable="true">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <BootstrapInput TValue="string" @bind-Value="row.ProjectName" ShowLabel="true" DisplayText="项目名称" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.MarketType" Text="国内/出口" Width="110" Align="Alignment.Center" Sortable="true">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <Select Items="_marketTypeItems"
                                TValue="string"
                                @bind-Value="row.MarketType"
                                ShowLabel="true"
                                DisplayText="国内/出口"
                                PlaceHolder="请选择" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.DesignTool" Text="设计工具" Width="100" Align="Alignment.Center">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <Select Items="_designToolItems"
                                TValue="string"
                                @bind-Value="row.DesignTool"
                                ShowLabel="true"
                                DisplayText="设计工具"
                                PlaceHolder="请选择" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.UnitCount" Text="台数" Width="80" Align="Alignment.Center" Sortable="true">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <BootstrapInputNumber TValue="int" @bind-Value="row.UnitCount" ShowLabel="true" DisplayText="台数" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.PrimaryEngineerName" Text="负责人(一次)" Width="130" Align="Alignment.Center" Readonly="true" IsVisibleWhenEdit="false" />
            <TableColumn @bind-Field="@context.PrimaryEngineerId" Text="负责人(一次)" Width="130" Visible="false" IsVisibleWhenEdit="true">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <Select Items="_userItems"
                                TValue="int?"
                                @bind-Value="row.PrimaryEngineerId"
                                ShowLabel="true"
                                DisplayText="一次负责人"
                                ShowSearch="true"
                                PlaceHolder="请选择负责人" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.PrimarySubmitDate" Text="一次图纸提交" Width="130" Align="Alignment.Center" Sortable="true">
                <Template Context="value">@FormatDate(value.Value)</Template>
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <DateTimePicker TValue="DateTime?"
                                        @bind-Value="row.PrimarySubmitDate"
                                        ViewMode="DatePickerViewMode.Date"
                                        ShowLabel="true"
                                        DisplayText="一次提交日期" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.PrimaryConfirmDate" Text="一次图纸确认" Width="130" Align="Alignment.Center" Sortable="true">
                <Template Context="value">@FormatDate(value.Value)</Template>
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <DateTimePicker TValue="DateTime?"
                                        @bind-Value="row.PrimaryConfirmDate"
                                        ViewMode="DatePickerViewMode.Date"
                                        ShowLabel="true"
                                        DisplayText="一次确认日期" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.SecondaryEngineerName" Text="负责人(二次)" Width="130" Align="Alignment.Center" Readonly="true" IsVisibleWhenEdit="false" />
            <TableColumn @bind-Field="@context.SecondaryEngineerId" Text="负责人(二次)" Width="130" Visible="false" IsVisibleWhenEdit="true">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <Select Items="_userItems"
                                TValue="int?"
                                @bind-Value="row.SecondaryEngineerId"
                                ShowLabel="true"
                                DisplayText="二次负责人"
                                ShowSearch="true"
                                PlaceHolder="请选择负责人" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.SecondarySubmitDate" Text="二次图纸提交" Width="130" Align="Alignment.Center" Sortable="true">
                <Template Context="value">@FormatDate(value.Value)</Template>
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <DateTimePicker TValue="DateTime?"
                                        @bind-Value="row.SecondarySubmitDate"
                                        ViewMode="DatePickerViewMode.Date"
                                        ShowLabel="true"
                                        DisplayText="二次提交日期" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.SecondaryConfirmDate" Text="二次图纸确认" Width="130" Align="Alignment.Center" Sortable="true">
                <Template Context="value">@FormatDate(value.Value)</Template>
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <DateTimePicker TValue="DateTime?"
                                        @bind-Value="row.SecondaryConfirmDate"
                                        ViewMode="DatePickerViewMode.Date"
                                        ShowLabel="true"
                                        DisplayText="二次确认日期" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.IsSplitFrame" Text="分体/大架子" Width="110" Align="Alignment.Center" ComponentType="typeof(Switch)">
                <Template Context="value">@RenderYesNo(value.Value)</Template>
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <Switch @bind-Value="row.IsSplitFrame" ShowLabel="true" DisplayText="分体/大架子" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.TestBushingModel" Text="试验套管型号" Width="200">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <BootstrapInput TValue="string" @bind-Value="row.TestBushingModel" ShowLabel="true" DisplayText="试验套管型号" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.TestBushingQuantity" Text="试验套管数量" Width="120" Align="Alignment.Center">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <BootstrapInputNumber TValue="int?" @bind-Value="row.TestBushingQuantity" ShowLabel="true" DisplayText="试验套管数量" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.SwitchCount" Text="开关数量" Width="100" Align="Alignment.Center">
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <BootstrapInputNumber TValue="int?" @bind-Value="row.SwitchCount" ShowLabel="true" DisplayText="开关数量" />
                    </div>
                </EditTemplate>
            </TableColumn>

            <TableColumn @bind-Field="@context.IsWeldedTankRim" Text="焊接箱沿" Width="100" Align="Alignment.Center" ComponentType="typeof(Switch)">
                <Template Context="value">@RenderYesNo(value.Value)</Template>
                <EditTemplate Context="row">
                    <div class="col-12 col-md-6">
                        <Switch @bind-Value="row.IsWeldedTankRim" ShowLabel="true" DisplayText="焊接箱沿" />
                    </div>
                </EditTemplate>
            </TableColumn>
        </TableColumns>
    </Table>
</div>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private List<SelectedItem> _userItems = new();

    // (2026-08-13) Table 组件引用(用于按钮手动触发 QueryAsync)
    private Table<OrderMDDetailRow>? _table;

    // 日期范围筛选状态(4 个 DateTimePicker 双向绑定)
    private DateTime? _primarySubmitStart;
    private DateTime? _primarySubmitEnd;
    private DateTime? _secondarySubmitStart;
    private DateTime? _secondarySubmitEnd;

    // 静态选项:与 Excel「2026结构设计订单」sheet 的取值一致
    private static readonly List<SelectedItem> _marketTypeItems = new()
    {
        new SelectedItem("", "未指定"),
        new SelectedItem("国内", "国内"),
        new SelectedItem("出口", "出口"),
    };

    private static readonly List<SelectedItem> _designToolItems = new()
    {
        new SelectedItem("", "未指定"),
        new SelectedItem("2D", "2D"),
        new SelectedItem("3D", "3D"),
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var users = await UsersService.GetSelectItemsAsync();
            _userItems = users.ToSelectedItems();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OrderManagement.OnInitializedAsync: 加载负责人下拉失败");
            _userItems = new();
        }
    }

    private async Task<QueryData<OrderMDDetailRow>> OnQueryAsync(QueryPageOptions options)
    {
        // (2026-08-13) 用带日期筛选的重载,把 4 个 DateTimePicker 状态闭包传过去
        var result = await OrderMDDetailService.QueryAsync(options.ToPagedQuery(
            _primarySubmitStart, _primarySubmitEnd,
            _secondarySubmitStart, _secondarySubmitEnd));
        return result.ToQueryData();
    }

    private async Task ApplyFilters()
    {
        // 校验:起始不能晚于结束(任一组独立校验)
        if (_primarySubmitStart.HasValue && _primarySubmitEnd.HasValue && _primarySubmitStart > _primarySubmitEnd)
        {
            await ShowToast("一次提交的起始日期不能晚于结束日期", ToastCategory.Error);
            return;
        }
        if (_secondarySubmitStart.HasValue && _secondarySubmitEnd.HasValue && _secondarySubmitStart > _secondarySubmitEnd)
        {
            await ShowToast("二次提交的起始日期不能晚于结束日期", ToastCategory.Error);
            return;
        }
        await _table!.QueryAsync();
    }

    private async Task ResetFilters()
    {
        _primarySubmitStart = null;
        _primarySubmitEnd = null;
        _secondarySubmitStart = null;
        _secondarySubmitEnd = null;
        await _table!.QueryAsync();
    }

    private async Task<bool> OnSaveAsync(OrderMDDetailRow row, ItemChangedType changedType)
    {
        // 本页不新增订单,changedType 恒为 Update;Service 内部按 DetailId 决定 insert/update
        var (ok, error) = await OrderMDDetailService.SaveAsync(row);
        if (!ok)
        {
            await ShowToast(error ?? "保存失败", ToastCategory.Error);
            return false;
        }
        await ShowToast("保存成功", ToastCategory.Success);
        return true;
    }

    private async Task<bool> OnDeleteAsync(IEnumerable<OrderMDDetailRow> rows)
    {
        // 语义是"清空明细内容",不是删除行,更不是删除订单
        var ok = await OrderMDDetailService.ClearAsync(rows);
        await ShowToast(ok ? "已清空所选订单的明细内容" : "清空失败", ok ? ToastCategory.Success : ToastCategory.Error);
        return ok;
    }

    private static string FormatDate(DateTime? value)
        => value.HasValue ? value.Value.ToString("yyyy-MM-dd") : "-";

    private static RenderFragment RenderYesNo(bool value) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", value ? "text-success fw-bold" : "text-secondary");
        builder.AddContent(2, value ? "是" : "否");
        builder.CloseElement();
    };

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2000
        });
    }
}