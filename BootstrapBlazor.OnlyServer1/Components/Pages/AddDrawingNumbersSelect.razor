@page "/add-drawing-numbers-select"
@attribute [TabItemOption(Text = "添加图号")]
@inject SqlSugar.ISqlSugarClient? Db
@inject Microsoft.Extensions.Logging.ILogger<AddDrawingNumbersSelect> Logger
@inject NavigationManager NavigationManager

<PageTitle>添加图号</PageTitle>

<div class="page-add-drawing-numbers-select">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">➕ 添加图号</h3>
            <p class="card-subtitle text-muted">请选择要添加图号的订单</p>
        </div>
        <div class="card-body">
            @* 搜索区 *@
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">订单号</label>
                    <input type="text" class="form-control" placeholder="输入订单号关键字"
                           @bind="_orderNumberKeyword" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">创建者</label>
                    <input type="text" class="form-control" placeholder="输入创建者关键字"
                           @bind="_createdByKeyword" @bind:event="oninput" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">是否电抗器</label>
                    <select class="form-select" @bind="_reactorFilter">
                        <option value="">全部</option>
                        <option value="true">是</option>
                        <option value="false">否</option>
                    </select>
                </div>
            </div>

            @* 当前选中订单摘要 *@
            @if (selectedOrder != null)
            {
                <div class="alert alert-info d-flex justify-content-between align-items-center">
                    <div>
                        已选中订单:
                        <strong>订单号 @selectedOrder.OrderNumber</strong>
                        · 容量 @selectedOrder.Power MW
                        @if (selectedOrder.IsReactor)
                        {
                            <Badge Color="Color.Primary" IsPill="true" class="ms-2">
                                <i class="fa-solid fa-bolt"></i>
                                <span class="ms-1">电抗器</span>
                            </Badge>
                        }
                        else
                        {
                            <Badge Color="Color.Success" IsPill="true" class="ms-2">
                                <i class="fa-solid fa-battery-full"></i>
                                <span class="ms-1">变压器</span>
                            </Badge>
                        }
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="ClearSelection"></button>
                </div>
            }

            @* 订单表格 *@
            <Table TItem="Models.Orders"
                   IsPagination="true"
                   PageItemsSource="@PageItemsSource"
                   RenderMode="TableRenderMode.Table"
                   IsFixedHeader="true"
                   IsStriped="true"
                   IsBordered="true"
                   OnQueryAsync="OnQueryAsync"
                   ShowSearch="false"
                   ShowToolbar="false"
                   ShowExtendButtons="false"
                   ShowSkeleton="true"
                   Height="500"
                   ClickToSelect="true"
                   IsMultipleSelect="false"
                   SelectedRowsChanged="OnSelectedRowsChanged">
                <TableColumns>
                    <TableColumn @bind-Field="@context.Id" Text="编号" Width="80" Align="Alignment.Center" />
                    <TableColumn @bind-Field="@context.OrderNumber" Text="订单号" Width="120" Align="Alignment.Center" Sortable="true" />
                    <TableColumn @bind-Field="@context.Power" Text="容量(MW)" Width="100" Align="Alignment.Center" Sortable="true" />
                    <TableColumn @bind-Field="@context.RatedVoltage" Text="额定电压" Width="120" Align="Alignment.Center" Sortable="true" />
                    <TableColumn @bind-Field="@context.IsReactor" Text="类型" Width="120" Align="Alignment.Center" Sortable="true">
                        <Template Context="value">
                            @if (value.Value)
                            {
                                <Badge Color="Color.Primary" IsPill="true">
                                    <i class="fa-solid fa-bolt"></i>
                                    <span class="ms-1">电抗器</span>
                                </Badge>
                            }
                            else
                            {
                                <Badge Color="Color.Success" IsPill="true">
                                    <i class="fa-solid fa-battery-full"></i>
                                    <span class="ms-1">变压器</span>
                                </Badge>
                            }
                        </Template>
                    </TableColumn>
                    <TableColumn @bind-Field="@context.CreatedBy" Text="创建者" Width="120" Sortable="true" />
                    <TableColumn @bind-Field="@context.CreatedTime" Text="创建时间" Width="180" Align="Alignment.Center" Sortable="true">
                        <Template Context="value">
                            @value.Value.ToString("yyyy-MM-dd HH:mm:ss")
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>

            <div class="mt-4">
                <button class="btn btn-primary btn-lg" @onclick="GoToAddDrawingNumbers" disabled="@(selectedOrder == null)">
                    <i class="fa-solid fa-plus-circle"></i> 添加图号
                </button>
                <button class="btn btn-secondary btn-lg ms-3" @onclick="GoToOrderDrawingNumbers" disabled="@(selectedOrder == null)">
                    <i class="fa-solid fa-list"></i> 查看图号列表
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private string? _orderNumberKeyword;
    private string? _createdByKeyword;
    private string? _reactorFilter;
    private Models.Orders? selectedOrder;

    private async Task<QueryData<Models.Orders>> OnQueryAsync(QueryPageOptions options)
    {
        if (Db == null)
        {
            Logger.LogWarning("Db is null, returning empty result");
            return new QueryData<Models.Orders>();
        }

        try
        {
            var query = Db.Queryable<Models.Orders>().Where(o => !o.IsDeleted);

            if (!string.IsNullOrWhiteSpace(_orderNumberKeyword))
            {
                var kw = _orderNumberKeyword.Trim();
                query = query.Where(o => o.OrderNumber.ToString().Contains(kw));
            }

            if (!string.IsNullOrWhiteSpace(_createdByKeyword))
            {
                var kw = _createdByKeyword.Trim();
                query = query.Where(o => o.CreatedBy.Contains(kw));
            }

            if (!string.IsNullOrWhiteSpace(_reactorFilter) && bool.TryParse(_reactorFilter, out var isReactor))
            {
                query = query.Where(o => o.IsReactor == isReactor);
            }

            if (!string.IsNullOrEmpty(options.SortName))
            {
                query = options.SortOrder == SortOrder.Asc
                    ? query.OrderBy($"{options.SortName} asc")
                    : query.OrderBy($"{options.SortName} desc");
            }
            else
            {
                query = query.OrderByDescending(o => o.OrderNumber);
            }

            var total = query.Count();
            var items = query.Skip((options.PageIndex - 1) * options.PageItems).Take(options.PageItems).ToList();

            return new QueryData<Models.Orders>()
            {
                Items = items,
                TotalCount = total,
                IsFiltered = options.Filters.Any(),
                IsSorted = !string.IsNullOrEmpty(options.SortName),
                IsSearch = !string.IsNullOrEmpty(options.SearchText) || options.SearchModel != null
            };
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error querying orders");
            return new QueryData<Models.Orders>();
        }
    }

    private void OnSelectedRowsChanged(IEnumerable<Models.Orders> rows)
    {
        selectedOrder = rows?.FirstOrDefault();
    }

    private void ClearSelection()
    {
        selectedOrder = null;
    }

    private void GoToAddDrawingNumbers()
    {
        if (selectedOrder != null)
        {
            NavigationManager.NavigateTo($"/add-drawing-numbers/{selectedOrder.Id}");
        }
    }

    private void GoToOrderDrawingNumbers()
    {
        if (selectedOrder != null)
        {
            NavigationManager.NavigateTo($"/order-drawing-numbers/{selectedOrder.Id}");
        }
    }
}