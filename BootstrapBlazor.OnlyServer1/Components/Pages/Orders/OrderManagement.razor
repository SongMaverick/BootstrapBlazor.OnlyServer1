    /// <summary>
    /// 按订单号精确跳转。命中后:右侧加载详情,主表 SelectedRows 同步刷新,
    /// 但分页不强制跳页 — 行可能不在当前页(刷新表格查询条件即可拉到对应页)。
    /// 未命中给 Toast 警告,不清空当前已选项。
    /// </summary>
    private async Task OnSearchOrderAsync()
    {
        var raw = _orderNumberSearch?.Trim() ?? "";
        if (string.IsNullOrEmpty(raw))
        {
            await ShowToast("请输入订单号", ToastCategory.Warning);
            return;
        }
        if (!int.TryParse(raw, out var orderNumber) || orderNumber <= 0)
        {
            await ShowToast("订单号必须为正整数", ToastCategory.Warning);
            return;
        }

        _searchingOrder = true;
        try
        {
            var found = await OrdersService.FindByOrderNumberAsync(orderNumber);
            if (found == null)
            {
                await ShowToast($"未找到订单号 {orderNumber}(可能已被删除)", ToastCategory.Warning);
                return;
            }

            // 同步主表选中状态;左侧 Table 当前页可能不含该行,
            // 但右侧详情已正确加载(详情来自 OrderId 直接查 3 个明细服务,不依赖主表分页)。
            _masterSelected = new List<OrderEntity> { found };
            _selectedOrder = found;
            await LoadDetailAsync(found.Id);
            await ShowToast($"已定位到订单 {found.OrderNumber}", ToastCategory.Success);
        }
        finally
        {
            _searchingOrder = false;
        }
    }

    private async Task LoadDetailAsync(int orderId)
    {
        _loadingDetail = true;
        _infoRow = null;
        _phasesRow = null;
        _componentsRow = null;
        // (2026-09-04) 切订单时清空编辑草稿,否则上一个订单的草稿还在弹窗里,Save 会写到新订单上。
        // Modal 内部 BodyTemplate 用 @if (_xxxEditModel != null) 守,置 null 后表单自动消失;
        // 用户点 Modal 的 X 即可关闭。
        _infoEditModel = null;
        _orderTypeEditModel = null;
        _phasesEditModel = null;
        _componentsEditModel = null;
        _issues = null;
        _issueSelected = new();
        // (2026-08-27) 切订单时收起问题汇总全量视图,恢复为预览
        _showAllIssues = false;

        try
        {
            var infoTask = OrderInfoService.GetByOrderIdAsync(orderId);
            var orderTypeTask = OrderTypeService.GetByOrderIdAsync(orderId);
            var phasesTask = OrderDesignPhasesService.GetByOrderIdAsync(orderId);
            var compTask = OrderImportantComponentsService.GetByOrderIdAsync(orderId);
            // 问题汇总一次性取全量(不分页 — 单订单问题数通常不多;若订单下问题数百条再考虑分页)。
            var issuesTask = OrderIssueService.QueryByOrderIdAsync(orderId, new PagedQuery { PageIndex = 1, PageItems = 1000 });
            await Task.WhenAll(infoTask, orderTypeTask, phasesTask, compTask, issuesTask);

            _infoRow = infoTask.Result ?? EmptyInfoRow(orderId);
            _orderTypeRow = orderTypeTask.Result;
            _phasesRow = phasesTask.Result ?? EmptyPhasesRow(orderId);
            _componentsRow = compTask.Result ?? EmptyComponentsRow(orderId);
            _issues = issuesTask.Result.Items ?? new();
        }

        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadDetailAsync failed for orderId={OrderId}", orderId);
            _infoRow ??= EmptyInfoRow(orderId);
            _phasesRow ??= EmptyPhasesRow(orderId);
            _componentsRow ??= EmptyComponentsRow(orderId);
            _issues ??= new();
        }
        finally
        {
            _loadingDetail = false;
        }
    }

