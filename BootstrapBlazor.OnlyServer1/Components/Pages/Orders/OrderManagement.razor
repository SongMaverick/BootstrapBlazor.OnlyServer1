    protected override async Task OnInitializedAsync()
    {
        try
        {
            var users = await UsersService.GetSelectItemsAsync();
            _userItems = users.ToSelectedItems();
            // (2026-08-27) BootstrapBlazor Select 在 TValue="int?" 且 value=null 时,
            // 若 Items 列表中没有 Value="" 的项,会回退到第 0 项显示(不是 PlaceHolder)。
            // 这里 _phasesRow.Phase1/2EngineerId 默认是 null,导致未选负责人时
            // 错误显示用户表排序第一的名字。插一个空值项("" → null)绑住 null,显示「请选择」。
            // 同页 _marketTypeItems 已用相同模式。
            _userItems.Insert(0, new SelectedItem("", "请选择"));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OrderManagement.OnInitializedAsync: 加载负责人下拉失败");
            _userItems = new();
        }

        // (2026-09-04) 年筛选下拉:全部 + 基于"此时此刻"展开的去年/今年/明年 3 项,
        // 显示用真实年份数字(2025 / 2026 / 2027)而不是"去年/今年/明年"字样 —— 用户明确要求看数字。
        // 锚点是 DateTime.Today(应用服务器本地时间);用户停留页面跨年后,下次进页面才会刷新。
        _yearItems = new List<SelectedItem> { new SelectedItem("", "全部") };
        var thisYear = DateTime.Today.Year;
        _yearItems.Add(new SelectedItem((thisYear - 1).ToString(), $"{thisYear - 1} 年"));
        _yearItems.Add(new SelectedItem(thisYear.ToString(), $"{thisYear} 年"));
        _yearItems.Add(new SelectedItem((thisYear + 1).ToString(), $"{thisYear + 1} 年"));

        // (2026-09-04) 月筛选下拉:全部 + 1-12 月,显示"X 月"(无前导 0,跟用户口语一致)。
        // 写死 12 个月,跨年/月本身也只 12 个,不需要查 DB。
        _monthItems = new List<SelectedItem> { new SelectedItem("", "全部") };
        for (int m = 1; m <= 12; m++)
        {
            _monthItems.Add(new SelectedItem(m.ToString(), $"{m} 月"));
        }
    }

    // 左右栏由 JS 按实际内容区宽度自适应，并保留拖动调整能力。
    // 左侧最小 520px，覆盖五列及 Card 内边距；右侧可缩至 320px。
    //   - JS 内自带幂等(bound 标记),后续 OnAfterRenderAsync 不重复 attach
    //   - 不做 dispose 清理:handle 元素被 Blazor 移除时 mousedown 监听自然失效,
    //     document 上的 mousemove/mouseup 仅在 dragging=true 时才工作,不拖等于空挂
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("orderMgmtResizer.attach",
                    "orderMgmtMasterCol", "orderMgmtDetailCol", "orderMgmtResizer",
                    520, 320);
            }
            catch (Exception ex)
            {
                // 挂载失败不影响订单管理主功能,降级为无 splitter 体验
                Logger.LogWarning(ex, "OrderManagement.OnAfterRenderAsync: 初始化列宽拖动分隔条失败");
            }
        }
    }

