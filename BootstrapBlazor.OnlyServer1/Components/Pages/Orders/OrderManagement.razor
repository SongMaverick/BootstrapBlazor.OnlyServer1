    private async Task<QueryData<OrderIssues>> OnIssuesQueryAsync(QueryPageOptions options)
    {
        if (_selectedOrder == null || _issues == null)
        {
            return new QueryData<OrderIssues>
            {
                Items = new List<OrderIssues>(),
                TotalCount = 0,
            };
        }
        // 一次拉到全量(_issues 已含 1000 条上限),手动按 PageItems 切片,避免每翻一页都打数据库。
        var all = _issues;
        var page = all.Skip((options.PageIndex - 1) * options.PageItems).Take(options.PageItems).ToList();
        return await Task.FromResult(new QueryData<OrderIssues>
        {
            Items = page,
            TotalCount = all.Count,
            IsFiltered = false,
            IsSorted = false,
            IsSearch = false,
        });
    }

