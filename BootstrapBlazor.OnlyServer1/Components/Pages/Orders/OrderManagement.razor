@page "/order-management"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = RoleNames.Admin + "," + RoleNames.Operator + "," + RoleNames.Viewer)]
@using BootstrapBlazor.OnlyServer1.Models
@using BootstrapBlazor.OnlyServer1.Models.Identity
@using BootstrapBlazor.OnlyServer1.Models.ViewModels
@using PermissionCodes = BootstrapBlazor.OnlyServer1.Models.Identity.PermissionCodes
@using OrderEntity = BootstrapBlazor.OnlyServer1.Models.OrderManagement.Orders
@inject OrdersService OrdersService
@inject OrderInfoService OrderInfoService
@inject OrderTypeService OrderTypeService
@inject OrderDesignPhasesService OrderDesignPhasesService
@inject OrderImportantComponentsService OrderImportantComponentsService
@inject OrderIssueService OrderIssueService
@inject UsersService UsersService
@inject CurrentUserAccessor CurrentUser
@inject Microsoft.Extensions.Logging.ILogger<OrderManagement> Logger
@inject ToastService ToastService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>订单管理</PageTitle>

<div class="page-order-management">
    <h1>订单管理</h1>
    <p class="text-secondary">
        主从布局:左侧选订单,右侧按业务域分 4 块(项目信息 / 一次二次人员时间 / 重要组件 / 问题汇总)维护。
        订单号 / 容量 / 额定电压 / 是否电抗器 在「订单列表」维护,此处只读;新增或删除订单请前往「订单列表」。
    </p>

    <div class="row g-3 page-order-management-row">
        @* 左侧至少保留 520px，确保五个订单字段完整显示；右侧允许更紧凑，以优先保持左右布局。 *@
        <div class="col-12" id="orderMgmtMasterCol">
            <Card IsShadow="true">
                <HeaderTemplate>
                    <div class="d-flex align-items-center justify-content-between">
                        <span><i class="fa-solid fa-list me-1"></i>订单列表</span>
                        @if (_selectedOrder != null)
                        {
                            <span class="text-muted small">已选 #@_selectedOrder.OrderNumber</span>
                        }
                    </div>
                </HeaderTemplate>
                <BodyTemplate>
                    @* 订单号快速跳转:输入精确订单号 → 回车/查找 → 命中后右侧加载详情,主表也滚动到该行(主表分页不强制跳页,行可能不在当前页;但 SelectedRows 状态会刷新) *@
                    <div class="d-flex mb-2" style="gap: 0.5rem;">
                        <BootstrapInput TValue="string" @bind-Value="_orderNumberSearch"
                                        ShowLabel="false"
                                        PlaceHolder="输入订单号跳转(精确匹配)"
                                        IsDisabled="@_searchingOrder"
                                        OnEnterAsync="@(value => OnSearchOrderAsync())"
                                        style="flex: 1;" />
                        <Button Color="Color.Primary" Icon="fa-solid fa-magnifying-glass"
                                IsAsync="true" IsDisabled="@_searchingOrder"
                                OnClick="OnSearchOrderAsync">
                            查找
                        </Button>
                    </div>
                    @* (2026-09-04) 按一次提交日期的年/月筛选:两个独立 Select,4 种组合语义
                         (都空=全部 / 只年=该年 / 只月=该月任意年 / 都选=该年该月)。
                         任一 Select 改变都触发 OnFilterChanged → Table.QueryAsync。 *@
                    <div class="d-flex mb-2 align-items-center" style="gap: 0.5rem;">
                        <span class="text-muted small" style="white-space: nowrap;">一次提交日期:</span>
                        <Select TValue="string"
                                @bind-Value="_selectedYear"
                                Items="_yearItems"
                                ShowLabel="false"
                                PlaceHolder="全部年"
                                OnSelectedItemChanged="OnFilterChanged"
                                style="flex: 1;" />
                        <Select TValue="string"
                                @bind-Value="_selectedMonth"
                                Items="_monthItems"
                                ShowLabel="false"
                                PlaceHolder="全部月"
                                OnSelectedItemChanged="OnFilterChanged"
                                style="flex: 1;" />
                    </div>

                    <Table TItem="OrderEntity"
                           @ref="_masterTable"
                           @key="_masterReloadCounter"
                           IsPagination="true"
                           PageItemsSource="@MasterPageItemsSource"
                           RenderMode="TableRenderMode.Table"
                           IsFixedHeader="true"
                           IsStriped="true"
                           IsBordered="true"
                           OnQueryAsync="OnMasterQueryAsync"
                           ShowSearch="true"
                           ShowToolbar="false"
                           ShowAddButton="false"
                           ShowEditButton="false"
                           ShowDeleteButton="false"
                           ShowExtendButtons="false"
                           ShowSkeleton="true"
                           IsMultipleSelect="false"
                           SelectedRows="_masterSelected"
                           SelectedRowsChanged="OnMasterSelectedRowsChanged"
                           ClickToSelect="true"
                           Height="600"
                           AllowResizing="true"
                           ShowColumnWidthTooltip="true"
                           ColumnWidthTooltipPrefix="拖动调整列宽 — ">
                        @* (2026-09-04) 启用列宽拖动:笔记本 col-lg-4 容器 < 460px 时第五列「一次提交日期」会被挤掉;
                           AllowResizing=true + IsFixedHeader=true 生效(官方文档明确),列右侧出现拖动手柄。
                           不写 OnResizeColumnAsync → 拖完刷新即重置(简单方案,后续要持久化再叠 LocalStorage)。 *@
                        <TableColumns>
                            <TableColumn @bind-Field="@context.OrderNumber" Text="订单号" Width="100" Align="Alignment.Center" Sortable="true" Readonly="true" />
                            <TableColumn @bind-Field="@context.Power" Text="容量" Width="80" Align="Alignment.Center" Readonly="true" />
                            <TableColumn @bind-Field="@context.RatedVoltage" Text="电压" Width="80" Align="Alignment.Center" Readonly="true" />
                            <TableColumn @bind-Field="@context.IsReactor" Text="类型" Width="80" Align="Alignment.Center" Readonly="true">
                                <Template Context="value">
                                    @if (value.Value)
                                    {
                                        <Badge Color="Color.None" IsPill="true" class="badge-reactor">电抗</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="Color.None" IsPill="true" class="badge-transformer">变压</Badge>
                                    }
                                </Template>
                            </TableColumn>
                            @* (2026-09-04) 一次提交日期:由 GetMasterListAsync 的 LeftJoin 投影到 Orders.Phase1SubmitDate;
                                 没填的显示 "—",填了的 yyyy-MM-dd。Sortable 关掉(后端固定按它 desc,前端再排没意义)。 *@
                            <TableColumn @bind-Field="@context.Phase1SubmitDate" Text="一次提交日期" Width="120" Align="Alignment.Center" Readonly="true">
                                <Template Context="value">
                                    @(value.Value?.ToString("yyyy-MM-dd") ?? "—")
                                </Template>
                            </TableColumn>
                        </TableColumns>
                    </Table>
                </BodyTemplate>
            </Card>
        </div>

        @* ===== 左右两栏之间的拖动分隔条(2026-09-04 新增,完全 JS 接管布局) ===== *@
        <div id="orderMgmtResizer" title="拖动调整左右栏宽度"></div>

        @* ===== 右侧:订单详情 ===== *@
        <div class="col-12" id="orderMgmtDetailCol">
            @if (_selectedOrder == null)
            {
                <div class="alert alert-info" role="alert">
                    请从左侧选择一个订单,右侧将加载并可编辑项目信息 / 一次二次人员时间 / 重要组件 / 问题汇总。
                </div>
            }
            else
            {
                @* ===== 摘要 ===== *@
                <Card IsShadow="true" class="mb-3">
                    <BodyTemplate>
                        <div class="d-flex flex-wrap align-items-center" style="gap: 1.5rem;">
                            <div>
                                <div class="text-muted small">订单号</div>
                                <div class="fs-4 fw-bold">@_selectedOrder.OrderNumber</div>
                            </div>
                            <div>
                                <div class="text-muted small">容量</div>
                                <div class="fs-5">@_selectedOrder.Power kVA</div>
                            </div>
                            <div>
                                <div class="text-muted small">额定电压</div>
                                <div class="fs-5">@_selectedOrder.RatedVoltage kV</div>
                            </div>
                            <div>
                                <div class="text-muted small">类型</div>
                                @if (_selectedOrder.IsReactor)
                                {
                                    <Badge Color="Color.None" IsPill="true" class="badge-reactor">
                                        <i class="fa-solid fa-bolt"></i>
                                        <span class="ms-1">电抗器</span>
                                    </Badge>
                                }
                                else
                                {
                                    <Badge Color="Color.None" IsPill="true" class="badge-transformer">
                                        <i class="fa-solid fa-battery-full"></i>
                                        <span class="ms-1">变压器</span>
                                    </Badge>
                                }
                            </div>
                            <div class="ms-auto text-end text-muted small">
                                <div>创建者:@_selectedOrder.CreatedBy</div>
                                <div>创建时间:@_selectedOrder.CreatedTime.ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                        </div>
                    </BodyTemplate>
                </Card>

                <Card IsShadow="true" class="mb-3">
                    <HeaderTemplate>
                        <div class="d-flex align-items-center justify-content-between">
                            <span><i class="fa-solid fa-tags me-1"></i>订单类型</span>
                            @if (CanEditOrderType)
                            {
                                <Button Color="Color.Primary" Size="Size.Small" Icon="fa-solid fa-pen-to-square"
                                        OnClick="ShowOrderTypeDialog">编辑</Button>
                            }
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (_orderTypeRow == null)
                        {
                            <Spinner Color="Color.Primary" />
                        }
                        else
                        {
                            <span class="badge bg-secondary">@_orderTypeRow.OrderType</span>
                            @if (!string.IsNullOrWhiteSpace(_orderTypeRow.ReferenceOrderNumber))
                            {
                                <span class="ms-3 text-secondary">参考订单：@_orderTypeRow.ReferenceOrderNumber</span>
                            }
                        }
                    </BodyTemplate>
                </Card>

                @* ===== Card 1:项目信息 ===== *@
                <Card IsShadow="true" class="mb-3">
                    <HeaderTemplate>
                        <div class="d-flex align-items-center justify-content-between">
                            <span><i class="fa-solid fa-folder-open me-1"></i>项目信息</span>
                            <div class="d-flex align-items-center" style="gap: 0.5rem;">
                                @if (_infoRow == null)
                                {
                                    <Badge Color="Color.Warning">未填写</Badge>
                                }
                                else if (_infoRow.InfoId > 0)
                                {
                                    <Badge Color="Color.Success">已填写</Badge>
                                }
                                else
                                {
                                    <Badge Color="Color.Warning">未填写</Badge>
                                }
                                @* (2026-09-04) view/edit 分离:Card body 只读摘要,点编辑按钮弹窗改 *@
                                @if (CanEditInfo)
                                {
                                    <Button Color="Color.Primary" Size="Size.Small"
                                            Icon="fa-solid fa-pen-to-square"
                                            OnClick="ShowInfoDialog">编辑</Button>
                                }
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (_loadingDetail && _infoRow == null)
                        {
                            <div class="text-center py-3"><Spinner Color="Color.Primary" /></div>
                        }
                        else if (_infoRow != null)
                        {
                            @* (2026-09-04) 只读摘要视图。Drawer 风格 label + value 列表;
                               空值显示 "—",有权限编辑请点 Card 头部"编辑"按钮弹窗改。 *@
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="text-muted small">项目名称</div>
                                    <div class="readonly-value">@(string.IsNullOrWhiteSpace(_infoRow.ProjectName) ? "—" : _infoRow.ProjectName)</div>
                                </div>
                                <div class="col-12 col-md-3">
                                    <div class="text-muted small">国内/出口</div>
                                    <div class="readonly-value">@(string.IsNullOrWhiteSpace(_infoRow.MarketType) ? "—" : _infoRow.MarketType)</div>
                                </div>
                                <div class="col-12 col-md-3">
                                    <div class="text-muted small">台数</div>
                                    <div class="readonly-value">@_infoRow.UnitCount</div>
                                </div>
                            </div>
                        }
                    </BodyTemplate>
                </Card>

                @* ===== Card 2:一次二次人员时间 ===== *@
                <Card IsShadow="true" class="mb-3">
                    <HeaderTemplate>
                        <div class="d-flex align-items-center justify-content-between">
                            <span><i class="fa-solid fa-people-group me-1"></i>一次二次人员时间</span>
                            <div class="d-flex align-items-center" style="gap: 0.5rem;">
                                @if (_phasesRow != null && _phasesRow.PhasesId > 0)
                                {
                                    <Badge Color="Color.Success">已填写</Badge>
                                }
                                else
                                {
                                    <Badge Color="Color.Warning">未填写</Badge>
                                }
                                @if (CanEditPhases)
                                {
                                    <Button Color="Color.Primary" Size="Size.Small"
                                            Icon="fa-solid fa-pen-to-square"
                                            OnClick="ShowPhasesDialog">编辑</Button>
                                }
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (_loadingDetail && _phasesRow == null)
                        {
                            <div class="text-center py-3"><Spinner Color="Color.Primary" /></div>
                        }
                        else if (_phasesRow != null)
                        {
                            @* (2026-09-04) 只读摘要。工程师名用 join 出来的展示字段,
                               日期 yyyy-MM-dd 与 DatePicker ViewMode 一致;空值 "—"。 *@
                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <div class="text-muted small">一次负责人</div>
                                    <div class="readonly-value">@(string.IsNullOrWhiteSpace(_phasesRow.Phase1EngineerName) ? "—" : _phasesRow.Phase1EngineerName)</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">一次提交日期</div>
                                    <div class="readonly-value">@(_phasesRow.Phase1SubmitDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">一次确认日期</div>
                                    <div class="readonly-value">@(_phasesRow.Phase1ConfirmDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                                </div>
                                <div class="col-12 col-md-6">
                                    <div class="text-muted small">二次负责人</div>
                                    <div class="readonly-value">@(string.IsNullOrWhiteSpace(_phasesRow.Phase2EngineerName) ? "—" : _phasesRow.Phase2EngineerName)</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">二次提交日期</div>
                                    <div class="readonly-value">@(_phasesRow.Phase2SubmitDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">二次确认日期</div>
                                    <div class="readonly-value">@(_phasesRow.Phase2ConfirmDate?.ToString("yyyy-MM-dd") ?? "—")</div>
                                </div>
                            </div>
                        }
                    </BodyTemplate>
                </Card>

                @* ===== Card 3:重要组件 ===== *@
                <Card IsShadow="true" class="mb-3">
                    <HeaderTemplate>
                        <div class="d-flex align-items-center justify-content-between">
                            <span><i class="fa-solid fa-cogs me-1"></i>重要组件</span>
                            <div class="d-flex align-items-center" style="gap: 0.5rem;">
                                @if (_componentsRow != null && _componentsRow.ComponentsId > 0)
                                {
                                    <Badge Color="Color.Success">已填写</Badge>
                                }
                                else
                                {
                                    <Badge Color="Color.Warning">未填写</Badge>
                                }
                                @if (CanEditComponents)
                                {
                                    <Button Color="Color.Primary" Size="Size.Small"
                                            Icon="fa-solid fa-pen-to-square"
                                            OnClick="ShowComponentsDialog">编辑</Button>
                                }
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (_loadingDetail && _componentsRow == null)
                        {
                            <div class="text-center py-3"><Spinner Color="Color.Primary" /></div>
                        }
                        else if (_componentsRow != null)
                        {
                            @* (2026-09-04) 只读摘要。Switch 字段在只读视图用 Badge pill (是/否),
                               disabled Switch 视觉上像坏的,看着费劲。空数字/字符串 "—"。 *@
                            <div class="row g-3">
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">分体/大架子</div>
                                    <div class="readonly-value">
                                        @if (_componentsRow.IsSplitFrame)
                                        {
                                            <Badge Color="Color.Success">是</Badge>
                                        }
                                        else
                                        {
                                            <Badge Color="Color.Secondary">否</Badge>
                                        }
                                    </div>
                                </div>
                                <div class="col-6 col-md-3">
                                    <div class="text-muted small">焊接箱沿</div>
                                    <div class="readonly-value">
                                        @if (_componentsRow.IsWeldedTankRim)
                                        {
                                            <Badge Color="Color.Success">是</Badge>
                                        }
                                        else
                                        {
                                            <Badge Color="Color.Secondary">否</Badge>
                                        }
                                    </div>
                                </div>
                                <div class="col-6 col-md-2">
                                    <div class="text-muted small">开关数量</div>
                                    <div class="readonly-value">@(_componentsRow.SwitchCount?.ToString() ?? "—")</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="text-muted small">试验套管型号</div>
                                    <div class="readonly-value">@(string.IsNullOrWhiteSpace(_componentsRow.TestBushingModel) ? "—" : _componentsRow.TestBushingModel)</div>
                                </div>
                                <div class="col-12 col-md-4">
                                    <div class="text-muted small">试验套管数量</div>
                                    <div class="readonly-value">@(_componentsRow.TestBushingQuantity?.ToString() ?? "—")</div>
                                </div>
                            </div>
                        }
                    </BodyTemplate>
                </Card>

                @* ===== Card 4:问题汇总(2026-08-25 从独立页整合进来;2026-08-27 改为「预览最近 5 条 + 查看全部」折叠,
                                  避免问题数变多时把右侧详情页顶到很长) ===== *@
                <Card IsShadow="true" class="mb-3">
                    <HeaderTemplate>
                        <div class="d-flex align-items-center justify-content-between" style="gap: 1rem;">
                            @* (2026-08-27) 标题改为可点击链接,跳转到该订单的独立问题汇总页 *@
                            <a href="@($"/order-issues/{_selectedOrder.Id}")"
                               class="text-reset text-decoration-none"
                               style="font-weight: inherit;">
                                <i class="fa-solid fa-circle-exclamation me-1"></i>问题汇总
                                <i class="fa-solid fa-up-right-from-square ms-1 small text-muted" title="在新页查看"></i>
                            </a>
                            <div class="d-flex align-items-center" style="gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end;">
                                @if (_issues == null)
                                {
                                    <Badge Color="Color.Secondary">加载中</Badge>
                                }
                                else
                                {
                                    var openCount = _issues.Count(i => i.Status == IssueStatus.Open);
                                    var closeCount = _issues.Count(i => i.Status == IssueStatus.Close);
                                    <Badge Color="Color.Danger" class="me-1">@openCount open</Badge>
                                    <Badge Color="Color.Success" class="me-1">@closeCount close</Badge>
                                }
                                @if (CanAddIssue)
                                {
                                    <Button Color="Color.Primary" Icon="fa-solid fa-plus" Size="Size.Small"
                                            OnClick="ShowAddIssueDialog">
                                        新建
                                    </Button>
                                }
                                @if (CanSolveIssue)
                                {
                                    <Button Color="Color.Success" Icon="fa-solid fa-check" Size="Size.Small"
                                            OnClick="ShowResolutionDialogFromSelection">
                                        填写解决方法
                                    </Button>
                                }
                                @if (_showAllIssues && !HasOneIssueSelected && _issueSelected.Count > 1)
                                {
                                    <span class="text-warning small align-self-center">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>一次只能操作一个问题
                                    </span>
                                }
                            </div>
                        </div>
                    </HeaderTemplate>
                    <BodyTemplate>
                        @if (_loadingDetail && _issues == null)
                        {
                            <div class="text-center py-3"><Spinner Color="Color.Primary" /></div>
                        }
                        else if (_issues == null || _issues.Count == 0)
                        {
                            <div class="text-center text-muted py-3">
                                <i class="fa-solid fa-circle-check me-1"></i>该订单暂无问题记录
                            </div>
                        }
                        else if (_showAllIssues)
                        {
                            @* === 全量 Table(原逻辑,内含分页 / 状态切换 / 选行等) === *@
                            <Table TItem="OrderIssues"
                                   @ref="_issuesTable"
                                   @key="_issuesReloadCounter"
                                   IsPagination="true"
                                   PageItemsSource="@IssuesPageItemsSource"
                                   RenderMode="TableRenderMode.Table"
                                   IsFixedHeader="true"
                                   IsStriped="true"
                                   IsBordered="true"
                                   OnQueryAsync="OnIssuesQueryAsync"
                                   ShowSearch="false"
                                   ShowToolbar="false"
                                   ShowAddButton="false"
                                   ShowEditButton="false"
                                   ShowDeleteButton="false"
                                   ShowExtendButtons="false"
                                   ShowSkeleton="true"
                                   IsMultipleSelect="false"
                                   ClickToSelect="true"
                                   SelectedRows="_issueSelected"
                                   SelectedRowsChanged="OnIssueSelectedRowsChanged"
                                   Height="350">
                                <TableColumns>
                                    <TableColumn @bind-Field="@context.Id" Text="Id" Width="60" Align="Alignment.Center" Readonly="true" />
                                    <TableColumn @bind-Field="@context.Content" Text="问题描述">
                                        <Template Context="row">
                                            <div style="white-space: pre-wrap; max-width: 360px; max-height: 100px; overflow-y: auto; word-break: break-word;">@row.Row.Content</div>
                                        </Template>
                                    </TableColumn>
                                    <TableColumn @bind-Field="@context.Resolution" Text="解决方法" Width="200">
                                        <Template Context="row">
                                            @if (string.IsNullOrWhiteSpace(row.Row.Resolution))
                                            {
                                                <span class="text-secondary">—</span>
                                            }
                                            else
                                            {
                                                <div style="white-space: pre-wrap; max-height: 60px; overflow-y: auto; word-break: break-word;">@row.Row.Resolution</div>
                                            }
                                        </Template>
                                    </TableColumn>
                                    <TableColumn @bind-Field="@context.Status" Text="状态" Width="120" Align="Alignment.Center">
                                        <Template Context="row">
                                            <select class="@GetIssueStatusClass(row.Row.Status)"
                                                    style="min-width: 90px; font-weight: 600;"
                                                    value="@row.Row.Status"
                                                    disabled="@(row.Row.Status == IssueStatus.Close || !CanEditIssueStatus)"
                                                    @onchange="@(async (ChangeEventArgs e) => await OnIssueStatusChanged(row.Row, e.Value?.ToString() ?? ""))">
                                                @foreach (var item in _issueStatusItems)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            </select>
                                        </Template>
                                    </TableColumn>
                                    <TableColumn @bind-Field="@context.CreatedBy" Text="创建人" Width="100" Align="Alignment.Center" Readonly="true" />
                                    <TableColumn @bind-Field="@context.CreatedTime" Text="创建时间" Width="140" Align="Alignment.Center" Readonly="true">
                                        <Template Context="row">@row.Row.CreatedTime.ToString("yyyy-MM-dd HH:mm")</Template>
                                    </TableColumn>
                                    <TableColumn @bind-Field="@context.ClosedBy" Text="关闭人" Width="100" Align="Alignment.Center" Readonly="true">
                                        <Template Context="row">@(row.Row.ClosedBy ?? "—")</Template>
                                    </TableColumn>
                                    <TableColumn @bind-Field="@context.ClosedTime" Text="关闭时间" Width="140" Align="Alignment.Center" Readonly="true">
                                        <Template Context="row">@(row.Row.ClosedTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</Template>
                                    </TableColumn>
                                </TableColumns>
                            </Table>
                            <div class="text-center mt-3">
                                <Button Color="Color.Secondary" IsOutline="true" Icon="fa-solid fa-chevron-up" Size="Size.Small"
                                        OnClick="@(() => _showAllIssues = false)">
                                    收起(只显示最近 5 条)
                                </Button>
                            </div>
                        }
                        else
                        {
                            @* === 预览:最近 5 条(精简视图,内容截断 + 状态徽章) === *@
                            <div class="issues-preview">
                                @foreach (var issue in _issuesPreview)
                                {
                                    <div class="d-flex align-items-center"
                                         style="padding: 0.6rem 0.5rem; border-bottom: 1px solid #e9ecef; gap: 0.75rem; cursor: pointer; border-radius: 4px; transition: background-color 0.15s;"
                                         @onclick="@(() => OpenIssueDrawer(issue))">
                                        @if (issue.Status == IssueStatus.Open)
                                        {
                                            <Badge Color="Color.Danger" IsPill="true" style="min-width: 56px; text-align: center; flex-shrink: 0;">open</Badge>
                                        }
                                        else if (issue.Status == IssueStatus.Close)
                                        {
                                            <Badge Color="Color.Success" IsPill="true" style="min-width: 56px; text-align: center; flex-shrink: 0;">close</Badge>
                                        }
                                        <div class="flex-fill" style="min-width: 0;">
                                            <div style="white-space: pre-wrap; max-height: 60px; overflow-y: auto; word-break: break-word; color: #212529;">
                                                @TruncateIssueContent(issue.Content, 120)
                                            </div>
                                            <div class="text-muted small" style="margin-top: 0.25rem;">
                                                #@issue.Id · @issue.CreatedBy · @issue.CreatedTime.ToString("yyyy-MM-dd HH:mm")
                                            </div>
                                        </div>
                                        <i class="fa-solid fa-chevron-right text-muted" style="flex-shrink: 0;"></i>
                                    </div>
                                }
                            </div>
                            @if (_issues.Count > 5)
                            {
                                <div class="text-center mt-3">
                                    <Button Color="Color.Primary" IsOutline="true" Icon="fa-solid fa-chevron-down" Size="Size.Small"
                                            OnClick="@(() => _showAllIssues = true)">
                                        查看全部问题(共 @_issues.Count 条) →
                                    </Button>
                                </div>
                            }
                        }
                    </BodyTemplate>
                </Card>

                @* (2026-08-27 晚) 单条问题详情 Drawer:点预览行打开,提供完整内容 + 状态切换 + 解决方法 + close *@
                <Drawer Placement="Placement.Right" @bind-IsOpen="@_issueDrawerVisible" IsBackdrop="true" Size="Size.Large">
                    @if (_currentIssueForDrawer != null)
                    {
                        var drawerIssue = _currentIssueForDrawer;
                        var isOpen = drawerIssue.Status == IssueStatus.Open;
                        <div class="d-flex flex-column" style="height: 100%;">
                            <div class="px-3 py-2 border-bottom">
                                <div class="d-flex align-items-center justify-content-between">
                                    <span class="fw-bold">
                                        <i class="fa-solid fa-circle-exclamation me-1"></i>问题 #@drawerIssue.Id
                                    </span>
                                    @if (isOpen)
                                    {
                                        <Badge Color="Color.Danger" IsPill="true">open</Badge>
                                    }
                                    else
                                    {
                                        <Badge Color="Color.Success" IsPill="true">close</Badge>
                                    }
                                </div>
                                <div class="text-muted small">@_selectedOrder?.OrderNumber</div>
                            </div>
                            <div class="flex-fill p-3" style="overflow-y: auto;">
                                <div class="mb-3">
                                    <label class="form-label fw-bold">问题描述</label>
                                    <div style="white-space: pre-wrap; word-break: break-word; background: #f8f9fa; padding: 0.75rem; border-radius: 4px; max-height: 300px; overflow-y: auto;">
                                        @(drawerIssue.Content ?? "")
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">解决方法</label>
                                    @if (string.IsNullOrWhiteSpace(drawerIssue.Resolution))
                                    {
                                        <div class="text-secondary fst-italic">尚未填写</div>
                                    }
                                    else
                                    {
                                        <div style="white-space: pre-wrap; word-break: break-word; background: #f8f9fa; padding: 0.75rem; border-radius: 4px; max-height: 300px; overflow-y: auto;">
                                            @drawerIssue.Resolution
                                        </div>
                                    }
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">状态</label>
                                    @if (isOpen && CanEditIssueStatus)
                                    {
                                        <select class="@GetIssueStatusClass(drawerIssue.Status)"
                                                style="min-width: 120px; font-weight: 600;"
                                                value="@drawerIssue.Status"
                                                @onchange="OnDrawerStatusChanged">
                                            @foreach (var item in _issueStatusItems)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                        <div class="form-text">open → close 前请先填写解决方法</div>
                                    }
                                    else if (isOpen)
                                    {
                                        <Badge Color="Color.Danger" IsPill="true">open</Badge>
                                        <div class="form-text text-warning">无 OrderIssue.EditStatus 权限,无法切换状态</div>
                                    }
                                    else
                                    {
                                        <Badge Color="Color.Success" IsPill="true">close</Badge>
                                        <div class="form-text">已关闭,无法再修改状态</div>
                                    }
                                </div>
                                <hr />
                                <div class="text-muted small">
                                    <div><i class="fa-solid fa-user-plus me-1"></i>创建人:@drawerIssue.CreatedBy</div>
                                    <div><i class="fa-solid fa-clock me-1"></i>创建时间:@drawerIssue.CreatedTime.ToString("yyyy-MM-dd HH:mm")</div>
                                    @if (!isOpen)
                                    {
                                        <div class="mt-1"><i class="fa-solid fa-user-check me-1"></i>关闭人:@(drawerIssue.ClosedBy ?? "—")</div>
                                        <div><i class="fa-solid fa-lock me-1"></i>关闭时间:@(drawerIssue.ClosedTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                                    }
                                </div>
                            </div>
                            <div class="px-3 py-2 border-top d-flex justify-content-end" style="gap: 0.5rem;">
                                @if (isOpen && CanEditIssueStatus)
                                {
                                    <Button Color="Color.Success" Icon="fa-solid fa-check" Size="Size.Small"
                                            OnClick="ShowResolutionDialogFromDrawer">
                                        填写解决方法
                                    </Button>
                                }
                                <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" Size="Size.Small"
                                        OnClick="CloseIssueDrawer">
                                    关闭
                                </Button>
                            </div>
                        </div>
                    }
                </Drawer>

                @* 新建问题 Modal *@
                <Modal @ref="_addIssueModal" IsBackdrop="true" ShowCloseButton="true">
                    <ModalDialog Title="@($"新建问题 — 订单 #{_selectedOrder?.OrderNumber}")" Size="Size.Large">
                        <BodyTemplate>
                            <div class="mb-3">
                                <label class="form-label">问题描述(支持长文本,最多 8000 字符)</label>
                                <textarea class="form-control" rows="8" maxlength="8000"
                                          @bind="_newIssueContent"
                                          placeholder="详细描述在此订单遇到的问题..."></textarea>
                                <small class="text-muted">当前 @(_newIssueContent?.Length ?? 0) / 8000 字符</small>
                            </div>
                        </BodyTemplate>
                        <FooterTemplate>
                            <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveNewIssue" IsDisabled="_savingIssue">
                                @(_savingIssue ? "保存中..." : "保存")
                            </Button>
                            <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseAddIssueDialog">取消</Button>
                        </FooterTemplate>
                    </ModalDialog>
                </Modal>

                @* 填写解决方法 Modal *@
                <Modal @ref="_resolutionModal" IsBackdrop="true" ShowCloseButton="true">
                    <ModalDialog Title="@($"填写解决方法 — 问题 #{_currentIssueForResolution?.Id}")" Size="Size.Large">
                        <BodyTemplate>
                            @if (_currentIssueForResolution != null)
                            {
                                <div class="mb-3">
                                    <label class="form-label text-secondary">原问题</label>
                                    <div style="white-space: pre-wrap; max-height: 160px; overflow-y: auto; background: #f8f9fa; padding: 8px 12px; border-radius: 4px; font-size: 0.95em;">
                                        @_currentIssueForResolution.Content
                                    </div>
                                </div>
                            }
                            <div class="mb-3">
                                <label class="form-label">解决方法 <span class="text-danger">*</span></label>
                                <textarea class="form-control" rows="6" maxlength="8000"
                                          @bind="_newResolution"
                                          placeholder="详细描述解决方法(close 时会被校验)..."></textarea>
                                <small class="text-muted">当前 @(_newResolution?.Length ?? 0) / 8000 字符</small>
                            </div>
                        </BodyTemplate>
                        <FooterTemplate>
                            <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveResolution" IsDisabled="_savingResolution">
                                @(_savingResolution ? "保存中..." : "保存")
                            </Button>
                            <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseResolutionModal">取消</Button>
                        </FooterTemplate>
                    </ModalDialog>
                </Modal>

                @* ===== (2026-09-04) Card 1:项目信息编辑弹窗 ===== *@
                <Modal @ref="_infoModal" IsBackdrop="true" ShowCloseButton="true">
                    <ModalDialog Title="@($"编辑项目信息 — 订单 #{_selectedOrder?.OrderNumber}")" Size="Size.Medium">
                        <BodyTemplate>
                            @if (_infoEditModel != null)
                            {
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <BootstrapInput TValue="string" @bind-Value="_infoEditModel.ProjectName"
                                                        ShowLabel="true" DisplayText="项目名称"
                                                        PlaceHolder="请输入项目名称" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <Select Items="_marketTypeItems" TValue="string"
                                                @bind-Value="_infoEditModel.MarketType"
                                                ShowLabel="true" DisplayText="国内/出口"
                                                PlaceHolder="请选择" />
                                    </div>
                                    <div class="col-12 col-md-3">
                                        <BootstrapInputNumber TValue="int" @bind-Value="_infoEditModel.UnitCount"
                                                               ShowLabel="true" DisplayText="台数" Min="1" />
                                    </div>
                                </div>
                            }
                        </BodyTemplate>
                        <FooterTemplate>
                            <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveInfoAsync"
                                    IsDisabled="@_savingInfo">
                                @(_savingInfo ? "保存中..." : "保存")
                            </Button>
                            <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseInfoDialog">
                                取消
                            </Button>
                        </FooterTemplate>
                    </ModalDialog>
                </Modal>

                <Modal @ref="_orderTypeModal" IsBackdrop="true" ShowCloseButton="true">
                    <ModalDialog Title="@($"编辑订单类型 - 订单 #{_selectedOrder?.OrderNumber}")" Size="Size.Medium">
                        <BodyTemplate>
                            @if (_orderTypeEditModel != null)
                            {
                                <Select Items="_orderTypeItems" TValue="string"
                                        @bind-Value="_orderTypeEditModel.OrderType"
                                        ShowLabel="true" DisplayText="订单类型"
                                        OnSelectedItemChanged="OnOrderTypeChanged" />
                                @if (_orderTypeEditModel.OrderType is "相同" or "相似")
                                {
                                    <BootstrapInput TValue="string"
                                                    @bind-Value="_orderTypeEditModel.ReferenceOrderNumber"
                                                    ShowLabel="true" DisplayText="@("\u53C2\u8003\u8BA2\u5355")"
                                                    PlaceHolder="@("\u8BF7\u586B\u5199\u53C2\u8003\u8BA2\u5355")" />
                                    <small class="text-muted">@("\u8BF7\u586B\u5199\u53C2\u8003\u8BA2\u5355\u53F7")</small>
                                }
                            }
                        </BodyTemplate>
                        <FooterTemplate>
                            <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveOrderTypeAsync"
                                    IsDisabled="@_savingOrderType">
                                @(_savingOrderType ? "保存中..." : "保存")
                            </Button>
                            <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseOrderTypeDialog">取消</Button>
                        </FooterTemplate>
                    </ModalDialog>
                </Modal>

                @* ===== (2026-09-04) Card 2:一次二次人员时间编辑弹窗 ===== *@
                <Modal @ref="_phasesModal" IsBackdrop="true" ShowCloseButton="true">
                    <ModalDialog Title="@($"编辑一次二次人员时间 — 订单 #{_selectedOrder?.OrderNumber}")" Size="Size.Large">
                        <BodyTemplate>
                            @if (_phasesEditModel != null)
                            {
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <Select Items="_userItems"
                                                TValue="int?"
                                                @bind-Value="_phasesEditModel.Phase1EngineerId"
                                                ShowLabel="true" DisplayText="一次负责人"
                                                ShowSearch="true" PlaceHolder="请选择" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <DateTimePicker TValue="DateTime?"
                                                        @bind-Value="_phasesEditModel.Phase1SubmitDate"
                                                        ViewMode="DatePickerViewMode.Date"
                                                        ShowLabel="true" DisplayText="一次提交日期" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <DateTimePicker TValue="DateTime?"
                                                        @bind-Value="_phasesEditModel.Phase1ConfirmDate"
                                                        ViewMode="DatePickerViewMode.Date"
                                                        ShowLabel="true" DisplayText="一次确认日期" />
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <Select Items="_userItems"
                                                TValue="int?"
                                                @bind-Value="_phasesEditModel.Phase2EngineerId"
                                                ShowLabel="true" DisplayText="二次负责人"
                                                ShowSearch="true" PlaceHolder="请选择" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <DateTimePicker TValue="DateTime?"
                                                        @bind-Value="_phasesEditModel.Phase2SubmitDate"
                                                        ViewMode="DatePickerViewMode.Date"
                                                        ShowLabel="true" DisplayText="二次提交日期" />
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <DateTimePicker TValue="DateTime?"
                                                        @bind-Value="_phasesEditModel.Phase2ConfirmDate"
                                                        ViewMode="DatePickerViewMode.Date"
                                                        ShowLabel="true" DisplayText="二次确认日期" />
                                    </div>
                                </div>
                            }
                        </BodyTemplate>
                        <FooterTemplate>
                            <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SavePhasesAsync"
                                    IsDisabled="@_savingPhases">
                                @(_savingPhases ? "保存中..." : "保存")
                            </Button>
                            <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="ClosePhasesDialog">
                                取消
                            </Button>
                        </FooterTemplate>
                    </ModalDialog>
                </Modal>

                @* ===== (2026-09-04) Card 3:重要组件编辑弹窗 ===== *@
                <Modal @ref="_componentsModal" IsBackdrop="true" ShowCloseButton="true">
                    <ModalDialog Title="@($"编辑重要组件 — 订单 #{_selectedOrder?.OrderNumber}")" Size="Size.Medium">
                        <BodyTemplate>
                            @if (_componentsEditModel != null)
                            {
                                <div class="row g-3">
                                    <div class="col-12 col-md-3 d-flex align-items-end">
                                        <Switch @bind-Value="_componentsEditModel.IsSplitFrame"
                                                ShowLabel="true" DisplayText="分体/大架子" />
                                    </div>
                                    <div class="col-12 col-md-3 d-flex align-items-end">
                                        <Switch @bind-Value="_componentsEditModel.IsWeldedTankRim"
                                                ShowLabel="true" DisplayText="焊接箱沿" />
                                    </div>
                                    <div class="col-6 col-md-2">
                                        <BootstrapInputNumber TValue="int?" @bind-Value="_componentsEditModel.SwitchCount"
                                                               ShowLabel="true" DisplayText="开关数量" Min="0" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <BootstrapInput TValue="string" @bind-Value="_componentsEditModel.TestBushingModel"
                                                        ShowLabel="true" DisplayText="试验套管型号"
                                                        PlaceHolder="请输入型号" />
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <BootstrapInputNumber TValue="int?" @bind-Value="_componentsEditModel.TestBushingQuantity"
                                                               ShowLabel="true" DisplayText="试验套管数量" Min="0" />
                                    </div>
                                </div>
                            }
                        </BodyTemplate>
                        <FooterTemplate>
                            <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveComponentsAsync"
                                    IsDisabled="@_savingComponents">
                                @(_savingComponents ? "保存中..." : "保存")
                            </Button>
                            <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseComponentsDialog">
                                取消
                            </Button>
                        </FooterTemplate>
                    </ModalDialog>
                </Modal>
            }
        </div>
    </div>
</div>

@code {
    private static IEnumerable<int> MasterPageItemsSource => new int[] { 10, 20, 40 };

    private List<SelectedItem> _userItems = new();

    private static readonly List<SelectedItem> _marketTypeItems = new()
    {
        new SelectedItem("", "未指定"),
        new SelectedItem("国内", "国内"),
        new SelectedItem("出口", "出口"),
    };

    private static readonly List<SelectedItem> _orderTypeItems = new()
    {
        new SelectedItem("相同", "相同"),
        new SelectedItem("相似", "相似"),
        new SelectedItem("全新", "全新"),
    };

    // (2026-08-25) 主从布局状态。_masterSelected 只用于 SelectedRowsChanged 回传,
    // 业务态走 _selectedOrder;同一行重复点击不重载。
    private List<OrderEntity> _masterSelected = new();
    private OrderEntity? _selectedOrder;
    // (2026-09-04) 主表 Table 引用 + 强制重渲计数器(用于按年月筛选后触发 QueryAsync 刷新)
    private BootstrapBlazor.Components.Table<OrderEntity> _masterTable = default!;
    private int _masterReloadCounter;

    private OrderInfoRow? _infoRow;
    private OrderTypeRow? _orderTypeRow;
    private OrderDesignPhasesRow? _phasesRow;
    private OrderImportantComponentsRow? _componentsRow;

    // (2026-09-04) 编辑草稿:与展示 row 分离,弹窗里改的是这些;Cancel 时直接关弹窗丢弃草稿,
    // 展示 row 不动。Save 成功后用 GetByOrderIdAsync 重新加载展示 row —— 否则 InfoId 仍是 0,
    // Badge 会永远停在 "未填写"。
    private OrderInfoRow? _infoEditModel;
    private OrderTypeRow? _orderTypeEditModel;
    private OrderDesignPhasesRow? _phasesEditModel;
    private OrderImportantComponentsRow? _componentsEditModel;

    private bool _loadingDetail;
    private bool _savingInfo;
    private bool _savingOrderType;
    private bool _savingPhases;
    private bool _savingComponents;

    // (2026-08-25) 订单号快速跳转
    private string _orderNumberSearch = "";
    private bool _searchingOrder;

    // (2026-09-04) 按年/月筛选:两个独立下拉,4 种组合语义。
    //   - 都空 = 全部
    //   - 只选年 = 该年所有(任意月)
    //   - 只选月 = 该月所有(任意年)
    //   - 都选 = 该年该月
    // 值用 string(年存 "2026",月存 "8")是为了 Select null 项("")和 TryParse 方便;不在 UI 显示月份前导 0。
    private string _selectedYear = "";
    private string _selectedMonth = "";
    private List<SelectedItem> _yearItems = new();
    private List<SelectedItem> _monthItems = new();

    // (2026-08-25) 问题汇总(Card 4)状态
    private List<OrderIssues>? _issues;
    private List<OrderIssues> _issueSelected = new();
    private bool _savingIssue;
    private bool _savingResolution;
    private string _newIssueContent = "";
    private string _newResolution = "";
    private OrderIssues? _currentIssueForResolution;
    private BootstrapBlazor.Components.Modal _addIssueModal = default!;
    private BootstrapBlazor.Components.Modal _resolutionModal = default!;

    // (2026-09-04) Card 1/2/3 详情编辑弹窗。沿用 _addIssueModal 模式 (@ref + .Show() / .Close())。
    private BootstrapBlazor.Components.Modal _infoModal = default!;
    private BootstrapBlazor.Components.Modal _orderTypeModal = default!;
    private BootstrapBlazor.Components.Modal _phasesModal = default!;
    private BootstrapBlazor.Components.Modal _componentsModal = default!;
    private BootstrapBlazor.Components.Table<OrderIssues>? _issuesTable;
    // Table @key:变更后强制 Blazor 销毁旧实例重建,绕过 Table 内部缓存。
    // 配合 _issuesTable.QueryAsync() + StateHasChanged() 三重保险。
    private int _issuesReloadCounter;
    // (2026-08-27) Card 4 视图模式:false = 预览最近 5 条(true = 全量 Table + 分页)
    private bool _showAllIssues;

    // (2026-08-27) 预览用的最近 5 条(按创建时间倒序)。Computed property,
    // 避免在 @else 内嵌 @{} 触发 Razor RZ1010。
    private List<OrderIssues> _issuesPreview =>
        (_issues ?? new()).OrderByDescending(i => i.CreatedTime).Take(5).ToList();

    // (2026-08-27) 预览行内容截断 + 空值保护(Content 是 nullable)。
    private static string TruncateIssueContent(string? content, int maxLen)
    {
        var s = content ?? "";
        return s.Length > maxLen ? s.Substring(0, maxLen) + "…" : s;
    }

    // (2026-08-27 晚) 单条问题详情抽屉:点预览行打开,提供完整内容 / 解决方法 / 状态切换 / close
    private bool _issueDrawerVisible;
    private OrderIssues? _currentIssueForDrawer;

    private void OpenIssueDrawer(OrderIssues issue)
    {
        _currentIssueForDrawer = issue;
        _issueDrawerVisible = true;
    }

    private void CloseIssueDrawer()
    {
        _issueDrawerVisible = false;
        // 保留 _currentIssueForDrawer,关闭动画期间还能读;下次 OpenIssueDrawer 会覆盖
    }

    // 抽屉里的状态切换(同全表的 OnIssueStatusChanged,但要刷新 _currentIssueForDrawer)
    private async Task OnDrawerStatusChanged(ChangeEventArgs e)
    {
        if (_currentIssueForDrawer == null) return;
        var newStatus = e.Value?.ToString() ?? "";
        await OnIssueStatusChanged(_currentIssueForDrawer, newStatus);
        // ReloadIssuesAsync 已经在 OnIssueStatusChanged 末尾调用,
        // 但 _currentIssueForDrawer 引用还是旧对象 — 让它从最新 _issues 重新指向
        if (_currentIssueForDrawer != null)
        {
            var refreshed = _issues?.FirstOrDefault(i => i.Id == _currentIssueForDrawer.Id);
            _currentIssueForDrawer = refreshed;
        }
    }

