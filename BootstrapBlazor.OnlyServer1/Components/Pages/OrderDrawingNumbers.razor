@page "/order-drawing-numbers/{orderId:int}"
@attribute [TabItemOption(Text = "订单图号列表")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator)]
@using BootstrapBlazor.OnlyServer1.Services
@using BootstrapBlazor.OnlyServer1.Models
@using BootstrapBlazor.OnlyServer1.Services.Identity
@inject C0XQueryService? DrawingNumberQuery
@inject C0XWriteService? DrawingNumberWrite
@inject OrdersService OrdersService
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Logging.ILogger<OrderDrawingNumbers> Logger
@inject CurrentUserAccessor? CurrentUser
@inject ToastService? ToastService

<PageTitle>订单图号列表</PageTitle>

<div class="page-order-drawing-numbers">
    @if (_order == null)
    {
        <p class="alert alert-info">加载中...</p>
    }
    else
    {
        <div class="mb-3">
            <h1>订单图号列表</h1>
            <button class="btn btn-primary" @onclick="NavigateToAdd">添加图号</button>
        </div>

        <Card IsShadow="true" class="mb-3">
            <BodyTemplate>
                <div class="d-flex flex-wrap align-items-center" style="gap: 1.5rem;">
                    <div>
                        <div class="text-muted small">订单号</div>
                        <div class="fs-4 fw-bold">@_order.OrderNumber</div>
                    </div>
                    <div>
                        <div class="text-muted small">容量</div>
                        <div class="fs-5">@_order.Power kVA</div>
                    </div>
                    <div>
                        <div class="text-muted small">额定电压</div>
                        <div class="fs-5">@_order.RatedVoltage kV</div>
                    </div>
                    <div>
                        <div class="text-muted small">类型</div>
                        @if (_order.IsReactor)
                        {
                            <Badge Color="Color.None" IsPill="true" class="badge-reactor">
                                <i class="fa-solid fa-bolt"></i>
                                <span class="ms-1">电抗器</span>
                            </Badge>
                        }
                        else
                        {
                            <Badge Color="Color.None" IsPill="true" class="badge-transformer">
                                <i class="fa-solid fa-battery-full"></i>
                                <span class="ms-1">变压器</span>
                            </Badge>
                        }
                    </div>
                    <div class="ms-auto text-end text-muted small">
                        <div>创建者:@_order.CreatedBy</div>
                        <div>创建时间:@_order.CreatedTime.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                </div>
            </BodyTemplate>
        </Card>

        @if (_drawingNumbers.Count == 0)
        {
            <div class="alert alert-warning">
                <p>该订单暂无图号，点击上方按钮添加图号</p>
            </div>
        }
        else
        {
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>图号</th>
                        <th>图号名称</th>
                        <th>创建者</th>
                        <th>创建时间</th>
                        <th>修改者</th>
                        <th>修改时间</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _drawingNumbers)
                    {
                        <tr>
                            <td>@item.DrawingTypeNumber</td>
                            <td>@item.DrawName</td>
                            <td>@item.CreatedBy</td>
                            <td>@item.CreatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@item.UpdatedBy</td>
                            <td>@item.UpdatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenEditModal(item)">修改</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

<!-- 修改图号弹窗 -->
@if (_editModalVisible && _editingViewModel != null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" style="display: block;">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">修改图号</h5>
                    <button type="button" class="btn-close" @onclick="CloseEditModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (_editLoading)
                    {
                        <p class="text-muted">加载中...</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label">图号</label>
                            <input class="form-control" type="text" value="@_editingViewModel.DrawingTypeNumber" disabled />
                            <small class="text-muted">主键 ID:@_editingViewModel.Id</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">图纸名称</label>
                            <input class="form-control" type="text" @bind="_editModel.DrawName" />
                            @if (_editErrorMessage != null)
                            {
                                <div class="text-danger mt-1">@_editErrorMessage</div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseEditModal" disabled="@(_editSaving ? "disabled" : null)">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="HandleEditConfirm" disabled="@((_editSaving || _editLoading) ? "disabled" : null)">
                        @if (_editSaving)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span class="ms-2">保存中...</span>
                        }
                        else
                        {
                            <span>保存</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@implements IDisposable

@code {
    [Parameter]
    public int OrderId { get; set; }

    private BootstrapBlazor.OnlyServer1.Models.Orders? _order;
    private List<DrawingNumberViewModel> _drawingNumbers = new List<DrawingNumberViewModel>();

    // 修改弹窗状态
    private bool _editModalVisible = false;
    private bool _editLoading = false;
    private bool _editSaving = false;
    private string? _editErrorMessage = null;
    private DrawingNumberViewModel? _editingViewModel = null;
    private C0XBase? _editingC0x = null;
    private EditModel _editModel = new();

    public class EditModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "图纸名称不能为空")]
        public string DrawName { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("OrderDrawingNumbers: OnInitializedAsync, OrderId = {OrderId}", OrderId);
        await LoadDataAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            NavigationManager.LocationChanged += OnLocationChanged;
        }
    }

    // 同步签名 + InvokeAsync:消除 async void 风险
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // InvokeAsync 在已 Dispose 的组件上直接返回,不会抛
        _ = InvokeAsync(async () => await ReloadIfMatchesAsync(e.Location));
    }

    private async Task ReloadIfMatchesAsync(string url)
    {
        if (_disposed) return;
        if (!url.Contains($"/order-drawing-numbers/{OrderId}", StringComparison.OrdinalIgnoreCase)) return;

        // 取消上一次未完成的加载,避免后到的被先到的覆盖
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        var token = _loadCts.Token;

        try
        {
            _order = null;
            _drawingNumbers = new List<DrawingNumberViewModel>();
            await LoadDataAsync(token);
            if (!_disposed) StateHasChanged();
        }
        catch (OperationCanceledException)
        {
            // 预期的取消,忽略
        }
        catch (Exception ex)
        {
            if (!_disposed)
                Logger.LogError(ex, "OrderDrawingNumbers: Error in ReloadIfMatchesAsync for OrderId = {OrderId}", OrderId);
        }
    }

    private CancellationTokenSource? _loadCts;
    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task LoadDataAsync(CancellationToken ct = default)
    {
        Logger.LogInformation("OrderDrawingNumbers: LoadData starting for OrderId = {OrderId}", OrderId);

        if (DrawingNumberQuery == null)
        {
            Logger.LogWarning("OrderDrawingNumbers: DrawingNumberQuery is null");
            return;
        }

        try
        {
            ct.ThrowIfCancellationRequested();
            _order = await OrdersService.GetByIdAsync(OrderId);
            if (_order == null)
            {
                Logger.LogWarning("Order not found: {OrderId}", OrderId);
                return;
            }

            ct.ThrowIfCancellationRequested();
            Logger.LogInformation("OrderDrawingNumbers: Loaded order successfully");
            _drawingNumbers = await DrawingNumberQuery!.GetAddedDrawingNumberViewModelsByOrderIdAsync(OrderId);
            ct.ThrowIfCancellationRequested();
            Logger.LogInformation("OrderDrawingNumbers: Loaded {Count} drawing numbers", _drawingNumbers.Count);
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OrderDrawingNumbers: Error in LoadData");
        }
    }

    private void NavigateToAdd()
    {
        NavigationManager.NavigateTo($"/add-drawing-numbers/{OrderId}", false);
    }

    private async Task OpenEditModal(DrawingNumberViewModel item)
    {
        if (DrawingNumberQuery == null)
        {
            if (ToastService != null) await ToastService.Error("服务不可用");
            return;
        }

        _editErrorMessage = null;
        _editingViewModel = item;
        _editModel.DrawName = item.DrawName;
        _editModalVisible = true;
        _editLoading = true;

        try
        {
            _editingC0x = await DrawingNumberQuery!.FindDrawingNumberByIdAsync(item.Id, item.DrawingType);
            if (_editingC0x == null)
            {
                if (ToastService != null) await ToastService.Error("图号不存在");
                CloseEditModal();
                return;
            }
            // 同步最新的图号名称到输入框(防止并发修改)
            _editModel.DrawName = _editingC0x.DrawName;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OpenEditModal: failed to load drawing number {Id}", item.Id);
            if (ToastService != null) await ToastService.Error("加载图号失败");
            CloseEditModal();
        }
        finally
        {
            _editLoading = false;
        }
    }

    private void CloseEditModal()
    {
        _editModalVisible = false;
        _editingViewModel = null;
        _editingC0x = null;
        _editModel = new EditModel();
        _editErrorMessage = null;
        _editLoading = false;
        _editSaving = false;
    }

    private async Task HandleEditConfirm()
    {
        if (DrawingNumberWrite == null || CurrentUser == null || _editingC0x == null || _editingViewModel == null)
        {
            if (ToastService != null) await ToastService.Error("服务不可用");
            return;
        }

        if (string.IsNullOrWhiteSpace(_editModel.DrawName))
        {
            _editErrorMessage = "图纸名称不能为空";
            return;
        }

        _editSaving = true;
        _editErrorMessage = null;

        try
        {
            var currentUserName = CurrentUser.GetDisplayName();
            if (string.IsNullOrEmpty(currentUserName))
            {
                if (ToastService != null) await ToastService.Error("未登录");
                _editSaving = false;
                return;
            }

            string oldDrawingName = _editingC0x.DrawName;
            _editingC0x.DrawName = _editModel.DrawName.Trim();
            _editingC0x.UpdatedBy = currentUserName;
            _editingC0x.UpdatedTime = DateTime.Now;

            Logger.LogInformation("User {UserName} updating drawing number {DrawingTypeNumber}, from '{OldName}' to '{NewName}'",
                currentUserName, _editingViewModel.DrawingTypeNumber, oldDrawingName, _editingC0x.DrawName);

            int result = await DrawingNumberWrite!.UpdateCX0DrawingNumberByIdAsync(_editingC0x, _editingViewModel.DrawingType);

            if (result > 0)
            {
                Logger.LogInformation("Update successful for drawing number {Id}", _editingC0x.Id);
                if (ToastService != null) await ToastService.Success("修改成功");
                CloseEditModal();
                // 不跳转页面,只刷新当前列表
                await LoadDataAsync();
            }
            else
            {
                if (ToastService != null) await ToastService.Error("修改图号失败");
                _editErrorMessage = "修改图号失败,请重试";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error updating drawing number");
            if (ToastService != null) await ToastService.Error("修改图号时发生错误");
            _editErrorMessage = "修改图号时发生错误";
        }
        finally
        {
            _editSaving = false;
        }
    }
}
