@page "/tap-changer-models"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = RoleNames.Admin)]
@inject TapChangerModelService TapChangerModelService
@inject TapChangerManufacturerService TapChangerManufacturerService
@inject CurrentUserAccessor CurrentUser
@inject ToastService ToastService

<PageTitle>分接开关型号管理</PageTitle>

<div class="page-tap-changer-models">
    <h1>分接开关型号管理</h1>

    @* (2026-09-05 新增)型号录入时下拉里缺厂家时,不必跳到 TapChangerManufacturers 管理页;
         在本页面直接弹 Modal 加厂家,保存后立刻刷新本页厂家下拉与列名查找表 *@
    <div class="d-flex align-items-center mb-2" style="gap: 0.5rem;">
        <Button Color="Color.Success" Icon="fa-solid fa-plus"
                IsDisabled="@(!CurrentUser.HasPermission(PermissionCodes.TapChangerManufacturerCreate))"
                OnClick="ShowAddManufacturerDialog">
            新增加开关厂家
        </Button>
        <span class="text-muted small">录入型号时下拉里没找到厂家?在这里先添加。</span>
    </div>

    <Table TItem="TapChangerModel"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           RenderMode="TableRenderMode.Table"
           IsFixedHeader="true"
           IsStriped="true"
           IsBordered="true"
           OnQueryAsync="OnQueryAsync"
           ShowSearch="true"
           ShowToolbar="true"
           ShowExtendButtons="true"
           OnAddAsync="OnAddAsync"
           OnSaveAsync="OnSaveAsync"
           OnDeleteAsync="OnDeleteAsync"
           EditMode="EditMode.Popup"
           ShowSkeleton="true"
           IsMultipleSelect="true"
           Height="700"
           ShowAddButton="@CurrentUser.HasPermission(PermissionCodes.TapChangerModelCreate)"
           ShowDeleteButton="@CurrentUser.HasPermission(PermissionCodes.TapChangerModelDelete)">
        <TableColumns>
            <TableColumn @bind-Field="@context.Id" Width="80" Align="Alignment.Center" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.Name" Width="380" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.ManufacturerId" Title="厂家" Width="160" Readonly="true">
                <Template Context="value">
                    @LookupManufacturerName((int)value.Value)
                </Template>
            </TableColumn>
            <TableColumn @bind-Field="@context.UmKv" Width="100" Align="Alignment.Center" />
            <TableColumn @bind-Field="@context.IsActive" Width="100" Align="Alignment.Center" ComponentType="typeof(Switch)" />
            <TableColumn @bind-Field="@context.CreatedTime" Width="180" Align="Alignment.Center" Sortable="true" Readonly="true">
                <Template Context="value">
                    @value.Value.ToString("yyyy-MM-dd HH:mm:ss")
                </Template>
            </TableColumn>
        </TableColumns>
        <EditTemplate>
            <div class="row g-3">
                <div class="col-12">
                    <Select TValue="int"
                            @bind-Value="@context.ManufacturerId"
                            Items="@_manufacturerItems"
                            ShowLabel="true"
                            DisplayName="所属厂家 *"
                            ShowSearch="true"
                            PlaceHolder="请选择厂家" />
                </div>
                <div class="col-3">
                    <BootstrapInputNumber @bind-Value="@context.NumberOfColumns" ShowLabel="true" DisplayName="列数" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.TypeCode" ShowLabel="true" DisplayName="类型码 (Type)" MaxLength="20" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.NumberOfPhases" ShowLabel="true" DisplayName="相数 (I/II/III)" MaxLength="10" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.RatedCurrentCode" ShowLabel="true" DisplayName="额定电流码" MaxLength="20" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.YjdCode" ShowLabel="true" DisplayName="Y/JD(可空)" MaxLength="10" />
                </div>
                <div class="col-3">
                    <BootstrapInputNumber @bind-Value="@context.UmKv" ShowLabel="true" DisplayName="Um (kV)" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.TapSelectorSize" ShowLabel="true" DisplayName="分接选择器尺寸" MaxLength="20" />
                </div>
                <div class="col-3">
                    <Switch @bind-Value="@context.IsActive" ShowLabel="true" DisplayName="启用" />
                </div>
                <div class="col-12">
                    <div class="form-label">接线图 (Basic connection diagram,4 段)</div>
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.BD1" ShowLabel="true" DisplayName="段 1" MaxLength="10" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.BD2" ShowLabel="true" DisplayName="段 2" MaxLength="10" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.BD3" ShowLabel="true" DisplayName="段 3" MaxLength="10" />
                </div>
                <div class="col-3">
                    <BootstrapInput @bind-Value="@context.BD4" ShowLabel="true" DisplayName="段 4" MaxLength="10" />
                </div>
            </div>
        </EditTemplate>
    </Table>
</div>

@* (2026-09-05 新增)新增加开关厂家 Modal — 沿用 OrderManagement.razor 的 @ref + Show/Close 三件套模式 *@
<Modal @ref="_addManufacturerModal" IsBackdrop="true" ShowCloseButton="true">
    <ModalDialog Title="新增分接开关厂家" Size="Size.Medium">
        <BodyTemplate>
            <BootstrapInput TValue="string" @bind-Value="_newManufacturerName"
                            ShowLabel="true" DisplayName="厂家名称"
                            PlaceHolder="例如:MR(莱茵豪森)、ABB、华明"
                            MaxLength="100"
                            IsDisabled="@_savingNewManufacturer" />
            <div class="form-text">
                名称大小写无关去重(IsDeleted=0 唯一);100 字符以内。保存后立刻出现在下方「所属厂家」下拉里。
            </div>
        </BodyTemplate>
        <FooterTemplate>
            <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveNewManufacturerAsync"
                    IsDisabled="@_savingNewManufacturer">
                @(_savingNewManufacturer ? "保存中..." : "保存")
            </Button>
            <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseAddManufacturerDialog"
                    IsDisabled="@_savingNewManufacturer">
                取消
            </Button>
        </FooterTemplate>
    </ModalDialog>
</Modal>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private List<SelectedItem> _manufacturerItems = new();

    protected override async Task OnInitializedAsync()
    {
        // 编辑表单的厂家下拉数据(SelectedItem 列表)
        var manufacturers = await TapChangerManufacturerService.GetAllIncludingInactiveAsync();
        _manufacturerItems = manufacturers
            .OrderBy(m => !m.IsActive) // 启用项在前
            .ThenBy(m => m.Name)
            .Select(m => new SelectedItem(m.Id.ToString(), m.Name))
            .ToList();
        // BootstrapBlazor 8.11 Select value=0 时回退到 Items 第 0 项,
        // 不显示 PlaceHolder。头部插 "请选择" (Value="0") 让占位文本真实生效。
        _manufacturerItems.Insert(0, new SelectedItem("0", "请选择厂家"));

        var activeMfr = manufacturers.FirstOrDefault(m => m.IsActive);
        _defaultManufacturerId = activeMfr?.Id ?? 0;
    }

    private int _defaultManufacturerId;
    private Dictionary<int, string> _manufacturerLookup = new();

    private string LookupManufacturerName(int id)
        => _manufacturerLookup.TryGetValue(id, out var n) ? n : $"#{id}";

    private async Task<QueryData<TapChangerModel>> OnQueryAsync(QueryPageOptions options)
    {
        var list = await TapChangerModelService.GetAllIncludingInactiveAsync();

        // 同步构建厂家名称查询字典(每次 OnQuery 重新拉,保证停用/启用状态最新)
        var manufacturers = await TapChangerManufacturerService.GetAllIncludingInactiveAsync();
        _manufacturerLookup = manufacturers.ToDictionary(m => m.Id, m => m.Name);

        return new QueryData<TapChangerModel>
        {
            TotalCount = list.Count,
            Items = list,
            IsSorted = false,
            IsFiltered = false,
            IsSearch = false,
        };
    }

    private Task<TapChangerModel> OnAddAsync()
        => Task.FromResult(new TapChangerModel
        {
            ManufacturerId = _defaultManufacturerId,
            IsActive = true,
            CreatedTime = DateTime.Now,
        });

    private async Task<bool> OnSaveAsync(TapChangerModel item, ItemChangedType changedType)
    {
        if (item.ManufacturerId <= 0)
        {
            await ShowToast("请选择关联的分接开关厂家", ToastCategory.Error);
            return false;
        }

        if (changedType == ItemChangedType.Add)
        {
            var (ok, error, _) = await TapChangerModelService.CreateAsync(item);
            if (!ok)
            {
                await ShowToast(error ?? "新增失败", ToastCategory.Error);
                return false;
            }
            await ShowToast("新增成功", ToastCategory.Success);
            return true;
        }

        var (uOk, uErr) = await TapChangerModelService.UpdateAsync(item);
        if (!uOk)
        {
            await ShowToast(uErr ?? "保存失败", ToastCategory.Error);
            return false;
        }
        await ShowToast("保存成功", ToastCategory.Success);
        return true;
    }

    private async Task<bool> OnDeleteAsync(IEnumerable<TapChangerModel> items)
    {
        foreach (var item in items)
        {
            var (ok, err) = await TapChangerModelService.DeleteAsync(item.Id);
            if (!ok)
            {
                await ShowToast(err ?? $"删除「{item.Name}」失败", ToastCategory.Error);
                return false;
            }
        }
        await ShowToast("已删除", ToastCategory.Success);
        return true;
    }

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2000
        });
    }

    // ===== (2026-09-05 新增)本页内"新增加开关厂家"弹窗 — 沿用 OrderManagement.razor 同款模式 =====

    // (2026-09-05) Modal 引用 + 草稿状态。Modal 默认值 default! 与现有 _addIssueModal 等保持一致风格。
    private BootstrapBlazor.Components.Modal _addManufacturerModal = default!;
    private string _newManufacturerName = "";
    private bool _savingNewManufacturer;

    /// <summary>
    /// 打开弹窗前再做一次权限检查(页面顶层已 require Admin,但 Operator+Viewer 也能进本页;
    /// 当前台 @Disabled 不严时(比如 Service 改了权限),这里再挡一次)。
    /// </summary>
    private async Task ShowAddManufacturerDialog()
    {
        if (!CurrentUser.HasPermission(PermissionCodes.TapChangerManufacturerCreate))
        {
            await ShowToast("无 TapChanger.Manufacturer.Create 权限", ToastCategory.Warning);
            return;
        }
        _newManufacturerName = "";
        await _addManufacturerModal.Show();
    }

    private async Task CloseAddManufacturerDialog()
    {
        if (_savingNewManufacturer) return; // 防并发:保存中点 X 无效
        await _addManufacturerModal.Close();
    }

    private async Task SaveNewManufacturerAsync()
    {
        if (_savingNewManufacturer) return;
        if (string.IsNullOrWhiteSpace(_newManufacturerName))
        {
            await ShowToast("厂家名称不能为空", ToastCategory.Error);
            return;
        }
        _savingNewManufacturer = true;
        try
        {
            // Service 内部已有 Admin 角色校验 + 大小写无关去重 + 100 字符上限(纵深防御)
            var (ok, error, _) = await TapChangerManufacturerService.CreateAsync(_newManufacturerName);
            if (!ok)
            {
                await ShowToast(error ?? "新增失败", ToastCategory.Error);
                return;
            }
            await ShowToast("厂家已新增", ToastCategory.Success);
            await _addManufacturerModal.Close();
            // 关键:刷新本页厂家下拉 + 列名查找表,让新厂家立刻出现在「所属厂家」下拉里
            await RefreshManufacturersAsync();
            _newManufacturerName = "";
        }
        finally
        {
            _savingNewManufacturer = false;
        }
    }

    /// <summary>
    /// (2026-09-05) 刷新厂家下拉 + 表格列名查找表。
    /// 沿用 OnInitializedAsync 同样的"启用项在前 + 按 Name 排序 + 头部插「请选择厂家」"逻辑;
    /// 新增厂家 IsActive=true,排序自动排前面。
    /// OnInitializedAsync 当前未抽出来复用(代码微重复),后续若再加「编辑/删除」可统一收口。
    /// </summary>
    private async Task RefreshManufacturersAsync()
    {
        var manufacturers = await TapChangerManufacturerService.GetAllIncludingInactiveAsync();
        _manufacturerLookup = manufacturers.ToDictionary(m => m.Id, m => m.Name);

        _manufacturerItems = manufacturers
            .OrderBy(m => !m.IsActive) // 启用项在前
            .ThenBy(m => m.Name)
            .Select(m => new SelectedItem(m.Id.ToString(), m.Name))
            .ToList();
        // BootstrapBlazor 8.11 Select value=0 时回退到 Items 第 0 项,
        // 不显示 PlaceHolder。头部插 "请选择" (Value="0") 让占位文本真实生效。
        _manufacturerItems.Insert(0, new SelectedItem("0", "请选择厂家"));
    }
}
