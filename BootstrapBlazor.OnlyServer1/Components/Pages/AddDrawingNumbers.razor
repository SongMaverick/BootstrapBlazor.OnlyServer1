@page "/add-drawing-numbers/{orderId:int}"
@attribute [TabItemOption(Text = "添加图号")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator)]
@using BootstrapBlazor.OnlyServer1.Models
@using BootstrapBlazor.OnlyServer1.Services
@inject DrawingNameService? DrawingNameService
@inject C0XQueryService? C0XQueryService
@inject C0XWriteService? C0XWriteService
@inject OrdersService OrdersService
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Logging.ILogger<AddDrawingNumbers> Logger

<PageTitle>添加图号</PageTitle>

<div class="page-add-drawing-numbers">
    @if (_order == null) {
        <p class="alert alert-info">加载中...</p>
    }
    else {
        <div class="card mb-3">
            <div class="card-header">
                <h3>添加图号</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <button class="btn btn-primary" @onclick="HandleAddDrawingNumbers" disabled="@isAdding">
                        @if (isAdding) {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span class="ms-2">添加中...</span>
                        }
                        else {
                            <span>添加图号</span>
                        }
                    </button>
                    <button class="btn btn-success ms-2" @onclick="HandleChangeSequence" disabled="@isAdding">
                        更改顺序添加图号
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="ToggleAllCollapse" disabled="@(_partGroups.Count == 0)">
                        <i class="fa-solid @(AllCollapsed ? "fa-angles-down" : "fa-angles-up") me-1"></i>
                        @(AllCollapsed ? "全部展开" : "全部折叠")
                    </button>
                    <button class="btn btn-info ms-2" @onclick="GoBack">
                        返回图号列表
                    </button>
                </div>

                @if (showError && !string.IsNullOrEmpty(_partErrorMessage)) {
                    <div class="alert alert-danger" role="alert">
                        <strong>添加失败</strong>
                        <ul class="mb-0 mt-1">
                            @foreach (var line in _partErrorMessage.Split('\n'))
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </div>
                }

                @*
                    动态分组渲染(2026-07-07 UX 调优):
                      - _partGroups 是 Dictionary<string, List<CheckboxItem>>,key = Part 名(ESL-01 / TItU / ...)
                      - 响应式列数(解决"两列内容太多要滚动"的问题):
                          手机(<576px)        :1 列  col-12
                          平板竖屏(576-768)  :2 列  col-sm-6
                          笔记本(768-1200)   :3 列  col-lg-4
                          大屏显示器(≥1200)  :4 列  col-xl-3
                      - h-100 让 grid 卡片等高
                      - g-2 把列之间间距缩小,适合多卡片密集布局
                      - 颜色:Part 名字 hash 选,同 Part 颜色稳定
                *@
                @if (_partGroups.Count == 0) {
                    <div class="alert alert-info" role="alert">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        库里还没有任何图名,无法添加。
                        请先去 <a href="/drawing-names" class="alert-link">图名列表</a> 添加图名后,再回到这里添加图号。
                    </div>
                }
                else {
                    <div class="row g-2">
                        @foreach (var part in _orderedParts) {
                            var items = _partGroups[part];
                            var style = GetPartCardStyle(part);
                            var isCollapsed = IsCollapsed(part);
                            var selectedCount = GetSelectedCountForPart(items);

                            @* (2026-07-07 UX 调优第 2 轮) 改为"每行 1 个 Part"的列表式布局。
                               单列下 h-100 会强行撑满视口,反而丑,所以删了。 *@
                            <div class="col-12">
                                <div class="card mb-3 shadow-sm">
                                    <div class="card-header @style.HeaderClass @style.HeaderTextClass user-select-none"
                                         role="button"
                                         @onclick="() => ToggleCollapse(part)"
                                         style="cursor: pointer;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="mb-0">@GetPartTitle(part)</h5>
                                            <div class="d-flex align-items-center small">
                                                <span class="badge @(selectedCount > 0 ? "bg-warning text-dark" : "bg-light text-dark") me-2"
                                                      style="font-size: 0.75em;">
                                                    @if (selectedCount > 0) {
                                                        <i class="fa-solid fa-check me-1"></i>
                                                    }
                                                    已选 @selectedCount
                                                </span>
                                                <i class="fa-solid @(isCollapsed ? "fa-chevron-right" : "fa-chevron-down")"></i>
                                            </div>
                                        </div>
                                    </div>
                                    @if (!isCollapsed) {
                                        <div class="card-body" style="background-color: @style.BodyBg;">
                                            @if (items.Count == 0) {
                                                <p class="text-muted small mb-0">没有可添加的 @part 图号</p>
                                            }
                                            else {
                                                @* (2026-07-07 UX 调优第 3 轮) 图名水平多列 —
                                                   响应式:
                                                     手机(<576px)        :1 列  col-12
                                                     平板(576-768)      :2 列  col-sm-6
                                                     中屏(768-992)      :3 列  col-md-4
                                                     标准笔记本(992-1200):4 列  col-lg-3
                                                     大显示器(≥1200)    :6 列  col-xl-2
                                                   行内多列后多数图名能在一行内显示完整,
                                                   减少"展开 Part 后还要滚动"的二次问题。 *@
                                                <div class="row g-2">
                                                    @foreach (var item in items) {
                                                        <div class="col-12 col-sm-6 col-md-4 col-lg-3 col-xl-2">
                                                            <div class="form-check mb-2">
                                                                <input class="form-check-input" type="checkbox" id="check-@item.Id" @bind="item.IsChecked" disabled="@item.IsAdded">
                                                                <label class="form-check-label @(item.IsAdded ? "text-muted text-decoration-line-through" : "")" for="check-@item.Id">
                                                                    @item.DrawingName.ComponentName
                                                                    @if (item.IsAdded) {
                                                                        <span class="badge bg-secondary ms-2" style="font-size: 0.7em;">已添加</span>
                                                                    }
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- 更改顺序对话框 -->
    @if (dialogVisible) {
        <div class="modal d-block" tabindex="-1" role="dialog" style="display: block;">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">更改图号顺序</h5>
                        <button type="button" class="btn-close" @onclick="HandleDialogCancel" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted mb-2">每行一个图号，您可以调整顺序：</p>
                        <textarea class="form-control" rows="15" @bind="editorContent" placeholder="图号名称（每行一个，可调整顺序）"></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="HandleDialogCancel">取消</button>
                        <button type="button" class="btn btn-success" @onclick="HandleDialogConfirm" disabled="@isAdding">
                            @if (isAdding) {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span class="ms-2">添加中...</span>
                            }
                            else {
                                <span>更改顺序添加图号</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }

    <!-- 添加结果 Modal(全成功 / 部分成功 都用这个) -->
    @if (_resultModalVisible && _result != null) {
        <div class="modal d-block" tabindex="-1" role="dialog" style="display: block;">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            @if (_result.AllSucceeded) {
                                <span class="text-success">添加成功</span>
                            }
                            else {
                                <span class="text-warning">
                                    添加结果:成功 @_result.Success.Count,失败 @_result.Failures.Count
                                </span>
                            }
                        </h5>
                        <button type="button" class="btn-close" @onclick="OnResultModalDismissed" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (_result.Success.Count > 0) {
                            <p class="text-success mb-1">成功添加 @_result.Success.Count 条:</p>
                            <ul class="text-success small mb-3">
                                @foreach (var name in _result.Success) {
                                    <li>@name</li>
                                }
                            </ul>
                        }
                        @if (_result.Failures.Count > 0) {
                            <p class="text-danger mb-1">失败明细:</p>
                            <ul class="text-danger small mb-0">
                                @foreach (var f in _result.Failures) {
                                    <li><strong>@f.Name</strong> — @f.Reason</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" @onclick="OnResultModalDismissed">查看列表</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    [Parameter]
    public int OrderId { get; set; }

    private BootstrapBlazor.OnlyServer1.Models.Orders? _order;
    private bool isAdding = false;
    private bool showError = false;
    private string? _partErrorMessage;
    private bool dialogVisible = false;
    private string editorContent = string.Empty;

    // 结果 Modal 状态
    private DrawingNumberInsertResult? _result;
    private bool _resultModalVisible;

    // 动态分组:Part 名字 -> 该 Part 下的所有图名(按"是否已添加"标好状态)
    private Dictionary<string, List<CheckboxItem>> _partGroups = new();
    private List<string> _orderedParts = new();  // 稳定排序(ESL-01/02/03/Core 在前,新 Part 字典序追加)

    // (2026-07-07 UX 折叠功能) 默认全折叠;用户点 header 展开/收起
    private HashSet<string> _collapsedParts = new(StringComparer.OrdinalIgnoreCase);

    // (2026-07-08 Review #L-9) CheckboxItem / CardStyle 已提取到 Models/ViewModels/,通过 _Imports.razor 自动可见

    private static readonly string[] _bgClasses = new[] {
        "bg-warning", "bg-success", "bg-info", "bg-secondary",
        "bg-primary", "bg-danger", "bg-dark", "bg-light"
    };
    private static readonly string[] _lightText = new[] { "text-dark", "text-white" };

    /// <summary>
    /// Header bg class → 同色系浅色 hex(用于 card-body 背景)。
    /// 用 Bootstrap 5.3 subtle 配色思路的近似 hex,不依赖具体 Bootstrap 类名,
    /// 任何版本都能用。
    /// </summary>
    private static string LightBgFor(string bg) => bg switch
    {
        "bg-warning"   => "#fff3cd",   // 淡黄
        "bg-success"   => "#d1e7dd",   // 淡绿
        "bg-info"      => "#cff4fc",   // 淡青
        "bg-secondary" => "#e2e3e5",   // 淡灰
        "bg-primary"   => "#cfe2ff",   // 淡蓝
        "bg-danger"    => "#f8d7da",   // 淡红
        "bg-dark"      => "#d3d3d4",   // 浅深灰
        "bg-light"     => "#fefefe",   // 近白
        _              => "#f8f9fa"
    };

    private CardStyle GetPartCardStyle(string part) {
        if (string.IsNullOrEmpty(part)) return new CardStyle("bg-secondary", "text-white", LightBgFor("bg-secondary"));

        // 优先复用原来的 4 个固定配色,保持视觉一致
        var known = part.ToUpperInvariant() switch {
            "ESL-01" => new CardStyle("bg-warning", "text-dark", LightBgFor("bg-warning")),
            "ESL-02" => new CardStyle("bg-success", "text-white", LightBgFor("bg-success")),
            "ESL-03" => new CardStyle("bg-info", "text-white", LightBgFor("bg-info")),
            "ESL-CORE" => new CardStyle("bg-secondary", "text-white", LightBgFor("bg-secondary")),
            _ => null
        };
        if (known != null) return known;

        // 新 Part:用 hash 分配颜色
        int hash = Math.Abs(part.GetHashCode());
        var bg = _bgClasses[hash % _bgClasses.Length];
        var text = bg is "bg-warning" or "bg-light" ? "text-dark" : "text-white";
        return new CardStyle(bg, text, LightBgFor(bg));
    }

    private string GetPartTitle(string part) {
        // 4 个老 Part 用原来的中文标题,新 Part 直接显示 Part 名
        return part.ToUpperInvariant() switch {
            "ESL-01" => "外部 (ESL-01)",
            "ESL-02" => "内部 (ESL-02)",
            "ESL-03" => "串联电抗器 (ESL-03)",
            "ESL-CORE" => "铁芯 (ESL-Core)",
            _ => part
        };
    }

    protected override async Task OnInitializedAsync() {
        showError = false;
        _partErrorMessage = null;

        if (DrawingNameService == null || C0XQueryService == null) {
            Logger.LogWarning("DrawingNameService or C0XQueryService is null");
            return;
        }

        try {
            _order = await OrdersService.FindByIdAsync(OrderId);
            if (_order == null) {
                Logger.LogWarning("Order not found: {OrderId}", OrderId);
                return;
            }

            var allDrawingNames = await DrawingNameService!.GetAllAsync();
            var addedDrawingNames = await C0XQueryService!.GetAddedDrawingNumbersByOrderIdAsync(OrderId);
            var addedDrawingNamesSet = new HashSet<string>(addedDrawingNames.Select(dn => dn.DrawingName));

            // 按 Part 分组(空 Part 走 "未分类")
            _partGroups = new Dictionary<string, List<CheckboxItem>>(StringComparer.OrdinalIgnoreCase);
            foreach (var dn in allDrawingNames) {
                var isAdded = addedDrawingNamesSet.Contains(dn.ComponentName);
                var checkboxItem = new CheckboxItem {
                    Id = dn.Id,
                    DrawingName = dn,
                    IsChecked = isAdded,
                    IsAdded = isAdded
                };
                var partKey = string.IsNullOrWhiteSpace(dn.Part) ? "未分类" : dn.Part;
                if (!_partGroups.TryGetValue(partKey, out var list)) {
                    list = new List<CheckboxItem>();
                    _partGroups[partKey] = list;
                }
                list.Add(checkboxItem);
            }

            // 排序:4 个老 Part 按业务顺序在前(ESL-01 → 02 → 03 → Core),其他字典序
            var priority = new[] { "ESL-01", "ESL-02", "ESL-03", "ESL-Core" };
            _orderedParts = _partGroups.Keys
                .OrderBy(p => {
                    var idx = Array.FindIndex(priority, x => x.Equals(p, StringComparison.OrdinalIgnoreCase));
                    return idx < 0 ? int.MaxValue : idx;
                })
                .ThenBy(p => p, StringComparer.OrdinalIgnoreCase)
                .ToList();

            // (2026-07-07 UX 折叠功能) 默认全折叠 — 把所有 Part 加进 collapsed 集合
            _collapsedParts = new HashSet<string>(_orderedParts, StringComparer.OrdinalIgnoreCase);
        }
        catch (Exception ex) {
            Logger.LogError(ex, "Error initializing page");
            showError = true;
            _partErrorMessage = "页面初始化失败,请刷新重试";
        }
    }

    private List<string> GetCheckedItems() {
        return _partGroups.Values
            .SelectMany(list => list)
            .Where(item => item.IsChecked && !item.IsAdded)
            .Select(item => item.DrawingName.ComponentName)
            .ToList();
    }

    // ===== 折叠/展开逻辑(2026-07-07 UX) =====

    private bool IsCollapsed(string part) => _collapsedParts.Contains(part);

    private void ToggleCollapse(string part)
    {
        if (_collapsedParts.Contains(part))
            _collapsedParts.Remove(part);
        else
            _collapsedParts.Add(part);
    }

    /// <summary>全部展开 vs 全部折叠:根据当前状态二选一。</summary>
    private bool AllCollapsed => _orderedParts.Count > 0
                                  && _collapsedParts.Count >= _orderedParts.Count;

    private void ToggleAllCollapse()
    {
        if (AllCollapsed)
            _collapsedParts.Clear();        // 全部展开
        else
            _collapsedParts = new HashSet<string>(_orderedParts, StringComparer.OrdinalIgnoreCase);  // 全部折叠
    }

    /// <summary>该 Part 下"已勾但未加"的图号数(用于标题栏 badge)。</summary>
    private static int GetSelectedCountForPart(List<CheckboxItem> items)
        => items.Count(i => i.IsChecked && !i.IsAdded);

    private Task HandleChangeSequence() {
        var checkedItems = GetCheckedItems();
        editorContent = string.Join(Environment.NewLine, checkedItems);
        dialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleDialogConfirm() {
        isAdding = true;
        showError = false;
        _partErrorMessage = null;

        try {
            if (C0XWriteService == null) {
                Logger.LogWarning("C0XWriteService is null");
                showError = true;
                _partErrorMessage = "服务不可用";
                return;
            }

            var checkedDrawingNumbersList = editorContent
                .Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries)
                .Select(l => l.Trim())
                .Where(l => !string.IsNullOrEmpty(l))
                .ToArray();

            if (checkedDrawingNumbersList.Length == 0) {
                return;
            }

            Logger.LogInformation("Adding {Count} drawing numbers (with custom order) to order {OrderId}", checkedDrawingNumbersList.Length, OrderId);

            var result = await C0XWriteService!.AddDrawingNumbersAsync(OrderId, checkedDrawingNumbersList);
            dialogVisible = false;
            HandleInsertResult(result);
        }
        catch (Exception ex) {
            Logger.LogError(ex, "Error adding drawing numbers");
            showError = true;
            _partErrorMessage = "添加图号时发生错误";
        }
        finally {
            isAdding = false;
        }
    }

    private Task HandleDialogCancel() {
        dialogVisible = false;
        return Task.CompletedTask;
    }

    private async Task HandleAddDrawingNumbers() {
        isAdding = true;
        showError = false;
        _partErrorMessage = null;

        try {
            if (C0XWriteService == null) {
                Logger.LogWarning("C0XWriteService is null");
                showError = true;
                _partErrorMessage = "服务不可用";
                return;
            }

            var checkedItems = GetCheckedItems();
            if (checkedItems.Count == 0) {
                return;
            }

            Logger.LogInformation("Adding {Count} drawing numbers to order {OrderId}", checkedItems.Count, OrderId);

            var result = await C0XWriteService!.AddDrawingNumbersAsync(OrderId, checkedItems.ToArray());
            HandleInsertResult(result);
        }
        catch (Exception ex) {
            Logger.LogError(ex, "Error adding drawing numbers");
            showError = true;
            _partErrorMessage = "添加图号时发生错误";
        }
        finally {
            isAdding = false;
        }
    }

    /// <summary>
    /// 统一处理 AddDrawingNumbersAsync 返回的结果:
    ///   - 全成功:直接跳列表页(forceLoad: true 拿最新数据)
    ///   - 部分成功:弹 Modal 等用户确认/关闭,任何路径都跳列表页
    ///   - 全失败:页面错误区显示失败明细,不跳转,允许用户改正后重试
    /// </summary>
    private void HandleInsertResult(DrawingNumberInsertResult result) {
        _result = result;

        if (result.NoneSucceeded) {
            // 全失败:不弹 Modal,留在原页方便改正重试
            showError = true;
            _partErrorMessage = string.Join("\n",
                result.Failures.Select(f => $"• {f.Name} — {f.Reason}"));
            Logger.LogWarning("AddDrawingNumbers all failed: count={Count}", result.Failures.Count);
            return;
        }

        // 全成功 或 部分成功:弹 Modal
        _resultModalVisible = true;
        Logger.LogInformation("AddDrawingNumbers done: success={S} fail={F}",
            result.Success.Count, result.Failures.Count);
    }

    /// <summary>
    /// 任何关闭路径(确认按钮 / 关闭按钮 / 取消)都跳转到订单图号列表页,
    /// forceLoad: true 拿最新数据。
    /// </summary>
    private void OnResultModalDismissed() {
        _resultModalVisible = false;
        NavigationManager.NavigateTo($"/order-drawing-numbers/{OrderId}", forceLoad: true);
    }

    private void GoBack() {
        NavigationManager.NavigateTo($"/order-drawing-numbers/{OrderId}", false);
    }
}
