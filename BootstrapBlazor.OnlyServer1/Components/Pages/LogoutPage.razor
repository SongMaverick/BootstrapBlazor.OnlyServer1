@page "/logout"
@layout BootstrapBlazor.OnlyServer1.Components.Shared.LoginLayout
@inject NavigationManager Nav

@code {
    protected override void OnInitialized()
    {
        // 真正的登出通过 MainLayout 下拉菜单的 form post 到 /Account/Logout 完成
        // 这个 /logout 页面只用于书签兼容 / 防止用户直接访问
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
