@page "/orders"
@attribute [TabItemOption(Text = "订单列表")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Viewer)]
@inject BootstrapBlazor.OnlyServer1.Services.OrdersService OrdersService
@inject C0XQueryService? DrawingNumberQuery
@inject Microsoft.Extensions.Logging.ILogger<Orders> Logger
@inject BootstrapBlazor.OnlyServer1.Services.Identity.CurrentUserAccessor CurrentUser
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>订单列表</PageTitle>

<div class="page-orders">
    <h1>订单列表</h1>

    <Table TItem="Models.Orders"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           RenderMode="TableRenderMode.Table"
           IsFixedHeader="true"
           IsStriped="true"
           IsBordered="true"
           OnQueryAsync="OnQueryAsync"
           ShowSearch="true"
           ShowToolbar="true"
           ShowExtendButtons="true"
           ShowEditButton="false"
           ShowDeleteButton="false"
           OnAddAsync="OnAddAsync"
           OnSaveAsync="OnSaveAsync"
           OnDeleteAsync="OnDeleteAsync"
           EditMode="EditMode.Popup"
           ShowSkeleton="true"
           IsMultipleSelect="true"
           SelectedRows="_selectedRows"
           SelectedRowsChanged="OnSelectedRowsChanged"
           Height="600"
           ShowAddButton="@CurrentUser.HasPermission(PermissionCodes.OrderCreate)"
  ShowExtendEditButtonCallback="@((Models.Orders item) => CurrentUser.HasPermission(PermissionCodes.OrderEdit))"
            DisableExtendEditButtonCallback="@((Models.Orders item) => HasDrawingNumber(item))"
            DisableExtendDeleteButtonCallback="@((Models.Orders item) => !CurrentUser.HasPermission(PermissionCodes.OrderDelete) || HasDrawingNumber(item))"
            @ref="OrdersTable">
        <TableColumns>
            <TableColumn @bind-Field="@context.Id" Text="编号" Width="80" Align="Alignment.Center" Sortable="true" Readonly="true" IsVisibleWhenAdd="false" />
            <TableColumn @bind-Field="@context.OrderNumber" Text="订单号" Width="120" Align="Alignment.Center" Sortable="true" ReadonlyCallback="@((Models.Orders item) => item.Id > 0)" />
            <TableColumn @bind-Field="@context.Power" Text="容量" Width="100" Align="Alignment.Center" Sortable="true" />
            <TableColumn @bind-Field="@context.RatedVoltage" Text="额定电压" Width="120" Align="Alignment.Center" Sortable="true" />
            <TableColumn @bind-Field="@context.IsReactor" Text="电抗器" Width="100" Align="Alignment.Center" Sortable="true">
                <Template Context="value">
                    @if (value.Value)
                    {
                        <Badge Color="Color.None" IsPill="true" class="badge-reactor">
                            <i class="fa-solid fa-bolt"></i>
                            <span class="ms-1">电抗器</span>
                        </Badge>
                    }
                    else
                    {
                        <Badge Color="Color.None" IsPill="true" class="badge-transformer">
                            <i class="fa-solid fa-battery-full"></i>
                            <span class="ms-1">变压器</span>
                        </Badge>
                    }
                </Template>
            </TableColumn>
            <TableColumn @bind-Field="@context.CreatedBy" Text="创建者" Width="120" Sortable="true" Readonly="true" IsVisibleWhenAdd="false" />
            <TableColumn @bind-Field="@context.CreatedTime" Text="创建时间" Width="180" Align="Alignment.Center" Sortable="true" Readonly="true" IsVisibleWhenAdd="false">
                <Template Context="value">
                    @value.Value.ToString("yyyy-MM-dd HH:mm:ss")
                </Template>
            </TableColumn>
        </TableColumns>
        <TableToolbarTemplate>
            @if (CurrentUser.HasPermission(PermissionCodes.DrawingNumberAllocate))
            {
                <Button Color="Color.Primary" Icon="fa-solid fa-plus"
                        OnClick="OnToolbarAddDrawingNumberClick">
                    添加图号
                </Button>
            }
            @if (CurrentUser.HasPermission(PermissionCodes.DrawingNumberRead))
            {
                <Button Color="Color.Primary" Icon="fa-solid fa-list"
                        OnClick="OnToolbarViewDrawingNumberClick">
                    查看图号
                </Button>
            }
        </TableToolbarTemplate>
    </Table>
</div>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private Table<Models.Orders>? OrdersTable { get; set; }

    // (2026-08-14) 通过 SelectedRowsChanged 监听勾选变化,
    // 一旦用户勾选 >1 行就 Toast 一次,直到勾选数回到 <=1 才解除"已警告"状态,避免反复刷屏。
    private List<Models.Orders> _selectedRows = new();

    private bool _warnedThisSelection;

    private void OnSelectedRowsChanged(IEnumerable<Models.Orders> rows)
    {
        _selectedRows = rows.ToList();

        if (_selectedRows.Count > 1)
        {
            if (!_warnedThisSelection)
            {
                _warnedThisSelection = true;
                _ = ToastService.Warning("本页面操作仅支持单选:一次只能操作一个订单,请只勾选一行");
            }
        }
        else
        {
            _warnedThisSelection = false;
        }
    }

    private async Task OnToolbarAddDrawingNumberClick()
    {
        var selected = OrdersTable?.SelectedRows;
        if (selected == null)
        {
            await ToastService.Error("表格未就绪,请稍后再试");
            return;
        }

        var items = selected.ToList();
        if (items.Count == 0)
        {
            await ToastService.Warning("请先在表格中勾选一个订单");
            return;
        }
        if (items.Count > 1)
        {
            await ToastService.Warning("一次只能给一个订单添加图号,请只勾选一行");
            return;
        }

        NavigationManager.NavigateTo($"/add-drawing-numbers/{items[0].Id}");
    }

    private async Task OnToolbarViewDrawingNumberClick()
    {
        var selected = OrdersTable?.SelectedRows;
        if (selected == null)
        {
            await ToastService.Error("表格未就绪,请稍后再试");
            return;
        }

        var items = selected.ToList();
        if (items.Count == 0)
        {
            await ToastService.Warning("请先在表格中勾选一个订单");
            return;
        }
        if (items.Count > 1)
        {
            await ToastService.Warning("一次只能查看一个订单的图号,请只勾选一行");
            return;
        }

        NavigationManager.NavigateTo($"/order-drawing-numbers/{items[0].Id}");
    }

    private async Task<QueryData<Models.Orders>> OnQueryAsync(QueryPageOptions options)
    {
        var result = await OrdersService.QueryAsync(options.ToPagedQuery());
        // 预热本页订单的"是否有图号"缓存(由 OrdersService 内部按 drawingType 分组批量查)
        await OrdersService.PreloadHasDrawingNumberCacheAsync(result.Items);
        return result.ToQueryData();
    }

    private Task<Models.Orders> OnAddAsync()
    {
        // 用当前登录用户的姓名预填创建者;未登录时使用空字符串占位,由 SaveAsync 的后续流程处理
        var currentUserName = CurrentUser.GetDisplayName() ?? string.Empty;

        return Task.FromResult(new Models.Orders()
        {
            CreatedTime = DateTime.Now,
            UpdatedTime = DateTime.Now,
            IsDeleted = false,
            IsReactor = false,
            CreatedBy = currentUserName,
            UpdatedBy = currentUserName
        });
    }

    private async Task<bool> OnSaveAsync(Models.Orders order, ItemChangedType changedType)
    {
        var (ok, error) = await OrdersService.SaveAsync(order, changedType.ToDomain());
        if (!ok && !string.IsNullOrEmpty(error))
        {
            await ToastService.Error(error);
        }
        return ok;
    }

    private async Task<bool> OnDeleteAsync(IEnumerable<Models.Orders> orders)
    {
        return await OrdersService.SoftDeleteAsync(orders);
    }

    /// <summary>
    /// 单行查询:供 DisableExtendEditButtonCallback 使用。
    /// 直接读 OrdersService 缓存;缓存未命中时返回 false(允许编辑),
    /// 真实状态在 PreloadHasDrawingNumberCacheAsync 完成后通过 StateHasChanged 刷新。
    /// </summary>
    private bool HasDrawingNumber(Models.Orders item)
    {
        if (item == null) return false;
        return OrdersService.TryGetHasDrawingNumber(item.Id, out var has) && has;
    }
}
