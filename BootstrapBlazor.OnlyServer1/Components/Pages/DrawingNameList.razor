@page "/drawing-names"
@attribute [TabItemOption(Text = "图名列表")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator)]
@using BootstrapBlazor.OnlyServer1.Services
@using BootstrapBlazor.OnlyServer1.Models
@using BootstrapBlazor.OnlyServer1.Services.Identity
@inject DrawingNameService? DrawingNameService
@inject CurrentUserAccessor CurrentUser
@inject Microsoft.Extensions.Logging.ILogger<DrawingNameList> Logger
@inject ToastService ToastService

<PageTitle>图名列表</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex align-items-center mb-3">
        <h3 class="mb-0">图名列表</h3>
        @if (CurrentUser.HasPermission(PermissionCodes.DrawingNameCreate))
        {
            <button class="btn btn-success ms-auto" @onclick="OpenAddCategoryModal">
                <i class="fa-solid fa-folder-plus me-1"></i>
                <span>添加图名类别</span>
            </button>
            <button class="btn btn-primary ms-2" @onclick="OpenAddModal">
                <i class="fa-solid fa-plus me-1"></i>
                <span>添加图名</span>
            </button>
        }
        <button class="btn btn-outline-secondary ms-2" @onclick="LoadDataAsync" disabled="@_isLoading">
            <i class="fa-solid fa-refresh me-1"></i>
            <span>刷新</span>
        </button>
    </div>

    @if (_isLoading) {
        <p class="text-muted">加载中...</p>
    }
    else if (_drawingNames == null || _drawingNames.Count == 0) {
        <div class="alert alert-warning">暂无图名,点击右上角"添加图名"按钮新增。</div>
    }
    else {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>编号</th>
                        <th>图纸名称</th>
                        <th>图名类别</th>
                        <th>创建者</th>
                        <th>创建时间</th>
                        <th>修改者</th>
                        <th>修改时间</th>
                        <th>状态</th>
                        <th style="width: 100px;">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _drawingNames) {
                        <tr class="@(item.IsDeleted ? "table-secondary text-muted text-decoration-line-through" : "")">
                            <td>@item.Id</td>
                            <td>@item.ComponentName</td>
                            <td>@item.Part</td>
                            <td>@item.CreatedBy</td>
                            <td>@item.CreatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@item.UpdatedBy</td>
                            <td>@item.UpdatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @if (item.IsDeleted) {
                                    <span class="badge bg-secondary">已删除</span>
                                } else {
                                    <span class="badge bg-success">可用</span>
                                }
                            </td>
                            <td>
                                @if (!item.IsDeleted && CurrentUser.HasPermission(PermissionCodes.DrawingNameDelete)) {
                                    <button class="btn btn-sm btn-danger" @onclick="() => HandleDelete(item.Id, item.ComponentName)">
                                        <i class="fa-solid fa-trash"></i>
                                        <span class="ms-1">删除</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- 添加图名弹窗 -->
@if (_addModalVisible) {
    <div class="modal d-block" tabindex="-1" role="dialog" style="display: block;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">添加图名</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">图名类别</label>
                        <select class="form-select" @bind="_addModel.Part">
                            <option value="">请选择</option>
                            @foreach (var p in _partOptions) {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">图纸名称</label>
                        <input type="text" class="form-control" @bind="_addModel.ComponentName" maxlength="50" placeholder="例如:高压侧套管" />
                    </div>
                    @if (_addErrorMessage != null) {
                        <div class="alert alert-danger mb-0">@_addErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddModal" disabled="@_addSaving">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="HandleAddConfirm" disabled="@(_addSaving ? true : false)">
                        @if (_addSaving) {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-2">添加中...</span>
                        } else {
                            <span>添加</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<!-- 批量添加图名弹窗(一行一个名称) -->
@if (_addCategoryModalVisible) {
    <div class="modal d-block" tabindex="-1" role="dialog" style="display: block;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">批量添加图名(按图名类别)</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddCategoryModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">图名类别</label>
                        <input type="text" class="form-control" @bind="_addCategoryModel.Part"
                               maxlength="20" placeholder="例如:ESL-05" />
                        <small class="form-text text-muted">新类别名称;与已有类别重名时会被阻止(请用「添加图名」追加)</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">图纸名称(一行一个)</label>
                        <textarea class="form-control font-monospace" rows="10"
                                  @bind="_addCategoryModel.Names"
                                  placeholder="@("高压侧套管" + Environment.NewLine + "低压侧套管" + Environment.NewLine + "铁芯拉板" + Environment.NewLine + "夹件")"></textarea>
                        <small class="form-text text-muted">每行一个名称;空行自动忽略;重复名称会跳过</small>
                    </div>
                    @if (_addCategoryErrorMessage != null) {
                        <div class="alert alert-danger mb-0">@_addCategoryErrorMessage</div>
                    }
                    @if (_addCategorySummary != null) {
                        <div class="alert alert-success mb-0">@_addCategorySummary</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddCategoryModal" disabled="@_addCategorySaving">取消</button>
                    <button type="button" class="btn btn-success" @onclick="HandleAddCategoryConfirm" disabled="@(_addCategorySaving ? true : false)">
                        @if (_addCategorySaving) {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-2">添加中...</span>
                        } else {
                            <span>批量添加</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private List<DrawingNames> _drawingNames = new();
    private bool _isLoading = false;

    private bool _addModalVisible = false;
    private bool _addSaving = false;
    private string? _addErrorMessage = null;
    private DrawingNameAddModel _addModel = new();

    // 批量添加(一行一个名称)
    private bool _addCategoryModalVisible = false;
    private bool _addCategorySaving = false;
    private string? _addCategoryErrorMessage = null;
    private string? _addCategorySummary = null;
    private DrawingNameCategoryAddModel _addCategoryModel = new();

    private class DrawingNameCategoryAddModel
    {
        public string Part { get; set; } = "";
        public string Names { get; set; } = "";
    }

    private List<string> _partOptions = new();

    /// <summary>
    /// 预置 Part 类别(库里还没数据时作为兜底,保证下拉有内容)
    /// 数据库里出现过任意 Part 后,这个列表会跟 DB 同步,自动包含新类别
    /// </summary>
    private static readonly List<string> _defaultPartOptions = new() {
        "ESL-01",
        "ESL-02",
        "ESL-03",
        "ESL-Core"
    };

    // (2026-07-08 Review #L-9) AddModel 已提取到 Models/ViewModels/DrawingNameAddModel.cs

    protected override async Task OnInitializedAsync() {
        await LoadDataAsync();
        await LoadPartOptionsAsync();
    }

    /// <summary>
    /// 从 DB 加载 Part 类别下拉选项。库里有就用库里的;库里没数据时回退到 _defaultPartOptions 兜底。
    /// </summary>
    private async Task LoadPartOptionsAsync() {
        if (DrawingNameService == null) {
            _partOptions = new List<string>(_defaultPartOptions);
            return;
        }

        try {
            var parts = await DrawingNameService.GetDistinctPartsAsync();
            _partOptions = parts.Count > 0 ? parts : new List<string>(_defaultPartOptions);
        }
        catch (Exception ex) {
            Logger.LogError(ex, "LoadPartOptionsAsync failed, fallback to defaults");
            _partOptions = new List<string>(_defaultPartOptions);
        }
    }

    private async Task LoadDataAsync() {
        _isLoading = true;
        try {
            if (DrawingNameService == null) {
                Logger.LogWarning("DrawingNameService is null");
                return;
            }
            _drawingNames = await DrawingNameService.GetAllAsync(includeDeleted: true);
        }
        catch (Exception ex) {
            Logger.LogError(ex, "LoadDataAsync failed");
            await ToastService.Error("加载图名列表失败");
        }
        finally {
            _isLoading = false;
        }
    }

    private void OpenAddModal() {
        _addModel = new DrawingNameAddModel();
        _addErrorMessage = null;
        _addModalVisible = true;
    }

    private void CloseAddModal() {
        _addModalVisible = false;
        _addErrorMessage = null;
    }

    private async Task HandleAddConfirm() {
        if (DrawingNameService == null) {
            await ToastService.Error("服务不可用");
            return;
        }

        if (string.IsNullOrWhiteSpace(_addModel.ComponentName)) {
            _addErrorMessage = "图纸名称不能为空";
            return;
        }

        if (_addModel.ComponentName.Trim().Length > 50) {
            _addErrorMessage = "图纸名称不能超过 50 个字符";
            return;
        }

        if (string.IsNullOrWhiteSpace(_addModel.Part)) {
            _addErrorMessage = "请选择图名类别";
            return;
        }

        _addSaving = true;
        _addErrorMessage = null;

        try {
            var result = await DrawingNameService.AddDrawingNameAsync(_addModel.ComponentName, _addModel.Part);

            if (result > 0) {
                await ToastService.Success($"图名「{_addModel.ComponentName}」添加成功");
                CloseAddModal();
                await LoadDataAsync();
                // 新 Part 入库后立刻刷新下拉,避免刷新页面才能选
                await LoadPartOptionsAsync();
            }
            else {
                _addErrorMessage = "添加失败,请重试";
            }
        }
        catch (Exception ex) {
            Logger.LogError(ex, "HandleAddConfirm failed");
            _addErrorMessage = "添加图名时发生错误";
        }
        finally {
            _addSaving = false;
        }
    }

    private async Task HandleDelete(int id, string name) {
        if (DrawingNameService == null) {
            await ToastService.Error("服务不可用");
            return;
        }

        // 浏览器原生确认(简单可靠,不引入新依赖)
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"确定要删除图名「{name}」吗?(软删除)");
        if (!confirmed) {
            return;
        }

        try {
            var ok = await DrawingNameService.DeleteDrawingNameAsync(id);
            if (ok) {
                await ToastService.Success($"图名「{name}」已删除");
                await LoadDataAsync();
            }
            else {
                await ToastService.Error("删除失败");
            }
        }
        catch (Exception ex) {
            Logger.LogError(ex, "HandleDelete failed: {Id}", id);
            await ToastService.Error("删除图名时发生错误");
        }
    }

    // ===== 批量添加(图名类别 + 多行名称) =====

    private void OpenAddCategoryModal() {
        _addCategoryModel = new DrawingNameCategoryAddModel();
        _addCategoryErrorMessage = null;
        _addCategorySummary = null;
        _addCategoryModalVisible = true;
    }

    private void CloseAddCategoryModal() {
        _addCategoryModalVisible = false;
        _addCategoryErrorMessage = null;
        _addCategorySummary = null;
    }

    private async Task HandleAddCategoryConfirm() {
        if (DrawingNameService == null) {
            _addCategoryErrorMessage = "服务不可用";
            return;
        }

        if (string.IsNullOrWhiteSpace(_addCategoryModel.Part)) {
            _addCategoryErrorMessage = "请输入图名类别(新类别名)";
            return;
        }

        // (2026-08-07) 严格模式:禁止重名 ——
        //   「添加图名类别」语义是"新建类别并附带图名",
        //   已存在的类别请走「添加图名」按钮(单条追加)
        if (_partOptions.Any(p => string.Equals(p, _addCategoryModel.Part.Trim(), StringComparison.OrdinalIgnoreCase))) {
            _addCategoryErrorMessage = $"图名类别「{_addCategoryModel.Part.Trim()}」已存在,请改用「添加图名」按钮往该类别追加图纸名称";
            return;
        }

        if (string.IsNullOrWhiteSpace(_addCategoryModel.Names)) {
            _addCategoryErrorMessage = "请输入至少一个图纸名称";
            return;
        }

        // 拆行 + trim + 去空 + 去重(保留原顺序)
        var names = _addCategoryModel.Names
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(n => n.Trim())
            .Where(n => !string.IsNullOrEmpty(n))
            .Distinct()
            .ToList();

        if (names.Count == 0) {
            _addCategoryErrorMessage = "没有有效的图纸名称(请检查空行/空白)";
            return;
        }

        if (names.Count > 100) {
            _addCategoryErrorMessage = $"单次最多添加 100 个,当前 {names.Count} 个,请分批";
            return;
        }

        _addCategorySaving = true;
        _addCategoryErrorMessage = null;
        _addCategorySummary = null;

        int okCount = 0;
        var failedNames = new List<string>();

        try {
            foreach (var name in names) {
                if (name.Length > 50) {
                    failedNames.Add($"{name}(超 50 字符)");
                    continue;
                }
                try {
                    var result = await DrawingNameService.AddDrawingNameAsync(name, _addCategoryModel.Part);
                    if (result > 0) okCount++;
                    else failedNames.Add($"{name}(数据库返回 0)");
                }
                catch (Exception ex) {
                    Logger.LogWarning(ex, "批量添加单条失败: {Name}", name);
                    failedNames.Add($"{name}(异常)");
                }
            }

            // 全部失败 → 留在弹窗,提示完整错误
            if (okCount == 0 && failedNames.Count > 0) {
                _addCategoryErrorMessage = $"全部 {failedNames.Count} 条失败: " +
                    string.Join(", ", failedNames.Take(5)) +
                    (failedNames.Count > 5 ? $" 等 {failedNames.Count} 个" : "");
                return;
            }

            // 部分成功 / 全部成功 → 关闭弹窗,弹 Toast
            CloseAddCategoryModal();
            await LoadDataAsync();
            await LoadPartOptionsAsync();

            if (failedNames.Count == 0) {
                await ToastService.Success($"成功添加 {okCount} 条图名");
            }
            else {
                await ToastService.Show(new ToastOption
                {
                    Category = ToastCategory.Warning,
                    Content = $"成功 {okCount} 条,失败 {failedNames.Count} 条: " +
                        string.Join(", ", failedNames.Take(3)) +
                        (failedNames.Count > 3 ? "..." : "")
                });
            }
        }
        finally {
            _addCategorySaving = false;
        }
    }
}