@page "/drawing-names"
@attribute [TabItemOption(Text = "图名列表")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin,Operator")]
@using BootstrapBlazor.OnlyServer1.Services
@using BootstrapBlazor.OnlyServer1.Models
@using BootstrapBlazor.OnlyServer1.Services.Identity
@inject DrawingNumberService? DrawingNumberService
@inject CurrentUserAccessor CurrentUser
@inject Microsoft.Extensions.Logging.ILogger<DrawingNameList> Logger
@inject BootstrapBlazor.Components.ToastService ToastService

<PageTitle>图名列表</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex align-items-center mb-3">
        <h3 class="mb-0">图名列表</h3>
        @if (CurrentUser.HasPermission("DrawingName.Create"))
        {
            <button class="btn btn-primary ms-auto" @onclick="OpenAddModal">
                <i class="fa-solid fa-plus me-1"></i>
                <span>添加图名</span>
            </button>
        }
        <button class="btn btn-outline-secondary ms-2" @onclick="LoadDataAsync" disabled="@_isLoading">
            <i class="fa-solid fa-refresh me-1"></i>
            <span>刷新</span>
        </button>
    </div>

    @if (_isLoading) {
        <p class="text-muted">加载中...</p>
    }
    else if (_drawingNames == null || _drawingNames.Count == 0) {
        <div class="alert alert-warning">暂无图名,点击右上角"添加图名"按钮新增。</div>
    }
    else {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>编号</th>
                        <th>图纸名称</th>
                        <th>图名类别</th>
                        <th>创建者</th>
                        <th>创建时间</th>
                        <th>修改者</th>
                        <th>修改时间</th>
                        <th>状态</th>
                        <th style="width: 100px;">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _drawingNames) {
                        <tr class="@(item.Isdelete ? "table-secondary text-muted text-decoration-line-through" : "")">
                            <td>@item.Id</td>
                            <td>@item.ComponentName</td>
                            <td>@item.Part</td>
                            <td>@item.CreatedBy</td>
                            <td>@item.CreatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@item.UpdatedBy</td>
                            <td>@item.UpdatedTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @if (item.Isdelete) {
                                    <span class="badge bg-secondary">已删除</span>
                                } else {
                                    <span class="badge bg-success">可用</span>
                                }
                            </td>
                            <td>
                                @if (!item.Isdelete && CurrentUser.HasPermission("DrawingName.Delete")) {
                                    <button class="btn btn-sm btn-danger" @onclick="() => HandleDelete(item.Id, item.ComponentName)">
                                        <i class="fa-solid fa-trash"></i>
                                        <span class="ms-1">删除</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- 添加图名弹窗 -->
@if (_addModalVisible) {
    <div class="modal d-block" tabindex="-1" role="dialog" style="display: block;">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">添加图名</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddModal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">图纸名称</label>
                        <input type="text" class="form-control" @bind="_addModel.ComponentName" maxlength="50" placeholder="例如:高压侧套管" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">图名类别</label>
                        <select class="form-select" @bind="_addModel.Part">
                            <option value="">请选择</option>
                            @foreach (var p in _partOptions) {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </div>
                    @if (_addErrorMessage != null) {
                        <div class="alert alert-danger mb-0">@_addErrorMessage</div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddModal" disabled="@_addSaving">取消</button>
                    <button type="button" class="btn btn-primary" @onclick="HandleAddConfirm" disabled="@(_addSaving ? true : false)">
                        @if (_addSaving) {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span class="ms-2">添加中...</span>
                        } else {
                            <span>添加</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;

    private List<DrawingNames> _drawingNames = new();
    private bool _isLoading = false;

    private bool _addModalVisible = false;
    private bool _addSaving = false;
    private string? _addErrorMessage = null;
    private AddModel _addModel = new();

    private List<string> _partOptions = new();

    /// <summary>
    /// 预置 Part 类别(库里还没数据时作为兜底,保证下拉有内容)
    /// 数据库里出现过任意 Part 后,这个列表会跟 DB 同步,自动包含新类别
    /// </summary>
    private static readonly List<string> _defaultPartOptions = new() {
        "ESL-01",
        "ESL-02",
        "ESL-03",
        "ESL-Core"
    };

    public class AddModel {
        public string ComponentName { get; set; } = string.Empty;
        public string Part { get; set; } = string.Empty;
    }

    protected override async Task OnInitializedAsync() {
        await LoadDataAsync();
        await LoadPartOptionsAsync();
    }

    /// <summary>
    /// 从 DB 加载 Part 类别下拉选项。库里有就用库里的;库里没数据时回退到 _defaultPartOptions 兜底。
    /// </summary>
    private async Task LoadPartOptionsAsync() {
        if (DrawingNumberService == null) {
            _partOptions = new List<string>(_defaultPartOptions);
            return;
        }

        try {
            var parts = await DrawingNumberService.GetDistinctPartsAsync();
            _partOptions = parts.Count > 0 ? parts : new List<string>(_defaultPartOptions);
        }
        catch (Exception ex) {
            Logger.LogError(ex, "LoadPartOptionsAsync failed, fallback to defaults");
            _partOptions = new List<string>(_defaultPartOptions);
        }
    }

    private async Task LoadDataAsync() {
        _isLoading = true;
        try {
            if (DrawingNumberService == null) {
                Logger.LogWarning("DrawingNumberService is null");
                return;
            }
            _drawingNames = await DrawingNumberService.GetAllDrawingNamesIncludingDeletedAsync();
        }
        catch (Exception ex) {
            Logger.LogError(ex, "LoadDataAsync failed");
            await ToastService.Error("加载图名列表失败");
        }
        finally {
            _isLoading = false;
        }
    }

    private void OpenAddModal() {
        _addModel = new AddModel();
        _addErrorMessage = null;
        _addModalVisible = true;
    }

    private void CloseAddModal() {
        _addModalVisible = false;
        _addErrorMessage = null;
    }

    private async Task HandleAddConfirm() {
        if (DrawingNumberService == null) {
            await ToastService.Error("服务不可用");
            return;
        }

        if (string.IsNullOrWhiteSpace(_addModel.ComponentName)) {
            _addErrorMessage = "图纸名称不能为空";
            return;
        }

        if (_addModel.ComponentName.Trim().Length > 50) {
            _addErrorMessage = "图纸名称不能超过 50 个字符";
            return;
        }

        if (string.IsNullOrWhiteSpace(_addModel.Part)) {
            _addErrorMessage = "请选择图名类别";
            return;
        }

        _addSaving = true;
        _addErrorMessage = null;

        try {
            var result = await DrawingNumberService.AddDrawingNameAsync(_addModel.ComponentName, _addModel.Part);

            if (result > 0) {
                await ToastService.Success($"图名「{_addModel.ComponentName}」添加成功");
                CloseAddModal();
                await LoadDataAsync();
                // 新 Part 入库后立刻刷新下拉,避免刷新页面才能选
                await LoadPartOptionsAsync();
            }
            else {
                _addErrorMessage = "添加失败,请重试";
            }
        }
        catch (Exception ex) {
            Logger.LogError(ex, "HandleAddConfirm failed");
            _addErrorMessage = "添加图名时发生错误";
        }
        finally {
            _addSaving = false;
        }
    }

    private async Task HandleDelete(int id, string name) {
        if (DrawingNumberService == null) {
            await ToastService.Error("服务不可用");
            return;
        }

        // 浏览器原生确认(简单可靠,不引入新依赖)
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"确定要删除图名「{name}」吗?(软删除)");
        if (!confirmed) {
            return;
        }

        try {
            var ok = await DrawingNumberService.DeleteDrawingNameAsync(id);
            if (ok) {
                await ToastService.Success($"图名「{name}」已删除");
                await LoadDataAsync();
            }
            else {
                await ToastService.Error("删除失败");
            }
        }
        catch (Exception ex) {
            Logger.LogError(ex, "HandleDelete failed: {Id}", id);
            await ToastService.Error("删除图名时发生错误");
        }
    }
}