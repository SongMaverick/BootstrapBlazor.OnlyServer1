@page "/init-drawing-names"
@attribute [TabItemOption(Text = "初始化图号名称")]
@inject BootstrapBlazor.OnlyServer1.Data.DrawingNamesDataInitializer? Initializer

<PageTitle>初始化图号名称</PageTitle>

<div class="container mt-4">
    <h3>初始化图号名称数据</h3>
    <p>点击下方按钮初始化DrawingNames表的数据</p>
    <button class="btn btn-primary" @onclick="InitializeAsync" disabled="@isLoading">
        @if (isLoading) {
            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            <span class="ml-2">初始化中...</span>
        } else {
            <span>初始化</span>
        }
    </button>
</div>

@code {
    private bool isLoading = false;

    private async Task InitializeAsync() {
        isLoading = true;
        try {
            if (Initializer != null) {
                await Initializer.InitializeDrawingNamesAsync();
            }
        } finally {
            isLoading = false;
        }
    }
}
