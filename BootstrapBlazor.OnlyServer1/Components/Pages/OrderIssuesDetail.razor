@page "/order-issues/{OrderId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Viewer)]
@using BootstrapBlazor.OnlyServer1.Models
@using BootstrapBlazor.OnlyServer1.Models.Identity
@using BootstrapBlazor.OnlyServer1.Models.ViewModels
@using PermissionCodes = BootstrapBlazor.OnlyServer1.Models.Identity.PermissionCodes
@inject BootstrapBlazor.OnlyServer1.Services.OrdersService OrdersService
@inject BootstrapBlazor.OnlyServer1.Services.OrderIssueService OrderIssueService
@inject BootstrapBlazor.OnlyServer1.Services.Identity.CurrentUserAccessor CurrentUser
@inject Microsoft.Extensions.Logging.ILogger<OrderIssuesDetail> Logger
@inject ToastService ToastService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>问题汇总 — 订单 #@(_order?.OrderNumber.ToString() ?? OrderId.ToString())</PageTitle>

<div class="page-order-issues-detail">
    @* 返回按钮(2026-08-27 从订单管理页拆分出来的独立问题汇总页) *@
    <div class="mb-3">
        <Button Color="Color.Secondary" Size="Size.Small" Icon="fa-solid fa-arrow-left"
                OnClick="@(() => Nav.NavigateTo("/order-management"))">
            返回订单管理
        </Button>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><Spinner Color="Color.Primary" /></div>
    }
    else if (_order == null)
    {
        <div class="alert alert-warning" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>
            订单 #@OrderId 不存在或已被删除。
            <a href="/order-management" class="alert-link ms-2">回到订单管理</a>
        </div>
    }
    else
    {
        @* ===== 订单摘要 ===== *@
        <Card IsShadow="true" class="mb-3">
            <BodyTemplate>
                <div class="d-flex flex-wrap align-items-center" style="gap: 1.5rem;">
                    <div>
                        <div class="text-muted small">订单号</div>
                        <div class="fs-4 fw-bold">@_order.OrderNumber</div>
                    </div>
                    <div>
                        <div class="text-muted small">容量</div>
                        <div class="fs-5">@_order.Power kVA</div>
                    </div>
                    <div>
                        <div class="text-muted small">额定电压</div>
                        <div class="fs-5">@_order.RatedVoltage kV</div>
                    </div>
                    <div>
                        <div class="text-muted small">类型</div>
                        @if (_order.IsReactor)
                        {
                            <Badge Color="Color.None" IsPill="true" class="badge-reactor">
                                <i class="fa-solid fa-bolt"></i>
                                <span class="ms-1">电抗器</span>
                            </Badge>
                        }
                        else
                        {
                            <Badge Color="Color.None" IsPill="true" class="badge-transformer">
                                <i class="fa-solid fa-battery-full"></i>
                                <span class="ms-1">变压器</span>
                            </Badge>
                        }
                    </div>
                    <div class="ms-auto text-end text-muted small">
                        <div>创建者:@_order.CreatedBy</div>
                        <div>创建时间:@_order.CreatedTime.ToString("yyyy-MM-dd HH:mm")</div>
                    </div>
                </div>
            </BodyTemplate>
        </Card>

        @* ===== 问题汇总(全量 Table) ===== *@
        <Card IsShadow="true">
            <HeaderTemplate>
                <div class="d-flex align-items-center justify-content-between" style="gap: 1rem;">
                    <span><i class="fa-solid fa-circle-exclamation me-1"></i>问题汇总(共 @(_issues?.Count ?? 0) 条)</span>
                    <div class="d-flex align-items-center" style="gap: 0.5rem; flex-wrap: wrap; justify-content: flex-end;">
                        @if (_issues == null)
                        {
                            <Badge Color="Color.Secondary">加载中</Badge>
                        }
                        else
                        {
                            var openCount = _issues.Count(i => i.Status == IssueStatus.Open);
                            var closeCount = _issues.Count(i => i.Status == IssueStatus.Close);
                            <Badge Color="Color.Danger" class="me-1">@openCount open</Badge>
                            <Badge Color="Color.Success" class="me-1">@closeCount close</Badge>
                        }
                        @if (CanAddIssue)
                        {
                            <Button Color="Color.Primary" Icon="fa-solid fa-plus" Size="Size.Small"
                                    OnClick="ShowAddIssueDialog">
                                新建问题
                            </Button>
                        }
                        @* (2026-08-27) 导出 PDF:走最小 API 端点,forceLoad: true 触发浏览器下载 *@
                        <Button Color="Color.Info" Icon="fa-solid fa-file-pdf" Size="Size.Small"
                                OnClick="@(() => Nav.NavigateTo($"/api/orders/{OrderId}/issues-pdf", forceLoad: true))">
                            导出 PDF
                        </Button>
                        @if (CanSolveIssue)
                        {
                            <Button Color="Color.Success" Icon="fa-solid fa-check" Size="Size.Small"
                                    OnClick="ShowResolutionDialogFromSelection">
                                填写解决方法
                            </Button>
                        }
                        @if (!HasOneIssueSelected && _issueSelected.Count > 1)
                        {
                            <span class="text-warning small align-self-center">
                                <i class="fa-solid fa-triangle-exclamation me-1"></i>一次只能操作一个问题,请只勾选一行
                            </span>
                        }
                    </div>
                </div>
            </HeaderTemplate>
            <BodyTemplate>
                @if (_issues == null)
                {
                    <div class="text-center py-3"><Spinner Color="Color.Primary" /></div>
                }
                else
                {
                    <Table TItem="OrderIssues"
                           @ref="_issuesTable"
                           @key="_issuesReloadCounter"
                           IsPagination="true"
                           PageItemsSource="@IssuesPageItemsSource"
                           RenderMode="TableRenderMode.Table"
                           IsFixedHeader="true"
                           IsStriped="true"
                           IsBordered="true"
                           OnQueryAsync="OnIssuesQueryAsync"
                           ShowSearch="false"
                           ShowToolbar="false"
                           ShowAddButton="false"
                           ShowEditButton="false"
                           ShowDeleteButton="false"
                           ShowExtendButtons="false"
                           ShowSkeleton="true"
                           IsMultipleSelect="false"
                           ClickToSelect="true"
                           SelectedRows="_issueSelected"
                           SelectedRowsChanged="OnIssueSelectedRowsChanged"
                           Height="600">
                        <TableColumns>
                            <TableColumn @bind-Field="@context.Id" Text="Id" Width="60" Align="Alignment.Center" Readonly="true" />
                            <TableColumn @bind-Field="@context.Content" Text="问题描述">
                                <Template Context="row">
                                    <div style="white-space: pre-wrap; max-width: 600px; max-height: 100px; overflow-y: auto; word-break: break-word;">@row.Row.Content</div>
                                </Template>
                            </TableColumn>
                            <TableColumn @bind-Field="@context.Resolution" Text="解决方法" Width="240">
                                <Template Context="row">
                                    @if (string.IsNullOrWhiteSpace(row.Row.Resolution))
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                    else
                                    {
                                        <div style="white-space: pre-wrap; max-height: 60px; overflow-y: auto; word-break: break-word;">@row.Row.Resolution</div>
                                    }
                                </Template>
                            </TableColumn>
                            <TableColumn @bind-Field="@context.Status" Text="状态" Width="120" Align="Alignment.Center">
                                <Template Context="row">
                                    <select class="@GetIssueStatusClass(row.Row.Status)"
                                            style="min-width: 90px; font-weight: 600;"
                                            value="@row.Row.Status"
                                            disabled="@(row.Row.Status == IssueStatus.Close || !CanEditIssueStatus)"
                                            @onchange="@(async (ChangeEventArgs e) => await OnIssueStatusChanged(row.Row, e.Value?.ToString() ?? ""))">
                                        @foreach (var item in _issueStatusItems)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </Template>
                            </TableColumn>
                            <TableColumn @bind-Field="@context.CreatedBy" Text="创建人" Width="100" Align="Alignment.Center" Readonly="true" />
                            <TableColumn @bind-Field="@context.CreatedTime" Text="创建时间" Width="140" Align="Alignment.Center" Readonly="true">
                                <Template Context="row">@row.Row.CreatedTime.ToString("yyyy-MM-dd HH:mm")</Template>
                            </TableColumn>
                            <TableColumn @bind-Field="@context.ClosedBy" Text="关闭人" Width="100" Align="Alignment.Center" Readonly="true">
                                <Template Context="row">@(row.Row.ClosedBy ?? "—")</Template>
                            </TableColumn>
                            <TableColumn @bind-Field="@context.ClosedTime" Text="关闭时间" Width="140" Align="Alignment.Center" Readonly="true">
                                <Template Context="row">@(row.Row.ClosedTime?.ToString("yyyy-MM-dd HH:mm") ?? "—")</Template>
                            </TableColumn>
                        </TableColumns>
                    </Table>
                }
            </BodyTemplate>
        </Card>

        @* ===== 新建问题 Modal ===== *@
        <Modal @ref="_addIssueModal" IsBackdrop="true" ShowCloseButton="true">
            <ModalDialog Title="@($"新建问题 — 订单 #{_order.OrderNumber}")" Size="Size.Large">
                <BodyTemplate>
                    <div class="mb-3">
                        <label class="form-label">问题描述(支持长文本,最多 8000 字符)</label>
                        <textarea class="form-control" rows="8" maxlength="8000"
                                  @bind="_newIssueContent"
                                  placeholder="详细描述在此订单遇到的问题..."></textarea>
                        <small class="text-muted">当前 @(_newIssueContent?.Length ?? 0) / 8000 字符</small>
                    </div>
                </BodyTemplate>
                <FooterTemplate>
                    <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveNewIssue" IsDisabled="_savingIssue">
                        @(_savingIssue ? "保存中..." : "保存")
                    </Button>
                    <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseAddIssueDialog">取消</Button>
                </FooterTemplate>
            </ModalDialog>
        </Modal>

        @* ===== 填写解决方法 Modal ===== *@
        <Modal @ref="_resolutionModal" IsBackdrop="true" ShowCloseButton="true">
            <ModalDialog Title="@($"填写解决方法 — 问题 #{_currentIssueForResolution?.Id}")" Size="Size.Large">
                <BodyTemplate>
                    @if (_currentIssueForResolution != null)
                    {
                        <div class="mb-3">
                            <label class="form-label text-secondary">原问题</label>
                            <div style="white-space: pre-wrap; max-height: 160px; overflow-y: auto; background: #f8f9fa; padding: 8px 12px; border-radius: 4px; font-size: 0.95em;">
                                @_currentIssueForResolution.Content
                            </div>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">解决方法 <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="6" maxlength="8000"
                                  @bind="_newResolution"
                                  placeholder="详细描述解决方法(close 时会被校验)..."></textarea>
                        <small class="text-muted">当前 @(_newResolution?.Length ?? 0) / 8000 字符</small>
                    </div>
                </BodyTemplate>
                <FooterTemplate>
                    <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveResolution" IsDisabled="_savingResolution">
                        @(_savingResolution ? "保存中..." : "保存")
                    </Button>
                    <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseResolutionModal">取消</Button>
                </FooterTemplate>
            </ModalDialog>
        </Modal>
    }
</div>

@code {
    [Parameter] public int OrderId { get; set; }

    // (2026-08-27) 同命名空间里有 Orders.razor 页面生成的 class 会优先解析,这里必须显式 Models.Orders
    private Models.Orders? _order;
    private List<OrderIssues>? _issues;
    private List<OrderIssues> _issueSelected = new();

    private bool _loading = true;
    private bool _savingIssue;
    private bool _savingResolution;
    private string _newIssueContent = "";
    private string _newResolution = "";
    private OrderIssues? _currentIssueForResolution;
    private BootstrapBlazor.Components.Modal _addIssueModal = default!;
    private BootstrapBlazor.Components.Modal _resolutionModal = default!;
    private BootstrapBlazor.Components.Table<OrderIssues>? _issuesTable;
    private int _issuesReloadCounter;

    private static readonly List<SelectedItem> _issueStatusItems = new()
    {
        new SelectedItem(IssueStatus.Open, "open"),
        new SelectedItem(IssueStatus.Close, "close"),
    };

    // 单页页用,默认 10 / 20 / 50(主从页里默认 5 / 10 / 20 — 这里给独立页更多选项)
    private static IEnumerable<int> IssuesPageItemsSource => new int[] { 10, 20, 50 };

    private bool CanEditIssueStatus => CurrentUser.HasPermission(PermissionCodes.OrderIssueEditStatus);
    private bool CanAddIssue => CurrentUser.HasPermission(PermissionCodes.OrderIssueAdd);
    private bool HasOneIssueSelected => _issueSelected.Count == 1;
    private bool CanSolveIssue => HasOneIssueSelected && CanEditIssueStatus;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _loading = true;
        _order = null;
        _issues = null;
        try
        {
            var orderTask = OrdersService.FindByIdAsync(OrderId);
            var issuesTask = OrderIssueService.QueryByOrderIdAsync(OrderId,
                new PagedQuery { PageIndex = 1, PageItems = 1000 });
            await Task.WhenAll(orderTask, issuesTask);
            _order = orderTask.Result;
            _issues = issuesTask.Result.Items ?? new();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "OrderIssuesDetail.LoadAllAsync failed for orderId={OrderId}", OrderId);
            _issues ??= new();
        }
        finally
        {
            _loading = false;
        }
    }

    // ===== Table =====

    private async Task<QueryData<OrderIssues>> OnIssuesQueryAsync(QueryPageOptions options)
    {
        if (_issues == null)
        {
            return new QueryData<OrderIssues>
            {
                Items = new List<OrderIssues>(),
                TotalCount = 0,
            };
        }
        // 一次性拉全量,本地分页(同 OrderManagement.razor 模式)
        var all = _issues;
        var page = all.Skip((options.PageIndex - 1) * options.PageItems).Take(options.PageItems).ToList();
        return await Task.FromResult(new QueryData<OrderIssues>
        {
            Items = page,
            TotalCount = all.Count,
            IsFiltered = false,
            IsSorted = false,
            IsSearch = false,
        });
    }

    private void OnIssueSelectedRowsChanged(IEnumerable<OrderIssues> rows)
    {
        _issueSelected = rows.ToList();
    }

    // ===== 新建问题 =====

    private async Task ShowAddIssueDialog()
    {
        if (!CanAddIssue) return;
        _newIssueContent = "";
        await _addIssueModal.Show();
    }

    private async Task CloseAddIssueDialog()
    {
        await _addIssueModal.Close();
    }

    private async Task SaveNewIssue()
    {
        if (_savingIssue || _order == null) return;
        if (string.IsNullOrWhiteSpace(_newIssueContent))
        {
            await ShowToast("问题描述不能为空", ToastCategory.Error);
            return;
        }

        _savingIssue = true;
        try
        {
            var (ok, error) = await OrderIssueService.CreateAsync(_order.Id, _newIssueContent);
            if (!ok)
            {
                await ShowToast(error ?? "保存失败", ToastCategory.Error);
                return;
            }
            await ShowToast("问题已添加", ToastCategory.Success);
            await _addIssueModal.Close();
            _newIssueContent = "";
            await ReloadIssuesAsync();
        }
        finally
        {
            _savingIssue = false;
        }
    }

    // ===== 填写解决方法 =====

    private async Task ShowResolutionDialogFromSelection()
    {
        if (!HasOneIssueSelected) return;
        if (!CanEditIssueStatus)
        {
            await ShowToast("无 OrderIssue.EditStatus 权限", ToastCategory.Warning);
            return;
        }
        _currentIssueForResolution = _issueSelected[0];
        _newResolution = _currentIssueForResolution.Resolution ?? "";
        await _resolutionModal.Show();
    }

    private async Task CloseResolutionModal()
    {
        await _resolutionModal.Close();
    }

    private async Task SaveResolution()
    {
        if (_currentIssueForResolution == null || _savingResolution) return;
        if (string.IsNullOrWhiteSpace(_newResolution))
        {
            await ShowToast("解决方法不能为空", ToastCategory.Error);
            return;
        }

        _savingResolution = true;
        try
        {
            var (ok, error) = await OrderIssueService.SaveResolutionAsync(
                _currentIssueForResolution.Id, _newResolution);
            if (!ok)
            {
                await ShowToast(error ?? "保存失败", ToastCategory.Error);
                return;
            }
            await ShowToast("解决方法已保存", ToastCategory.Success);
            await _resolutionModal.Close();
            await ReloadIssuesAsync();
        }
        finally
        {
            _savingResolution = false;
        }
    }

    // ===== 状态切换 =====

    /// <summary>
    /// 行内状态变更:open → close。close 前要求 Resolution 非空 + JS confirm 二次确认。
    /// (从 OrderIssueList / OrderManagement.razor 移植)
    /// </summary>
    private async Task OnIssueStatusChanged(OrderIssues issue, string newStatus)
    {
        if (string.IsNullOrEmpty(newStatus) || newStatus == issue.Status) return;

        if (issue.Status == IssueStatus.Close)
        {
            await ShowToast("已关闭的问题不能再修改状态", ToastCategory.Warning);
            return;
        }
        if (newStatus != IssueStatus.Close)
        {
            await ShowToast("只能从 open 切换到 close", ToastCategory.Warning);
            return;
        }
        if (string.IsNullOrWhiteSpace(issue.Resolution))
        {
            await ShowToast("请先填写解决方法(工具栏「填写解决方法」按钮)", ToastCategory.Warning);
            return;
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "确认关闭此问题?\n\n关闭后将无法再修改状态,关闭人 / 关闭时间会被记录。");
        if (!confirmed) return;

        var (ok, error) = await OrderIssueService.UpdateStatusAsync(issue.Id, newStatus);
        if (!ok)
        {
            await ShowToast(error ?? "关闭失败", ToastCategory.Error);
            return;
        }

        await ShowToast("已关闭", ToastCategory.Success);
        await ReloadIssuesAsync();
    }

    // ===== 刷新 =====

    private async Task ReloadIssuesAsync()
    {
        if (_order == null) return;
        var result = await OrderIssueService.QueryByOrderIdAsync(
            _order.Id, new PagedQuery { PageIndex = 1, PageItems = 1000 });
        _issues = result.Items ?? new();
        _issueSelected = new();

        // 三重保险(Table 立即刷新,同 OrderManagement.razor)
        if (_issuesTable != null)
        {
            await _issuesTable.QueryAsync();
        }
        _issuesReloadCounter++;
        StateHasChanged();
    }

    private static string GetIssueStatusClass(string status) => status switch
    {
        IssueStatus.Open => "form-select form-select-sm text-danger bg-danger bg-opacity-10 border-danger",
        IssueStatus.Close => "form-select form-select-sm text-success bg-success bg-opacity-10 border-success",
        _ => "form-select form-select-sm",
    };

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2000
        });
    }
}