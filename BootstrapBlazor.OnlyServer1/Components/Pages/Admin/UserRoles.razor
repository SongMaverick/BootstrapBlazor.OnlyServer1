@page "/user-roles"
@attribute [TabItemOption(Text = "用户角色")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = RoleNames.Admin)]
@inject RolesService RolesService
@inject UsersService UsersService
@inject ToastService ToastService

<PageTitle>用户角色</PageTitle>

<div class="page-user-roles">
    <h1>用户角色</h1>

    <div class="mb-3 d-flex align-items-center">
        <span class="me-2">模式:</span>
        <label class="form-check-inline">
            <input type="radio" name="mode" value="single" checked="@(_mode == "single")"
                   @onchange="@(e => _mode = "single")" /> 单选模式
        </label>
        <label class="form-check-inline">
            <input type="radio" name="mode" value="multi" checked="@(_mode == "multi")"
                   @onchange="@(e => _mode = "multi")" /> 多选模式
        </label>
        <span class="ms-4 text-muted small">
            @if (_mode == "single")
            {
                <span>单选模式:每行下拉设置该用户的主角色</span>
            }
            else
            {
                <span>多选模式:勾选多行后,顶部"批量设置角色"生效</span>
            }
        </span>
    </div>

    @if (_mode == "multi")
    {
        <div class="mb-3 d-flex align-items-center" style="background: #f8f9fa; padding: 12px; border-radius: 6px;">
            <span class="me-2">批量设置角色:</span>
            <Select Items="_roleItems" TItem="SelectedItem" TItemValue="int?"
                    @bind-Value="_batchRoleId" ShowSearch="true" PlaceHolder="选择一个角色" Style="width: 240px;" />
            <Button Color="Color.Primary" Icon="fa-solid fa-check" Class="ms-2"
                    OnClick="ApplyBatchAsync" IsDisabled="@(_selectedUserIds.Count == 0 || _batchRoleId == null)">
                应用到 @_selectedUserIds.Count 名用户
            </Button>
            <Button Color="Color.Warning" Icon="fa-solid fa-xmark" Class="ms-2"
                    OnClick="RemoveBatchAsync" IsDisabled="@(_selectedUserIds.Count == 0 || _batchRoleId == null)">
                从选中用户移除
            </Button>
            <span class="ms-3 text-muted small">已选 @_selectedUserIds.Count 人</span>
        </div>
    }

    <Table TItem="UserWithRolesViewModel"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           RenderMode="TableRenderMode.Table"
           IsFixedHeader="false"
           IsStriped="true"
           IsBordered="true"
           OnQueryAsync="OnQueryAsync"
           ShowSearch="true"
           ShowToolbar="false"
           ShowAddButton="false"
           ShowEditButton="false"
           ShowDeleteButton="false"
           ShowExtendButtons="false"
           ShowSkeleton="true"
           IsMultipleSelect="@(_mode == "multi")"
           Height="650"
           SelectedRowsChanged="OnSelectedRowsChanged">
        <TableColumns>
            <TableColumn @bind-Field="@context.User.Id" Width="80" Align="Alignment.Center" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.User.WorkerNumber" Title="员工号" Width="100" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.User.Name" Width="120" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.User.Gid" Width="150" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.RoleNames" Title="当前角色" Readonly="true">
                <Template Context="value">
                    @if (string.IsNullOrEmpty(value.Value))
                    {
                        <span class="text-muted">无</span>
                    }
                    else
                    {
                        @foreach (var n in value.Value.Split(','))
                        {
                            <span class="badge bg-primary me-1">@n</span>
                        }
                    }
                </Template>
            </TableColumn>
            @if (_mode == "single")
            {
                <TableColumn @bind-Field="@context.PrimaryRoleId" Title="设置角色" Width="320" Readonly="true">
                    <Template Context="value">
                        <Select Items="_roleItems" TItem="SelectedItem" TItemValue="int?"
                                Value="value.Value"
                                ValueChanged="@(async (int? newVal) => await OnSingleRoleChangeAsync(value.Row.User.Id, newVal))"
                                ShowSearch="true" PlaceHolder="选择角色" Style="width: 280px;" />
                    </Template>
                </TableColumn>
            }
        </TableColumns>
    </Table>
</div>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private string _mode = "single";

    private List<SelectedItem> _roleItems = new();
    private HashSet<int> _selectedUserIds = new();
    private int? _batchRoleId;

    protected override async Task OnInitializedAsync()
    {
        var items = await RolesService.GetSelectItemsAsync();
        _roleItems = items.ToSelectedItems();
    }

    private async Task<QueryData<UserWithRolesViewModel>> OnQueryAsync(QueryPageOptions options)
    {
        var result = await UsersService.QueryAsync(options.ToPagedQuery());
        if (result.Items.Count == 0)
        {
            return new QueryData<UserWithRolesViewModel>
            {
                Items = new List<UserWithRolesViewModel>(),
                TotalCount = result.TotalCount,
                IsFiltered = result.IsFiltered,
                IsSorted = result.IsSorted,
                IsSearch = result.IsSearch
            };
        }

        // 批量取本页所有用户的角色 Id(消除 N+1)
        var userIds = result.Items.Select(u => u.Id).ToList();
        var roleIdsMap = await RolesService.GetRoleIdsByUserIdsAsync(userIds);

        var rows = result.Items.Select(u => new UserWithRolesViewModel
        {
            User = u,
            RoleNames = u.RoleNames ?? "",
            PrimaryRoleId = roleIdsMap.TryGetValue(u.Id, out var ids) && ids.Count > 0
                ? (int?)ids[0]
                : null
        }).ToList();

        return new QueryData<UserWithRolesViewModel>
        {
            Items = rows,
            TotalCount = result.TotalCount,
            IsFiltered = result.IsFiltered,
            IsSorted = result.IsSorted,
            IsSearch = result.IsSearch
        };
    }

    private void OnSelectedRowsChanged(IEnumerable<UserWithRolesViewModel> rows)
    {
        _selectedUserIds = rows.Select(r => r.User.Id).ToHashSet();
    }

    private async Task OnSingleRoleChangeAsync(int userId, int? newRoleId)
    {
        if (newRoleId == null) return;
        var (ok, error) = await RolesService.SetUserRolesAsync(userId, new[] { newRoleId.Value });
        if (!ok)
        {
            await ShowToast(error ?? "设置失败", ToastCategory.Error);
            return;
        }
        await ShowToast("已设置,该用户需重新登录生效", ToastCategory.Success);
    }

    private async Task ApplyBatchAsync()
    {
        if (_batchRoleId == null || _selectedUserIds.Count == 0) return;
        int success = 0, failed = 0;
        string? firstError = null;
        foreach (var uid in _selectedUserIds)
        {
            var currentIds = await RolesService.GetRoleIdsByUserIdAsync(uid);
            var merged = currentIds.Contains(_batchRoleId.Value) ? currentIds : currentIds.Concat(new[] { _batchRoleId.Value });
            var (ok, error) = await RolesService.SetUserRolesAsync(uid, merged);
            if (ok) success++;
            else
            {
                failed++;
                firstError ??= error;
            }
        }
        var msg = $"成功 {success} 人" + (failed > 0 ? $",失败 {failed} 人({firstError})" : "") + ",相关用户需重新登录";
        await ShowToast(msg, failed > 0 ? ToastCategory.Warning : ToastCategory.Success);
    }

    private async Task RemoveBatchAsync()
    {
        if (_batchRoleId == null || _selectedUserIds.Count == 0) return;
        int success = 0, failed = 0;
        string? firstError = null;
        foreach (var uid in _selectedUserIds)
        {
            var currentIds = await RolesService.GetRoleIdsByUserIdAsync(uid);
            var remaining = currentIds.Where(id => id != _batchRoleId.Value).ToList();
            var (ok, error) = await RolesService.SetUserRolesAsync(uid, remaining);
            if (ok) success++;
            else
            {
                failed++;
                firstError ??= error;
            }
        }
        var msg = $"从 {success} 人移除成功" + (failed > 0 ? $",{failed} 人失败({firstError})" : "");
        await ShowToast(msg, failed > 0 ? ToastCategory.Warning : ToastCategory.Success);
    }

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2500
        });
    }
}
