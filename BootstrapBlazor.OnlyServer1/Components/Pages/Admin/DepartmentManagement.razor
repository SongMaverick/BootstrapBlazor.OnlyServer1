@page "/department-management"
@attribute [TabItemOption(Text = "部门管理")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = RoleNames.Admin)]
@inject DepartmentsService DepartmentsService
@inject CurrentUserAccessor CurrentUser
@inject ToastService ToastService

<PageTitle>部门管理</PageTitle>

<div class="page-department">
    <h1>部门管理</h1>

    <Table TItem="Departments"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           RenderMode="TableRenderMode.Table"
           IsFixedHeader="true"
           IsStriped="true"
           IsBordered="true"
           OnQueryAsync="OnQueryAsync"
           ShowSearch="true"
           ShowToolbar="true"
           ShowExtendButtons="true"
           OnAddAsync="OnAddAsync"
           OnSaveAsync="OnSaveAsync"
           OnDeleteAsync="OnDeleteAsync"
           EditMode="EditMode.Popup"
           ShowSkeleton="true"
           IsMultipleSelect="true"
           Height="700"
           ShowAddButton="@CurrentUser.HasPermission(PermissionCodes.DepartmentCreate)"
           ShowDeleteButton="@CurrentUser.HasPermission(PermissionCodes.DepartmentDelete)">
        <TableColumns>
            <TableColumn @bind-Field="@context.Id" Width="80" Align="Alignment.Center" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.Name" Width="160" Sortable="true" />
            <TableColumn @bind-Field="@context.Code" Width="120" Sortable="true" />
            <TableColumn @bind-Field="@context.Description" Width="240" />
            <TableColumn @bind-Field="@context.IsActive" Width="100" Align="Alignment.Center" ComponentType="typeof(Switch)" />
            <TableColumn @bind-Field="@context.CreatedTime" Width="180" Align="Alignment.Center" Sortable="true" Readonly="true">
                <Template Context="value">
                    @value.Value.ToString("yyyy-MM-dd HH:mm:ss")
                </Template>
            </TableColumn>
        </TableColumns>
    </Table>
</div>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private async Task<QueryData<Departments>> OnQueryAsync(QueryPageOptions options)
    {
        var result = await DepartmentsService.QueryAsync(options.ToPagedQuery());
        return result.ToQueryData();
    }

    private Task<Departments> OnAddAsync()
        => Task.FromResult(new Departments
        {
            IsActive = true,
            CreatedTime = DateTime.Now
        });

    private async Task<bool> OnSaveAsync(Departments dept, ItemChangedType changedType)
    {
        var (ok, error) = await DepartmentsService.SaveAsync(dept);
        if (!ok)
        {
            await ShowToast(error ?? "保存失败", ToastCategory.Error);
            return false;
        }
        await ShowToast("保存成功", ToastCategory.Success);
        return true;
    }

    private async Task<bool> OnDeleteAsync(IEnumerable<Departments> depts)
    {
        var ok = await DepartmentsService.SoftDeleteAsync(depts);
        if (ok)
        {
            await ShowToast("已软删", ToastCategory.Success);
        }
        else
        {
            await ShowToast("删除失败", ToastCategory.Error);
        }
        return ok;
    }

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2000
        });
    }
}
