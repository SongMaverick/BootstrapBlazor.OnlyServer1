@page "/order-issues"
@attribute [TabItemOption(Text = "订单问题汇总")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Viewer)]
@using BootstrapBlazor.OnlyServer1.Models
@inject BootstrapBlazor.OnlyServer1.Services.OrderIssueService OrderIssueService
@inject Microsoft.Extensions.Logging.ILogger<OrderIssueList> Logger
@inject ToastService ToastService
@inject NavigationManager Nav
@inject BootstrapBlazor.OnlyServer1.Services.Identity.CurrentUserAccessor CurrentUser
@inject Microsoft.JSInterop.IJSRuntime JS

<PageTitle>订单问题汇总</PageTitle>

<div class="page-order-issues">
    <h1>订单问题汇总</h1>
    <p class="text-secondary">
        @if (_orderId > 0)
        {
            <text>该订单的所有问题列表。点击状态列下拉框可切换 open / close。</text>
        }
        else
        {
            <text>请从「订单管理」页面点击某行的「问题汇总」按钮进入。</text>
        }
    </p>

    @if (_orderId > 0)
    {
        @* (2026-08-14) 订单基础信息卡:订单号 / 容量 / 额定电压 / 是否电抗器 *@
        @if (_order != null)
        {
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <i class="fa-solid fa-circle-info me-2"></i>订单信息
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="text-secondary small">订单号</div>
                            <div class="fs-5 fw-bold">@_order.OrderNumber</div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-secondary small">容量</div>
                            <div class="fs-5 fw-bold">@_order.Power <span class="text-secondary fs-6">MVA</span></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-secondary small">额定电压</div>
                            <div class="fs-5 fw-bold">@_order.RatedVoltage <span class="text-secondary fs-6">kV</span></div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-secondary small">类型</div>
                            <div class="fs-5 fw-bold">
                                @if (_order.IsReactor)
                                {
                                    <span class="badge text-bg-warning"><i class="fa-solid fa-bolt me-1"></i>电抗器</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-primary"><i class="fa-solid fa-battery-full me-1"></i>变压器</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mb-3">
            <Button Color="Color.Secondary" Icon="fa-solid fa-arrow-left" OnClick="GoBack">返回订单管理</Button>
        </div>

        <Table TItem="OrderIssues"
               @ref="_table"
               IsPagination="true"
               PageItemsSource="@PageItemsSource"
               ShowToolbar="true"
               IsFixedHeader="true"
               IsStriped="true"
               IsBordered="true"
               OnQueryAsync="OnQueryAsync"
               IsMultipleSelect="true"
               ShowAddButton="false"
               ShowEditButton="false"
               ShowDeleteButton="false"
               ShowExtendButtons="false"
               SelectedRows="_selectedRows"
               SelectedRowsChanged="OnSelectedRowsChanged">
            <TableToolbarTemplate>
                @* (2026-08-14) 新建问题按钮:跟订单管理页「添加问题」Modal 同款,
                     弹窗写 Content → 保存新建问题(默认 status=open)。 *@
                <Button Color="Color.Primary"
                        Icon="fa-solid fa-plus"
                        Class="me-2"
                        IsDisabled="@(!CanAddIssue)"
                        OnClick="ShowAddIssueDialog">
                    新建问题
                </Button>

                @* (2026-08-14) 解决问题按钮:选中 1 行后点击 → 弹 Modal 填写解决方法。
                     close 校验要求 Resolution 非空,所以 close 之前必须先填这个。 *@
                <Button Color="Color.Success"
                        Icon="fa-solid fa-check"
                        IsDisabled="@(!CanSolveIssue)"
                        OnClick="ShowResolutionDialogFromSelection">
                    解决问题
                </Button>
            </TableToolbarTemplate>
            <TableColumns>
                <TableColumn @bind-Field="@context.Id" Text="Id" Width="80" Align="Alignment.Center" />

                @* 问题描述:长文本,保留换行 *@
                <TableColumn @bind-Field="@context.Content" Text="问题描述">
                    <Template Context="row">
                        <div style="white-space: pre-wrap; max-width: 700px; word-break: break-word;">@row.Row.Content</div>
                    </Template>
                </TableColumn>

                @* (2026-08-14) 解决方法:从工具栏「解决问题」按钮弹窗填入。
                     空内容显示 "—",非空时显示实际值。close 校验要求此字段非空。 *@
                <TableColumn @bind-Field="@context.Resolution" Text="解决方法">
                    <Template Context="row">
                        @if (string.IsNullOrWhiteSpace(row.Row.Resolution))
                        {
                            <span class="text-secondary">—</span>
                        }
                        else
                        {
                            <div style="white-space: pre-wrap; max-width: 700px; word-break: break-word;">@row.Row.Resolution</div>
                        }
                    </Template>
                </TableColumn>

                @* (2026-08-14) 状态下拉框:用原生 <select>,BootstrapBlazor Select 在 Template Context 里只渲染当前 Value 那项。
                     改值立即调 Service 持久化。
                     颜色区分:open → 红底(text-danger + bg-danger 透明背景),
                              close → 绿底(text-success + bg-success 透明背景)
                     业务规则:close 状态下拉框直接 disabled(只允许 open → close 一次)。
                              转换时弹 JS confirm 确认。
                              校验 Resolution 非空才能 close。 *@
                <TableColumn @bind-Field="@context.Status" Text="状态" Width="140" Align="Alignment.Center">
                    <Template Context="row">
                        <select class="@GetStatusSelectClass(row.Row.Status)"
                                style="min-width:100px;font-weight:600"
                                value="@row.Row.Status"
                                disabled="@(row.Row.Status == IssueStatus.Close || !CurrentUser.HasPermission(PermissionCodes.OrderIssueEditStatus))"
                                @onchange="@(async (ChangeEventArgs e) => await OnStatusChanged(row.Row, e.Value?.ToString() ?? ""))">
                            @foreach (var item in _statusItems)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </Template>
                </TableColumn>

                <TableColumn @bind-Field="@context.CreatedBy" Text="创建人" Width="120" Align="Alignment.Center" Readonly="true" />
                <TableColumn @bind-Field="@context.CreatedTime" Text="创建时间" Width="160" Align="Alignment.Center" Readonly="true" />
                <TableColumn @bind-Field="@context.UpdatedBy" Text="最近更新" Width="120" Align="Alignment.Center" Readonly="true" />
                <TableColumn @bind-Field="@context.UpdatedTime" Text="更新时间" Width="160" Align="Alignment.Center" Readonly="true" />

                @* (2026-08-14) 关闭人 / 关闭时间:放在更新时间后面。
                     只在 open → close 转换时写入一次;close 状态下显示实际值,open 状态下显示 "—"。
                     必须 @bind-Field 才能让 BootstrapBlazor TableColumn 推断 TItem/TType,否则编译报 CS0411。 *@
                <TableColumn @bind-Field="@context.ClosedBy" Text="关闭人" Width="120" Align="Alignment.Center" Readonly="true">
                    <Template Context="row">
                        @(row.Row.ClosedBy ?? "—")
                    </Template>
                </TableColumn>
                <TableColumn @bind-Field="@context.ClosedTime" Text="关闭时间" Width="160" Align="Alignment.Center" Readonly="true">
                    <Template Context="row">
                        @(row.Row.ClosedTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "—")
                    </Template>
                </TableColumn>
            </TableColumns>
        </Table>

        @* (2026-08-14) 填写解决方法 Modal:从工具栏「解决问题」按钮触发。
             展示选中问题的原 Content(只读)+ Resolution 编辑框。 *@
        <Modal @ref="_resolutionModal" IsBackdrop="true" ShowCloseButton="true" OnCloseAsync="CloseResolutionModal">
            <ModalDialog Title="@($"解决问题 — 问题 #{_currentIssueForResolution?.Id}")" Size="Size.Large">
                <BodyTemplate>
                    @if (_currentIssueForResolution != null)
                    {
                        <div class="mb-3">
                            <label class="form-label text-secondary">原问题</label>
                            <div style="white-space: pre-wrap; max-height: 180px; overflow-y: auto; background: #f8f9fa; padding: 8px 12px; border-radius: 4px; font-size: 0.95em;">
                                @_currentIssueForResolution.Content
                            </div>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label">解决方法 <span class="text-danger">*</span></label>
                        <textarea class="form-control" rows="6" maxlength="8000"
                                  @bind="_newResolution"
                                  placeholder="详细描述解决方法(必填,close 时会被校验)..."></textarea>
                        <small class="text-muted">当前 @(_newResolution?.Length ?? 0) / 8000 字符</small>
                    </div>
                </BodyTemplate>
                <FooterTemplate>
                    <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveResolution" IsDisabled="_savingResolution">
                        @(_savingResolution ? "保存中..." : "保存")
                    </Button>
                    <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseResolutionModal">取消</Button>
                </FooterTemplate>
            </ModalDialog>
        </Modal>

        @* (2026-08-14) 新建问题 Modal:跟 OrderManagement.razor 的「添加问题」Modal 同款。
             写 Content → 保存 → CreateAsync(_orderId, content),新建 Status=open 的问题。
             保存成功后 _table.QueryAsync() 刷新列表(直接调底层 Table 引用)。 *@
        <Modal @ref="_addIssueModal" IsBackdrop="true" ShowCloseButton="true" OnCloseAsync="CloseAddIssueDialog">
            <ModalDialog Title="@($"新建问题 — 订单 #{_order?.OrderNumber}")" Size="Size.Large">
                <BodyTemplate>
                    <div class="mb-3">
                        <label class="form-label">问题描述(支持长文本,最多 8000 字符)</label>
                        <textarea class="form-control"
                                  rows="8"
                                  maxlength="8000"
                                  @bind="_newIssueContent"
                                  placeholder="详细描述在此订单遇到的问题..."></textarea>
                        <small class="text-muted">当前 @(_newIssueContent?.Length ?? 0) / 8000 字符</small>
                    </div>
                </BodyTemplate>
                <FooterTemplate>
                    <Button Color="Color.Primary" Icon="fa-solid fa-save" OnClick="SaveNewIssue" IsDisabled="_savingIssue">
                        @(_savingIssue ? "保存中..." : "保存")
                    </Button>
                    <Button Color="Color.Secondary" Icon="fa-solid fa-xmark" OnClick="CloseAddIssueDialog">取消</Button>
                </FooterTemplate>
            </ModalDialog>
        </Modal>
    }
</div>

    // (2026-08-14) 新建问题 Modal 相关状态
@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    // (2026-08-14) 表格引用(新建/解决问题后刷新)、新建问题 Modal 相关字段
    private BootstrapBlazor.Components.Table<OrderIssues>? _table;
    private BootstrapBlazor.Components.Modal _addIssueModal = default!;
    private string _newIssueContent = "";
    private bool _savingIssue;

    // 静态选项:open / close
    private static readonly List<SelectedItem> _statusItems = new()
    {
        new SelectedItem(IssueStatus.Open, "open"),
        new SelectedItem(IssueStatus.Close, "close"),
    };

    // (2026-08-14) 状态下拉框颜色:open → 红,close → 绿。
    // 用 bg-* + bg-opacity-10 做淡背景,text-* 做深色文字,边框也对应色,
    // dropdown 关闭时一眼能区分,展开后系统原生 option 列表不带色(浏览器限制)。
    private static string GetStatusSelectClass(string status) => status switch
    {
        IssueStatus.Open  => "form-select form-select-sm text-danger bg-danger bg-opacity-10 border-danger",
        IssueStatus.Close => "form-select form-select-sm text-success bg-success bg-opacity-10 border-success",
        _ => "form-select form-select-sm",
    };

    // (2026-08-14) 行选中状态(解决问题按钮依赖),跟 Orders.razor 同款 Toasts 兜底模式
    private List<OrderIssues> _selectedRows = new();
    private bool _warnedThisSelection;
    private bool HasOneSelected => _selectedRows.Count == 1;

    private bool CanSolveIssue => HasOneSelected
        && CurrentUser.HasPermission(PermissionCodes.OrderIssueEditStatus);

    private bool CanAddIssue => _orderId > 0
        && CurrentUser.HasPermission(PermissionCodes.OrderIssueAdd);

    private void OnSelectedRowsChanged(IEnumerable<OrderIssues> rows)
    {
        _selectedRows = rows.ToList();
        if (_selectedRows.Count > 1)
        {
            if (!_warnedThisSelection)
            {
                _warnedThisSelection = true;
                _ = ToastService.Warning("本页操作仅支持单选:一次只能操作一个问题,请只勾选一行");
            }
        }
        else
        {
            _warnedThisSelection = false;
        }
    }

    // (2026-08-14) 解决方法 Modal 相关状态
    private BootstrapBlazor.Components.Modal _resolutionModal = default!;
    private OrderIssues? _currentIssueForResolution;
    private string _newResolution = "";
    private bool _savingResolution;

    // (2026-08-14) 新建问题 handlers
    private async Task ShowAddIssueDialog()
    {
        if (!CanAddIssue) return;
        _newIssueContent = "";
        await _addIssueModal.Show();
    }

    private async Task CloseAddIssueDialog()
    {
        await _addIssueModal.Close();
    }

    private async Task SaveNewIssue()
    {
        if (_savingIssue) return;
        if (string.IsNullOrWhiteSpace(_newIssueContent))
        {
            await ShowToast("问题描述不能为空", ToastCategory.Error);
            return;
        }

        _savingIssue = true;
        try
        {
            var (ok, error) = await OrderIssueService.CreateAsync(_orderId, _newIssueContent);
            if (!ok)
            {
                await ShowToast(error ?? "保存失败", ToastCategory.Error);
                return;
            }
            await ShowToast("问题已添加", ToastCategory.Success);
            await _addIssueModal.Close();
            _newIssueContent = "";
            if (_table != null) await _table.QueryAsync();
            StateHasChanged();
        }
        finally
        {
            _savingIssue = false;
        }
    }

    private void ShowResolutionDialogFromSelection()
    {
        if (!HasOneSelected) return;
        if (!CurrentUser.HasPermission(PermissionCodes.OrderIssueEditStatus))
        {
            _ = ToastService.Warning("无 OrderIssue.EditStatus 权限");
            return;
        }
        _currentIssueForResolution = _selectedRows[0];
        _newResolution = _currentIssueForResolution.Resolution ?? "";
        _ = _resolutionModal.Show();
    }

    private async Task CloseResolutionModal()
    {
        await _resolutionModal.Close();
    }

    private async Task SaveResolution()
    {
        if (_currentIssueForResolution == null) return;
        if (_savingResolution) return;
        if (string.IsNullOrWhiteSpace(_newResolution))
        {
            await ShowToast("解决方法不能为空", ToastCategory.Error);
            return;
        }

        _savingResolution = true;
        try
        {
            var (ok, error) = await OrderIssueService.SaveResolutionAsync(
                _currentIssueForResolution.Id, _newResolution);
            if (!ok)
            {
                await ShowToast(error ?? "保存失败", ToastCategory.Error);
                return;
            }

            // 本地同步
            var user = CurrentUser.GetDisplayName() ?? CurrentUser.GetUserName() ?? "";
            var now = DateTime.Now;
            _currentIssueForResolution.Resolution = _newResolution.Trim();
            _currentIssueForResolution.UpdatedBy = user;
            _currentIssueForResolution.UpdatedTime = now;

            await ShowToast("解决方法已保存", ToastCategory.Success);
            await _resolutionModal.Close();
            if (_table != null) await _table.QueryAsync();
            StateHasChanged();
        }
        finally
        {
            _savingResolution = false;
        }
    }

    [SupplyParameterFromQuery(Name = "orderId")]
    public int _orderIdFromQuery { get; set; }

    private int _orderId;
    private Models.Orders? _order;

    protected override async Task OnParametersSetAsync()
    {
        _orderId = _orderIdFromQuery;
        if (_orderId <= 0) return;

        _order = await OrderIssueService.GetOrderBasicInfoAsync(_orderId);
        if (_order == null)
        {
            await ShowToast($"订单 #{_orderId} 不存在或已被删除", ToastCategory.Warning);
            _orderId = 0;
        }
    }

    private async Task<QueryData<OrderIssues>> OnQueryAsync(QueryPageOptions options)
    {
        var result = await OrderIssueService.QueryByOrderIdAsync(_orderId, options.ToPagedQuery());
        return result.ToQueryData();
    }

    /// <summary>
    /// (2026-08-14) 行内关闭回调。业务规则:
    ///   - 只允许 open → close,close 之后任何状态变更全部拒绝(下拉框已 disabled 兜底,这里再做防御)
    ///   - 转换前弹 JS confirm,确认才持久化
    ///   - 成功后本地同步 ClosedBy / ClosedTime(跟服务端写入值一致),刷新 UI
    /// </summary>
    private async Task OnStatusChanged(OrderIssues issue, string newStatus)
    {
        if (string.IsNullOrEmpty(newStatus) || newStatus == issue.Status) return;

        // 已关闭:任何变更都拒绝
        if (issue.Status == IssueStatus.Close)
        {
            await ShowToast("已关闭的问题不能再修改状态", ToastCategory.Warning);
            return;
        }
        // 只接受 open → close
        if (newStatus != IssueStatus.Close)
        {
            await ShowToast("只能从 open 切换到 close", ToastCategory.Warning);
            return;
        }
        // (2026-08-14) close 之前必须先填写解决方法
        if (string.IsNullOrWhiteSpace(issue.Resolution))
        {
            await ShowToast("请先填写解决方法(工具栏「解决问题」按钮)", ToastCategory.Warning);
            return;
        }

        // 弹窗确认(浏览器原生 confirm,简单可靠)
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "确认关闭此问题?\n\n关闭后将无法再修改状态,关闭人 / 关闭时间会被记录。");
        if (!confirmed) return;

        var (ok, error) = await OrderIssueService.UpdateStatusAsync(issue.Id, newStatus);
        if (!ok)
        {
            await ShowToast(error ?? "关闭失败", ToastCategory.Error);
            return;
        }

        // 本地同步(值跟服务端一致,因为服务端就是按当前用户 + DateTime.Now 写的)
        var user = CurrentUser.GetDisplayName() ?? CurrentUser.GetUserName() ?? "";
        var now = DateTime.Now;
        issue.Status = IssueStatus.Close;
        issue.ClosedBy = user;
        issue.ClosedTime = now;
        issue.UpdatedBy = user;
        issue.UpdatedTime = now;

        await ShowToast("已关闭", ToastCategory.Success);
        if (_table != null) await _table.QueryAsync();
        StateHasChanged();
    }

    private void GoBack()
    {
        Nav.NavigateTo("/order-management");
    }

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2000
        });
    }
}