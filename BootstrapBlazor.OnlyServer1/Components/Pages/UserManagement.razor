@page "/user-management"
@attribute [TabItemOption(Text = "人员列表")]
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin + "," + BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Operator)]
@using Microsoft.Extensions.Options
@inject BootstrapBlazor.OnlyServer1.Services.UsersService UsersService
@inject BootstrapBlazor.OnlyServer1.Services.DepartmentsService DepartmentsService
@inject BootstrapBlazor.OnlyServer1.Services.RolesService RolesService
@inject BootstrapBlazor.OnlyServer1.Services.Identity.CurrentUserAccessor CurrentUser
@inject ToastService ToastService
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityOptions
@inject Microsoft.Extensions.Logging.ILogger<UserManagement> _logger

<PageTitle>人员列表</PageTitle>

<div class="page-user">
    <h1>人员列表</h1>

    <Table @ref="_tableRef"
           TItem="Models.Users"
           IsPagination="true"
           PageItemsSource="@PageItemsSource"
           RenderMode="TableRenderMode.Table"
           IsFixedHeader="true"
           IsStriped="true"
           IsBordered="true"
           OnQueryAsync="OnQueryAsync"
           ShowSearch="true"
           ShowToolbar="true"
           ShowExtendButtons="true"
           OnAddAsync="OnAddAsync"
           OnSaveAsync="OnSaveAsync"
           OnDeleteAsync="OnDeleteAsync"
           EditMode="EditMode.Popup"
           ShowSkeleton="true"
           IsMultipleSelect="true"
           Height="700"
           ShowAddButton="@CurrentUser.HasPermission(PermissionCodes.UserCreate)"
           ShowDeleteButton="@CurrentUser.HasPermission(PermissionCodes.UserDelete)"
           ShowEditButton="@CurrentUser.HasPermission(PermissionCodes.UserCreate)">
        <TableColumns>
            <TableColumn @bind-Field="@context.Id" Width="80" Align="Alignment.Center" Sortable="true" Readonly="true" />
            <TableColumn @bind-Field="@context.Name" Width="150" Sortable="true" />
            <TableColumn @bind-Field="@context.PhoneNumber" Width="140" Sortable="true">
                <Template Context="value">
                    @if (string.IsNullOrWhiteSpace(value.Value))
                    {
                        <span class="text-muted">未填写</span>
                    }
                    else
                    {
                        @value.Value
                    }
                </Template>
            </TableColumn>
            <TableColumn @bind-Field="@context.WorkerNumber" Width="120" Align="Alignment.Center" Sortable="true" />
            <TableColumn @bind-Field="@context.Gid" Width="150" Sortable="true" />
            @* 部门下拉:列表不显示(由 DepartmentName 展示),新增/编辑弹窗里提供 Select 选择。
               注:BootstrapBlazor 的 Visible=false 也会让新增/编辑时整列消失(默认 fall back),
               所以必须显式 IsVisibleWhenAdd/Edit=true 反向开启。 (2026-07-10 修"超管新建无法选部门"bug) *@
            <TableColumn @bind-Field="@context.DepartmentId"
                         Visible="false"
                         IsVisibleWhenAdd="true"
                         IsVisibleWhenEdit="true">
                <EditTemplate Context="field">
                    <Select Items="_departmentItems"
                            TItem="SelectedItem"
                            TItemValue="int?"
                            @bind-Value="field.DepartmentId"
                            ShowSearch="true"
                            PlaceHolder="请选择部门" />
                </EditTemplate>
            </TableColumn>
            <TableColumn @bind-Field="@context.DepartmentName"
                         Width="120"
                         Sortable="true"
                         Readonly="true"
                         Text="部门"
                         IsVisibleWhenAdd="false"
                         IsVisibleWhenEdit="false" />
            @* 角色列:仅列表展示,新增/编辑弹窗里不显示 —— 新增走自定义的"选择角色"弹窗
               (line 121-125 MultiSelect),编辑角色通过 /user-roles 页面管理。
               (2026-08-11 改:弹窗里不再让管理员设置初始密码,密码统一默认 123456)
               (2026-07-13 修"新建弹窗有个不能填的 RoleNames 文本框"困惑:Readonly 不会自动
               隐藏,必须显式 IsVisibleWhenAdd=false / IsVisibleWhenEdit=false,
               与 DepartmentName 列同样的处理) *@
            <TableColumn @bind-Field="@context.RoleNames"
                         Title="角色"
                         Readonly="true"
                         IsVisibleWhenAdd="false"
                         IsVisibleWhenEdit="false">
                <Template Context="value">
                    @if (string.IsNullOrEmpty(value.Value))
                    {
                        <span class="text-muted">无</span>
                    }
                    else
                    {
                        @foreach (var n in value.Value.Split(','))
                        {
                            <span class="badge bg-primary me-1">@n</span>
                        }
                    }
                </Template>
            </TableColumn>
            @* 密码列:不再直接显示 PasswordHash;新增时统一使用默认密码 123456,在弹窗里只选角色 *@
            <TableColumn @bind-Field="@context.PasswordHash"
                         Text="密码哈希"
                         Visible="false" />
            <TableColumn @bind-Field="@context.CreatedTime" Width="180" Align="Alignment.Center" Sortable="true" Readonly="true">
                <Template Context="value">
                    @value.Value.ToString("yyyy-MM-dd HH:mm:ss")
                </Template>
            </TableColumn>
        </TableColumns>
    </Table>

    @* 新增用户弹窗(仅在新增时显示,用于选角色;密码统一默认 123456) *@
    @if (_showAddPasswordModal)
    {
        <div class="modal fade show" style="display: block;" tabindex="-1" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">选择角色(初始密码默认 123456,用户登录后请立即修改)</h5>
                        <button type="button" class="btn-close" @onclick="CloseAddPasswordModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">员工号</label>
                            <input class="form-control" value="@_pendingAddUser?.WorkerNumber" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">姓名</label>
                            <input class="form-control" value="@_pendingAddUser?.Name" disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Gid</label>
                            <input class="form-control" value="@_pendingAddUser?.Gid" disabled />
                        </div>
                        @* 部门已在 Table 自带编辑弹窗的 EditTemplate 里选过(2026-07-10),这里不再重复 *@
                        <div class="mb-3">
                            <label class="form-label">角色(可多选)</label>
                            @* (2026-08-11) BootstrapBlazor 8.11.0 的 <MultiSelect> SelectedItemsChanged
                               在 Modal 里选中的角色没真正传到字段(N=0)—— 直接改用原生 checkbox
                               列表,100% 可控,选中状态肉眼可见。 *@
                            <div class="role-checkbox-list" style="max-height: 220px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 0.25rem; padding: 0.5rem;">
                                @if (_roleItems == null || _roleItems.Count == 0)
                                {
                                    <div class="text-muted small">暂无可选角色</div>
                                }
                                else
                                {
                                    @foreach (var role in _roleItems)
                                    {
                                        var isChecked = _pendingAddSelectedRoles.Any(r => r.Value == role.Value);
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="pending-role-@role.Value"
                                                   checked="@isChecked"
                                                   @onchange="@(e => TogglePendingRole(role, (bool)e.Value))" />
                                            <label class="form-check-label" for="pending-role-@role.Value">
                                                @role.Text
                                            </label>
                                        </div>
                                    }
                                }
                            </div>
                            <small class="form-text text-muted">
                                已选 <strong>@_pendingAddSelectedRoles.Count</strong> 个角色。
                                不选则该用户无任何角色,登录后访问任何模块都会被拒(2026-07-10 新增)
                            </small>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseAddPasswordModal">取消</button>
                        <button class="btn btn-primary" @onclick="ConfirmAddUserAsync" disabled="@_addSaving">
                            @if (_addSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            确认创建
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
</div>

@code {
    private static IEnumerable<int> PageItemsSource => new int[] { 10, 20, 40 };

    private List<SelectedItem> _departmentItems = new();
    private List<SelectedItem> _roleItems = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var depts = await DepartmentsService.GetAllActiveAsync();
            _departmentItems = depts
                .Select(d => new SelectedItem(d.Id.ToString(), d.Name))
                .ToList();

            var roles = await RolesService.GetSelectItemsAsync();
            _roleItems = roles.ToSelectedItems();
        }
        catch (Exception ex)
        {
            // (2026-07-10) 不再静默吞错 —— 排查"用户列表没有部门可选"bug 时第一时间看到 SQL 异常
            _logger.LogError(ex, "UserManagement.OnInitializedAsync: 加载部门/角色下拉失败");
            _departmentItems = new();
            _roleItems = new();
        }
    }

    private async Task<QueryData<Models.Users>> OnQueryAsync(QueryPageOptions options)
    {
        // (2026-08-07) Operator / Viewer 看不到 ADMIN 角色用户(超管隐于日常运营视角);
        // Admin 自己仍可见全部,方便多超管场景下的管理与交接。
        var hideAdmin = !CurrentUser.IsInAnyRole(BootstrapBlazor.OnlyServer1.Models.Identity.RoleNames.Admin);
        var result = await UsersService.QueryAsync(options.ToPagedQuery(), hideAdmin);
        return result.ToQueryData();
    }

    private Task<Models.Users> OnAddAsync()
        => UsersService.NewUserAsync();

    private async Task<bool> OnSaveAsync(Models.Users user, ItemChangedType changedType)
    {
        if (changedType == ItemChangedType.Add)
        {
            // 新增:弹出"选择角色"弹窗。密码统一默认 123456,不需要用户输入。
            _pendingAddUser = user;
            _pendingAddSelectedRoles = new();   // 复位,避免上次残留 (2026-07-10)
            _showAddPasswordModal = true;

            // (2026-08-11) 强制先渲染模态框,再 return true 让 BootstrapBlazor 关闭内置弹窗。
            // 不然 return true 触发表格关闭"新建窗口"的渲染,会跟我们的"选择角色"模态框
            // 渲染打架,模态框被挤掉 —— 用户得切走再切回才能看到。
            await InvokeAsync(StateHasChanged);

            // (2026-08-11) 返回 true 而非 false:BootstrapBlazor Table 在 OnSaveAsync
            // 返回 false 时会强制弹"保存数据失败" Toast,误导用户以为操作坏了。
            // 真正的 Save 在 ConfirmAddUserAsync 里。
            await ShowToast("请在弹窗里选择角色,初始密码统一为 123456", ToastCategory.Information);
            return true;
        }
        else
        {
            var (ok, error) = await UsersService.SaveAsync(user, null, changedType.ToDomain());
            if (!ok && !string.IsNullOrEmpty(error))
            {
                await ToastService.Show(new ToastOption
                {
                    Category = ToastCategory.Error,
                    Content = error
                });
            }
            return ok;
        }
    }

    private async Task<bool> OnDeleteAsync(IEnumerable<Models.Users> users)
    {
        var (ok, error) = await UsersService.SoftDeleteAsync(users);
        if (!ok && !string.IsNullOrEmpty(error))
        {
            await ShowToast(error, ToastCategory.Error);
        }
        return ok;
    }

    // ===== 新增用户弹窗 =====
    private bool _showAddPasswordModal;
    private Models.Users? _pendingAddUser;
    // (2026-08-11) Table 引用 —— 角色绑定完成后手动触发 QueryAsync 刷新,
    //   让 RoleNames(LEFT JOIN 查出来的视图列)显示出来
    private BootstrapBlazor.Components.Table<Models.Users>? _tableRef;
    // (2026-08-11) 移除 _pendingPassword / _pendingPasswordConfirm —— 密码统一默认 123456,
    //   与 DbMigrator 迁移 Users.sql 时一致,用户登录后自行修改。
    private List<SelectedItem> _pendingAddSelectedRoles = new();   // MultiSelect 绑定的是 SelectedItem 集合,提交时再转 int
    private bool _addSaving;

    // 项目惯例的默认密码(与 DbMigrator 迁移 Users.sql 时一致),首次登录后强制修改。
    private const string DefaultPassword = "123456";

    private void CloseAddPasswordModal()
    {
        _showAddPasswordModal = false;
        _pendingAddUser = null;
        _pendingAddSelectedRoles = new();
    }

    /// <summary>
    /// (2026-08-11) BootstrapBlazor 8.11.0 MultiSelect 在 Modal 里有 binding quirk —— 改成原生 checkbox 列表,
    /// 这里直接维护 _pendingAddSelectedRoles 集合。
    /// </summary>
    private void TogglePendingRole(SelectedItem role, bool isChecked)
    {
        if (isChecked)
        {
            if (!_pendingAddSelectedRoles.Any(r => r.Value == role.Value))
            {
                _pendingAddSelectedRoles.Add(role);
            }
        }
        else
        {
            _pendingAddSelectedRoles.RemoveAll(r => r.Value == role.Value);
        }
    }

    private async Task ConfirmAddUserAsync()
    {
        if (_pendingAddUser == null) return;

        _addSaving = true;
        try
        {
            // 1) 先建用户,密码用项目默认 123456
            var (ok, error) = await UsersService.SaveAsync(_pendingAddUser, DefaultPassword, ItemChangedType.Add.ToDomain());
            if (!ok)
            {
                await ShowToast(error ?? "创建失败", ToastCategory.Error);
                return;
            }

            // 2) 把 Modal 里的 SelectedItem 集合转换成 roleId 列表 (SelectedItem.Value 是 role 的 id 字符串)
            var roleIds = (_pendingAddSelectedRoles ?? new List<SelectedItem>())
                .Select(si => int.TryParse(si.Value, out var v) ? v : (int?)null)
                .Where(v => v.HasValue)
                .Select(v => v!.Value)
                .Distinct()
                .ToList();
            var assignedRoles = roleIds.Count;

            _logger.LogInformation(
                "UserManagement.ConfirmAddUserAsync: 准备为新用户 userId={Uid} 分配 {N} 个角色",
                _pendingAddUser.Id, assignedRoles);

            // 3) 分配角色(可选)。失败则回滚刚创建的用户 —— 不留孤儿账户。
            if (assignedRoles > 0)
            {
                var (roleOk, roleErr) = await RolesService.SetUserRolesAsync(_pendingAddUser.Id, roleIds);
                if (!roleOk)
                {
                    _logger.LogError(
                        "UserManagement.ConfirmAddUserAsync: 角色分配失败,正在回滚刚创建的用户 userId={Uid} roleErr={Err}",
                        _pendingAddUser.Id, roleErr);
                    try
                    {
                        await UsersService.SoftDeleteAsync(new[] { _pendingAddUser });
                    }
                    catch (Exception rollbackEx)
                    {
                        _logger.LogError(rollbackEx,
                            "UserManagement.ConfirmAddUserAsync: 回滚 SoftDelete 也失败 userId={Uid}",
                            _pendingAddUser.Id);
                    }
                    await ShowToast($"角色分配失败,已回滚用户: {roleErr}", ToastCategory.Error);
                    return;
                }
            }

            await ShowToast(assignedRoles > 0
                ? $"用户创建成功(默认密码 123456),已分配 {assignedRoles} 个角色"
                : "用户创建成功(默认密码 123456,未分配角色)",
                ToastCategory.Success);
            CloseAddPasswordModal();

            // (2026-08-11) 手动刷新 Table 一次 —— BootstrapBlazor Table 在 OnSaveAsync
            // 返回 true 时会自动调一次 OnQueryAsync,但那一次在我们的 ConfirmAddUserAsync
            // 完成前就触发了,那时用户还没绑角色,RoleNames 是空的。
            // 我们 Save + SetUserRoles 都做完后再补一次刷新,RoleNames 就对了。
            if (_tableRef != null)
            {
                await _tableRef.QueryAsync();
            }
        }
        finally
        {
            _addSaving = false;
        }
    }

    private async Task ShowToast(string content, ToastCategory category)
    {
        await ToastService.Show(new ToastOption
        {
            Category = category,
            Content = content,
            Delay = 2000
        });
    }
}