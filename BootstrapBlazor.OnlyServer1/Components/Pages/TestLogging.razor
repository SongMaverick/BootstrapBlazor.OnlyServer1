@page "/test-logging"
@attribute [TabItemOption(Text = "日志测试")]

<PageTitle>日志测试</PageTitle>

<div class="container mt-4">
    <h3>NLog 日志写入测试</h3>
    <p class="text-muted">
        点击按钮触发不同级别的日志,验证它们是否进入了 SqlServer 的 <code>dbo.Logs</code> 表。
    </p>

    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">触发测试日志</h5>
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-info" @onclick="LogTrace">Trace 日志</button>
                <button class="btn btn-secondary" @onclick="LogDebug">Debug 日志</button>
                <button class="btn btn-primary" @onclick="LogInfo">Info 日志</button>
                <button class="btn btn-warning" @onclick="LogWarn">Warn 日志</button>
                <button class="btn btn-danger" @onclick="LogError">Error 日志</button>
                <button class="btn btn-dark" @onclick="LogFatal">Fatal 日志</button>
                <button class="btn btn-outline-danger" @onclick="LogWithException">带 Exception</button>
            </div>
        </div>
    </div>

    @if (_lastBatch != null)
    {
        <div class="alert alert-info">
            <strong>刚触发:</strong> @_lastBatch
        </div>
    }

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">怎么验证</h5>
            <ol class="mb-0">
                <li>点击上面的按钮(可以多按几次,凑够 50 条让 AsyncWrapper 强制 flush,或者等 2 秒)</li>
                <li>到 SqlServer SSMS 里跑这个 SQL:
                    <pre class="bg-light p-2 mt-2 mb-0"><code>SELECT TOP 20 LogDate, LogLevel, LogSource, LogMessage
FROM dbo.Logs
ORDER BY LogDate DESC;</code></pre>
                </li>
                <li>如果看到刚才触发的日志 → <strong class="text-success">写入成功</strong></li>
                <li>如果表里没数据 → 看网络盘 <code>\\jinwad5a\Applications\MXB\DrawingNumber\nlog\fallback-*.log</code>(业务兜底) + <code>\\jinwad5a\Applications\MXB\DrawingNumber\nlog\nlog-internal-*.log</code>(NLog 诊断)</li>
            </ol>
        </div>
    </div>

    <div class="alert alert-warning mt-3">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        <strong>前置条件:</strong> SqlServer <code>stclmd</code> 库里必须已经存在 <code>dbo.Logs</code> 表(7 列:Id/LogDate/LogLevel/LogSource/LogMessage/Exception/Properties)。
        如果还没建,先把表建了再来点按钮。
    </div>
</div>

@code {
    [Inject] private ILogger<TestLogging> Logger { get; set; } = default!;

    private string? _lastBatch;

    private void LogTrace()
    {
        Logger.LogTrace("这是一条 Trace 日志 {Timestamp}", DateTime.Now);
        _lastBatch = "Trace @ " + DateTime.Now.ToString("HH:mm:ss.fff");
    }

    private void LogDebug()
    {
        Logger.LogDebug("这是一条 Debug 日志 {Timestamp}", DateTime.Now);
        _lastBatch = "Debug @ " + DateTime.Now.ToString("HH:mm:ss.fff");
    }

    private void LogInfo()
    {
        Logger.LogInformation("这是一条 Info 日志 {Timestamp}", DateTime.Now);
        _lastBatch = "Info @ " + DateTime.Now.ToString("HH:mm:ss.fff");
    }

    private void LogWarn()
    {
        Logger.LogWarning("这是一条 Warn 日志 {Timestamp}", DateTime.Now);
        _lastBatch = "Warn @ " + DateTime.Now.ToString("HH:mm:ss.fff");
    }

    private void LogError()
    {
        Logger.LogError("这是一条 Error 日志 {Timestamp}", DateTime.Now);
        _lastBatch = "Error @ " + DateTime.Now.ToString("HH:mm:ss.fff");
    }

    private void LogFatal()
    {
        Logger.LogCritical("这是一条 Fatal/Critical 日志 {Timestamp}", DateTime.Now);
        _lastBatch = "Fatal @ " + DateTime.Now.ToString("HH:mm:ss.fff");
    }

    private void LogWithException()
    {
        try
        {
            throw new InvalidOperationException("这是一个测试异常,用来验证 NLog 能正确捕获堆栈");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "捕获到一个异常 {UserId}", "test-user-001");
        }
        _lastBatch = "WithException @ " + DateTime.Now.ToString("HH:mm:ss.fff");
    }
}