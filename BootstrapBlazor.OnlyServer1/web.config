<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\BootstrapBlazor.OnlyServer1.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <!--
          ASPNETCORE_ENVIRONMENT 与 ConnectionStrings 等敏感配置全部通过
          IIS AppPool 环境变量注入(参见 scripts/create-iis-site.ps1);
          本节点保持空,避免密码 / 连接串进 git。
        -->
        <environmentVariables>
        </environmentVariables>
      </aspNetCore>

      <!-- (2026-08-03 IIS Express 适配)WebSocket 不在这里配置:
           - IIS 完整版:WebSocket Protocol 角色服务装好后,默认启用,无需 web.config 配
           - IIS Express:applicationhost.config 把 <webSocket> 节 overrideModeDefault="Deny" 锁定,
             在 web.config 里写会触发 0x80070021。WebSocketModule 全局模块已默认注册(第 235/875 行)
             + <webSocket /> 默认节点(第 829 行),Blazor Server SignalR 在 IIS Express 下能跑。
           - 生产 IIS 部署:若需要显式关闭/重设,改 applicationHost.config 或 server 级 web.config,
             不放在应用 web.config 里。 -->

      <!-- (2026-08-03 IIS 迁移后)HTTP→HTTPS 重定向走 IIS 层
           原因:ANCM in-process hosting 下,HttpRequest.IsHttps 永远 = true
           (IIS 已做 TLS 终结),Program.cs 的 UseHttpsRedirection 不会触发。
           用 IIS URL Rewrite 在请求到达应用前 301 跳转,HTTPS binding 存在时
           行为正确,缺失 HTTPS binding 时 IIS 会回 500.53(可识别为配置问题)。 -->
      <rewrite>
        <rules>
          <rule name="HTTP to HTTPS redirect" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
          </rule>
        </rules>
      </rewrite>

      <!-- 安全响应头(IIS 路径直接生效)
           2026-07-07 Review #M8 增补:
             - Content-Security-Policy:防 XSS 数据外泄
               Blazor 在 _framework 下动态加载 JS + SignalR 走 ws/wss,
               因此需要 'unsafe-inline' / 'unsafe-eval' 和 connect-src ws/wss
           ⚠ Strict-Transport-Security 已迁出到 web.Release.config:
             - 原因:写死 max-age=1 年 + preload,浏览器一旦收到就会把策略缓存进 HSTS DB,
               即使后续切回 HTTP dev(localhost:8373)也会被强制升级 HTTPS,
               表现"开发模式打不开 / IIS Express 起不来"
             - 新做法:Release 构建时由 MSBuild Web 转换合并 HSTS 头,Debug 构建不输出
           (2026-08-03 IIS 迁移后)以下 4 个头 (CSP/X-Frame-Options/X-Content-Type-Options/Referrer-Policy)
           与 Program.cs 的 SecurityHeaders 中间件同值输出(defense-in-depth):
             - dev/dotnet run:中间件层是唯一来源(Kestrel 不读 web.config)
             - IIS 生产:这里是直接生效路径,中间件层冗余兜底
           改任意一处必须同步另一处。-->
      <httpProtocol>
        <customHeaders>
          <!-- 移除 IIS 默认加的 X-Powered-By 头(信息泄漏:ASP.NET 标识)
               注意:必须用 <remove> 不能用 <add value="">,后者会跟 IIS 默认头冲突报 500.19 -->
          <remove name="X-Powered-By" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="same-origin" />
          <add name="Content-Security-Policy"
               value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'self';" />
        </customHeaders>
      </httpProtocol>

      <!-- 静态资源缓存:Blazor 静态资源已自带 hash 后缀,缓存一年 OK -->
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>

    </system.webServer>
  </location>
</configuration>
<!--ProjectGuid: BA3DF8F6-1AF6-4842-8A7E-BE7D8991EDAC-->
