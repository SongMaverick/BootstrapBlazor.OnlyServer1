<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\BootstrapBlazor.OnlyServer1.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <!--
          ASPNETCORE_ENVIRONMENT 通过 IIS AppPool 环境变量配置(部署侧),不写死在这里。
          例:IIS → Application Pool → Advanced Settings → Environment Variables → ASPNETCORE_ENVIRONMENT=Production
        -->
        <environmentVariables>
        </environmentVariables>
      </aspNetCore>

      <!-- Blazor Server SignalR 长连接必须启用 WebSocket;WebSocket Protocol 模块需在 IIS 角色服务里安装 -->
      <webSocket enabled="true" />

      <!-- 安全响应头(内网系统基线)
           2026-07-07 Review #M8 增补:
             - Content-Security-Policy:防 XSS 数据外泄
               Blazor 在 _framework 下动态加载 JS + SignalR 走 ws/wss,
               因此需要 'unsafe-inline' / 'unsafe-eval' 和 connect-src ws/wss
             - Strict-Transport-Security:2026-07-09 P0-3 部署 HTTPS 后启用;
               max-age=1 年 + includeSubDomains + preload(可提交 hstspreload.org)
      -->
      <httpProtocol>
        <customHeaders>
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="same-origin" />
          <add name="X-Powered-By" value="" />
          <add name="Content-Security-Policy"
               value="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors 'self';" />
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
        </customHeaders>
      </httpProtocol>

      <!-- 静态资源缓存:Blazor 静态资源已自带 hash 后缀,缓存一年 OK -->
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>

    </system.webServer>
  </location>
</configuration>
