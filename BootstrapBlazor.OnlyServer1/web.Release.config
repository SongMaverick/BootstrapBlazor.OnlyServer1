<?xml version="1.0"?>
<!--
  web.Release.config — MSBuild Web.config 转换,只在 Release 构建时合并到 web.config

  为什么 HSTS 头要放到这里(而不是直接写在 web.config):
    1. web.config 是全环境共享的(Debug/Release/IIS Express dev 都用同一份)
    2. HSTS 一旦写出去,浏览器会缓存 max-age=31536000(1 年)
    3. Dev 场景下(IIS Express https://localhost:44320 / Kestrel http://localhost:8373)被缓存后,
       切回 HTTP 访问会被浏览器强制升级 HTTPS → 开发模式打不开
    4. Release 构建时,dotnet publish 会自动用本文件按 xdt 规则合并出最终的 web.config,
       此时 HSTS 头才被输出到生产二进制 → 浏览器只在生产域名上缓存,不会污染 dev

  配套注意:
    - 部署到 IIS 后,如要让 hstspreload.org 收录,需把域名提交到 https://hstspreload.org/
    - 本文件随项目提交,Release 构建时由 Microsoft.NET.Sdk.Web 自动应用,无需额外配置
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <!--
            (2026-07-09 P0-3 HTTPS 部署)HSTS 头
              - max-age=31536000(1 年)
              - includeSubDomains:子域名也强制 HTTPS
              - preload:可提交 hstspreload.org(浏览器内置 HSTS 列表)
            Release-only:Debug 构建不输出,避免 dev 浏览器缓存污染
          -->
          <add name="Strict-Transport-Security"
               value="max-age=31536000; includeSubDomains; preload"
               xdt:Transform="Insert" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>