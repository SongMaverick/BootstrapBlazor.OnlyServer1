{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/BootstrapBlazor.OnlyServer1/BootstrapBlazor.OnlyServer1.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "publish (FolderProfile)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/BootstrapBlazor.OnlyServer1/BootstrapBlazor.OnlyServer1.csproj",
        "/p:PublishProfile=FolderProfile"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "publish (clean + IIS output)",
      "command": "dotnet",
      "type": "process",
      "args": [
        "publish",
        "${workspaceFolder}/BootstrapBlazor.OnlyServer1/BootstrapBlazor.OnlyServer1.csproj",
        "-c", "Release",
        "-f", "net8.0",
        "-p:Platform=x64",
        "-p:PublishReadyToRun=true",
        "-o", "${workspaceFolder}/publish"
      ],
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}